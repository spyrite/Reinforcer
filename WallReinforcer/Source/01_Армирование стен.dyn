    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nimport math\r\nimport System\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nrebars = IN[0][0]\r\nWPars = IN[0][1]\r\nWRebs = IN[0][2]\r\n\r\ndef ByElevation(lvl):\r\n\treturn round(lvl.Elevation*304.8)\r\n\r\nlevels = []\r\nfor lvl in sorted(FilteredElementCollector(doc).OfClass(Level).ToElements(), key=ByElevation):\r\n\tif len(lvl.Name.split('.')) == 1:\r\n\t\tlevels.append([])\r\n\t\tlevels[-1].append(lvl)\r\n\telse:\r\n\t\tlevels[-1].append(lvl)\r\n\r\noptForSlabs = Options()\r\n\r\ndef VecABS(vec):\r\n\tx = abs(vec.X)\r\n\ty = abs(vec.Y)\r\n\tz = abs(vec.Z)\r\n\treturn XYZ(x,y,z)\r\n\t\r\ndef GetVecToken(vec):\r\n\treturn vec.X + vec.Y + vec.Z\r\n\t\r\ndef GetSlabThickness(lvl, catchPoint):\r\n\tfilter = ElementLevelFilter(lvl.Id)\r\n\tslabs = FilteredElementCollector(doc).OfClass(Floor).WherePasses(filter).ToElements()\r\n\tt = -15/304.8\r\n\tfor slab in slabs:\r\n\t\tmainFace = [face for face in list(slab.Geometry[optForSlabs])[0].Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(XYZ.BasisZ)][0]\r\n\t\tif mainFace.Project(catchPoint) is not None:\r\n\t\t\tt = slab.Parameter[BuiltInParameter.FLOOR_ATTR_THICKNESS_PARAM].AsDouble()\r\n\t\t\tbreak\r\n\treturn t\r\n\r\ndef CreateCutline(wp, lvlBot, botSlabT):\r\n\tsp = wp.CenterLine.GetEndPoint(0)\r\n\tep = wp.CenterLine.GetEndPoint(1)\r\n\tp0 = XYZ(sp.X, sp.Y, lvlBot.Elevation + botSlabT)\r\n\tp1 = XYZ(ep.X, ep.Y, lvlBot.Elevation + botSlabT)\r\n\treturn Line.CreateBound(p0, p1)\r\n\t\r\ndef GetJoinedWallThickness(wp, point):\r\n\tcatchPoint = point + XYZ.BasisZ * wp.H/2\r\n\tfilter = BoundingBoxContainsPointFilter(catchPoint)\r\n\twalls = FilteredElementCollector(doc).OfClass(Wall).WherePasses(filter).Excluding(List[ElementId]([ElementId(wp.Id)])).ToElements()\r\n\tif walls:\r\n\t\tcutline = Line.CreateBound(catchPoint, catchPoint + XYZ.BasisZ * 10/304.8)\r\n\t\twall = walls[0]\r\n\t\tsolid = list(wall.Geometry[Options()])[0]\t\t\r\n\t\tif list(solid.IntersectWithCurve(cutline, None)):\r\n\t\t\treturn walls[0].Width\r\n\t\telse:\r\n\t\t\treturn float(0)\r\n\telse:\r\n\t\treturn float(0)\t\r\n\r\ndef CreateHRebars(wp, wr, lvlBot, lvlTop):\r\n\r\n\tARType = FilteredElementCollector(doc).OfClass(AreaReinforcementType).ToElementIds()[0]\r\n\t\r\n\trebarType = [rt for rt in FilteredElementCollector(doc).OfClass(RebarBarType).ToElements() if rt.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString().find('A500') != -1 and round(rt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()*304.8) == round(wr.DX*304.8) and rt.get_Parameter(System.Guid('844a01e2-19fc-4dc5-baa0-a4bda30ef1f6')).AsInteger() == 1][0]\r\n\r\n\tbotSlabT = GetSlabThickness(lvlBot, wp.GetMidPointOfCenterLine())\r\n\toffsetMin =  IN[1]/304.8\r\n\tN = int(math.floor((lvlTop.Elevation-(lvlBot.Elevation+botSlabT)-2*offsetMin)/wr.StepX))+1\r\n\toffsetStart = (lvlTop.Elevation - (lvlBot.Elevation+botSlabT) - wr.StepX*(N-1))/2\r\n\t\r\n\tif VecABS(wp.Dir).IsAlmostEqualTo(XYZ.BasisY) and wp.JoinedWallsAtStart and wp.JoinedWallsAtEnd:\r\n\t\tadditOffset = wr.DX\r\n\telse:\r\n\t\tadditOffset = 0\r\n\t\r\n\tcutline = CreateCutline(wp, lvlBot, botSlabT).CreateOffset(offsetStart, XYZ.BasisZ.CrossProduct(wp.Dir))\r\n\t\r\n\tfor n in range(N):\r\n\t\tspotlines = list(wp.Solid.IntersectWithCurve(cutline, None))\r\n\t\tif spotlines:\r\n\t\t\tmainFace = [face for face in wp.Solid.Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(wp.Orient)][0]\r\n\t\t\t\r\n\t\t\tbaseOffset = -float(spotlines[0].Origin.Z - wp.GetBaseZ() - wr.DX/2 - additOffset) #* GetVecToken(wp.Orient) \r\n\t\t\ttopOffset = -(wp.H - abs(baseOffset) - math.floor((wp.H - (abs(baseOffset) + wr.DX/2)) / wr.StepX) * wr.StepX - wr.DX) #* GetVecToken(wp.Orient) \r\n\t\t\t\r\n\t\t\tARCurveLoops = []\r\n\t\t\t\r\n\t\t\twallCurveLoops = mainFace.GetEdgesAsCurveLoops()\r\n\t\t\toffsets = []\r\n\t\t\t\r\n\t\t\tfor curves in wallCurveLoops:\r\n\t\t\t\toffsets.append([])\r\n\t\t\t\tfor cur in curves:\r\n\t\t\t\t\tif cur.Direction.Normalize().IsAlmostEqualTo(-wp.Dir):\r\n\t\t\t\t\t\toffsets[-1].append(baseOffset)\r\n\t\t\t\t\telif cur.Direction.Normalize().IsAlmostEqualTo(wp.Dir):\t\r\n\t\t\t\t\t\toffsets[-1].append(topOffset)\r\n\t\t\t\t\telif cur.Direction.Normalize().IsAlmostEqualTo(XYZ.BasisZ) and wp.JoinAllowedAtStart and abs(wp.Dir.DotProduct(cur.Origin) - wp.Dir.DotProduct(wp.SP)) <= wp.T/2:\t\r\n\t\t\t\t\t\toffsets[-1].append(GetJoinedWallThickness(wp, wp.SP)-20/304.8)\r\n\t\t\t\t\telif cur.Direction.Normalize().IsAlmostEqualTo(-XYZ.BasisZ) and wp.JoinAllowedAtEnd and abs(wp.Dir.DotProduct(wp.EP) - wp.Dir.DotProduct(cur.Origin)) <= wp.T/2:\t\r\n\t\t\t\t\t\toffsets[-1].append(GetJoinedWallThickness(wp, wp.EP)-20/304.8)\r\n\t\t\t\t\telse:\r\n\t\t\t\t\t\toffsets[-1].append(float(0))\r\n\t\t\t\t\r\n\t\t\tfor i, cl in enumerate(wallCurveLoops):\r\n\t\t\t\tARCurveLoops.append(CurveLoop.CreateViaOffset(cl, offsets[i], wp.Orient))\r\n\t\t\tbreak\t\t\t\r\n\t\tcutline = cutline.CreateOffset(wr.StepX, XYZ.BasisZ.CrossProduct(wp.Dir))\r\n\t\r\n\tARs = []\r\n\tfor cl in ARCurveLoops:\r\n\t\tARext = AreaReinforcement.Create(doc, doc.GetElement(ElementId(wp.Id)), list(cl), wp.Dir, ARType, rebarType.Id, ElementId.InvalidElementId)\r\n\t\tARext.Parameter[BuiltInParameter.REBAR_SYSTEM_ACTIVE_TOP_DIR_1_GENERIC].Set(True)\r\n\t\tARext.Parameter[BuiltInParameter.REBAR_SYSTEM_ACTIVE_TOP_DIR_2_GENERIC].Set(False)\r\n\t\tARext.Parameter[BuiltInParameter.REBAR_SYSTEM_ACTIVE_BOTTOM_DIR_1_GENERIC].Set(False)\r\n\t\tARext.Parameter[BuiltInParameter.REBAR_SYSTEM_ACTIVE_BOTTOM_DIR_2_GENERIC].Set(False)\r\n\t\tARext.Parameter[BuiltInParameter.REBAR_SYSTEM_SPACING_TOP_DIR_1_GENERIC].Set(wr.StepX)\r\n\t\tARext.Parameter[BuiltInParameter.NUMBER_PARTITION_PARAM].Set('01_Расположение_Горизонтальная_Наружняя')\r\n\t\tdoc.Regenerate()\r\n\t\t[rebar.SetSolidInView(doc.ActiveView, True) for rebar in [doc.GetElement(id) for id in ARext.GetRebarInSystemIds()]]\r\n\t\r\n\t\tARint = AreaReinforcement.Create(doc, doc.GetElement(ElementId(wp.Id)), list(cl), wp.Dir, ARType, rebarType.Id, ElementId.InvalidElementId)\r\n\t\tARint.Parameter[BuiltInParameter.REBAR_SYSTEM_ACTIVE_TOP_DIR_1_GENERIC].Set(False)\r\n\t\tARint.Parameter[BuiltInParameter.REBAR_SYSTEM_ACTIVE_TOP_DIR_2_GENERIC].Set(False)\r\n\t\tARint.Parameter[BuiltInParameter.REBAR_SYSTEM_ACTIVE_BOTTOM_DIR_1_GENERIC].Set(True)\r\n\t\tARint.Parameter[BuiltInParameter.REBAR_SYSTEM_ACTIVE_BOTTOM_DIR_2_GENERIC].Set(False)\r\n\t\tARint.Parameter[BuiltInParameter.REBAR_SYSTEM_SPACING_BOTTOM_DIR_1_GENERIC].Set(wr.StepX)\r\n\t\tARint.Parameter[BuiltInParameter.NUMBER_PARTITION_PARAM].Set('01_Расположение_Горизонтальная_Внутренняя')\r\n\t\tdoc.Regenerate()\r\n\t\t[rebar.SetSolidInView(doc.ActiveView, True) for rebar in [doc.GetElement(id) for id in ARint.GetRebarInSystemIds()]]\r\n\t\t\r\n\t\tARs.append(ARint)\r\n\t\r\n\tdoc.Regenerate()\r\n\treturn ARs\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nnewARs = []\r\n\r\nfor i, wp in enumerate(WPars):\r\n\tfor j in range(len(levels)-1):\r\n\t\tbaseLvl = levels[j][0]\r\n\t\ttopLvl = levels[j+1][0]\r\n\t\tif wp.GetBaseZ() >= baseLvl.Elevation and wp.GetBaseZ() <= topLvl.Elevation: \r\n\t\t\twr = WRebs[i]\r\n\t\t\tARs = CreateHRebars(wp, wr, baseLvl, topLvl)\r\n\t\t\tnewARs.append(ARs)\r\n\t\t\tbreak\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = rebars, WPars, WRebs, newARs",
      "VariableInputPorts": true,
