      "Code": "import sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndata = UnwrapElement(IN[0])\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nelemFilter = ElementClassFilter(Wall)\r\nviewFilter = LogicalOrFilter(ElementClassFilter(View), ElementClassFilter(View3D))\r\n\r\n\r\nif data.GetType() == View or data.GetType() == View3D:\r\n\tview = data\r\n\tfilteredElems = FilteredElementCollector(doc, view.Id).WherePasses(elemFilter).ToElements()\r\n\r\nelse:\r\n\telems = data\r\n\tif elems.GetType() == Wall:\r\n\t\telems = [elems]\r\n\tfilteredElems = [el for el in elems if elemFilter.PassesFilter(el)]\r\n\r\nOUT = filteredElems\r\n",
