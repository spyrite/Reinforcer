    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Загрузить стандартную библиотеку Python и библиотеку DesignScript\r\nimport sys\r\nimport clr\r\nimport math\r\nimport System\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nWPars = IN[0][0]\r\nWRebs = IN[0][1]\r\n\r\nworkView = [view for view in FilteredElementCollector(doc).OfClass(View3D).ToElements() if view.Name == IN[1]][0]\r\n\r\ndef ByElevation(lvl):\r\n\treturn round(lvl.Elevation*304.8)\r\n\r\nlevels = []\r\nfor lvl in sorted(FilteredElementCollector(doc).OfClass(Level).ToElements(), key=ByElevation):\r\n\tif len(lvl.Name.split('.')) == 1:\r\n\t\tlevels.append([])\r\n\t\tlevels[-1].append(lvl)\r\n\telse:\r\n\t\tlevels[-1].append(lvl)\r\n\r\noptForSlabs = Options()\r\noptForRebars = Options()\r\noptForRebars.View = workView\r\n\r\ndef VecABS(vec):\r\n\tx = abs(vec.X)\r\n\ty = abs(vec.Y)\r\n\tz = abs(vec.Z)\r\n\treturn XYZ(x,y,z)\r\n\r\nRbtValues = {'B15':0.75, 'B20':0.9, 'B25':1.05, 'B30':1.15, 'B35':1.3, 'B40':1.4, 'B45':1.5}\r\n\r\ndef ComputeBaseAnchorLength(d, bclass):\r\n\tRbt = RbtValues[bclass]\r\n\tRs = 435\r\n\tRbond = Rbt*2.5*1\r\n\tAs = (math.pi*d**2)/4\r\n\tus = math.pi*d\r\n\tl0an = (Rs*As)/(Rbond*us)\r\n\treturn l0an\r\n\t\r\ndef ComputeAnchorLength(d, bclass):\r\n\tl0an = ComputeBaseAnchorLength(d, bclass)\r\n\tlan = 0.75*l0an\r\n\treturn math.ceil(max([0.3*l0an, 15*d, 200/304.8, lan])*304.8/10)*10/304.8\r\n\t\r\ndef ComputeOverlapLength(d, bclass):\r\n\tl0an = ComputeBaseAnchorLength(d, bclass)\r\n\tlan = 0.9*l0an\r\n\treturn math.ceil(max([0.3*l0an, 15*d, 200/304.8, lan])*304.8/10)*10/304.8\r\n\t\r\nclass WallAnchor:\r\n\tdef __init__(self):\r\n\t\tself.Location = None\r\n\t\tself.L = None\r\n\t\tself.D = None\r\n\t\tself.N = None\r\n\t\tself.Step = None\r\n\t\tself.DistPathDir = None\r\n\t\tself.Assignment = 'Linear'\r\n\t\r\n\tdef RefreshData(self, wp, rebar):\r\n\t\tsolid = wp.Solid\r\n\t\tif rebar.GetType() == Rebar:\r\n\t\t\tfor item in rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0):\r\n\t\t\t\tif item.GetType() == Line and VecABS(item.Direction.Normalize()).IsAlmostEqualTo(XYZ.BasisZ):\r\n\t\t\t\t\tspotlines = list(solid.IntersectWithCurve(item, None))\r\n\t\t\t\t\tif len(list(spotlines)) > 0:\r\n\t\t\t\t\t\tsp = spotlines[0].GetEndPoint(0)\r\n\t\t\t\t\t\tself.Location = XYZ(sp.X, sp.Y, wp.Z)\r\n\t\t\t\t\t\tself.L = round(spotlines[0].Length*304.8)/304.8\r\n\t\t\t\t\t\tself.D = rebar.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()\r\n\t\t\t\t\t\tself.N = rebar.Parameter[BuiltInParameter.REBAR_ELEM_QUANTITY_OF_BARS].AsInteger()\r\n\t\t\t\t\t\tself.Step = rebar.Parameter[BuiltInParameter.REBAR_ELEM_BAR_SPACING].AsDouble()\r\n\t\t\t\t\t\tself.DistPathDir = rebar.GetShapeDrivenAccessor().GetDistributionPath().Direction.Normalize()\r\n\t\t\t\t\t\tbreak\r\n\t\telif rebar.GetType() == FamilyInstance:\r\n\t\t\tfor item in list(list(rebar.Geometry[optForRebars])[0].GetInstanceGeometry()):\r\n\t\t\t\tif item.GetType() == Line and VecABS(item.Direction.Normalize()).IsAlmostEqualTo(XYZ.BasisZ) and item.GraphicsStyleId.IntegerValue != 4062406:\r\n\t\t\t\t\tspotlines = list(solid.IntersectWithCurve(item, None))\r\n\t\t\t\t\tif len(list(spotlines)) > 0:\r\n\t\t\t\t\t\tsp = spotlines[0].GetEndPoint(0)\r\n\t\t\t\t\t\tself.Location = XYZ(sp.X, sp.Y, wp.Z)\r\n\t\t\t\t\t\tself.L = round(spotlines[0].Length*304.8)/304.8\r\n\t\t\t\t\t\tself.D = rebar.get_Parameter(System.Guid('9b679ab7-ea2e-49ce-90ab-0549d5aa36ff')).AsDouble()\r\n\t\t\t\t\t\tself.N = 1\r\n\t\t\t\t\t\tself.DistPathDir = -rebar.FacingOrientation.Normalize()\r\n\t\t\t\t\t\tbreak\r\n\t\tif self.L is not None:\r\n\t\t\tif round(self.L*304.8, -1) == round(ComputeAnchorLength(self.D, wp.BClass)*304.8):\r\n\t\t\t\tself.ForAnchor = True\r\n\t\t\t\tself.ForOverlap = False\r\n\t\t\telif round(self.L*304.8, -1) == round(ComputeOverlapLength(self.D, wp.BClass)*304.8) or round(self.L*304.8, -1) == math.ceil(2.3*ComputeOverlapLength(self.D, wp.BClass)*304.8/10)*10:\r\n\t\t\t\tself.ForAnchor = False\r\n\t\t\t\tself.ForOverlap = True\r\n\t\t\telse:\r\n\t\t\t\tself.ForAnchor = None\r\n\t\t\t\tself.ForOverlap = None\r\n\r\n\tdef UpdateRebarAssignment(self, wancs, wp):\r\n\t\tdstsToSingleSP = []\r\n\t\tdstsToSingleEP = []\r\n\t\tdstsToArray = []\r\n\r\n\t\tfor wanc in wancs:\r\n\t\t\tif wanc.N == 1:\r\n\t\t\t\tdstsToSingleSP.append(round(wp.SP.DistanceTo(wanc.Location)*304.8))\r\n\t\t\t\tdstsToSingleEP.append(round(wp.EP.DistanceTo(wanc.Location)*304.8))\t\t\r\n\t\t\telse:\r\n\t\t\t\tdstsToArray.append(round(wp.SP.DistanceTo(wanc.Location)*304.8))\r\n\t\t\t\tdstsToArray.append(round(wp.EP.DistanceTo(wanc.Location)*304.8))\t\t\r\n\t\tdstsToSingleSP = sorted(set(dstsToSingleSP))\r\n\t\tdstsToSingleEP = sorted(set(dstsToSingleEP))\r\n\t\tdstsToArray = sorted(set(dstsToArray))\r\n\t\tfor wanc in wancs:\r\n\t\t\tdst = min([round(wp.SP.DistanceTo(wanc.Location)*304.8), round(wp.EP.DistanceTo(wanc.Location)*304.8)])\r\n\t\t\tif wanc.N == 1:\r\n\t\t\t\tif dst == dstsToSingleSP[0] or dst == dstsToSingleSP[1] or dst == dstsToSingleEP[0] or dst == dstsToSingleEP[1]: \r\n\t\t\t\t\twanc.Assignment = 'Edge'\r\n\t\t\telif dst == dstsToArray[0]:\r\n\t\t\t\twanc.Assignment = 'EdgeLinear'\r\n\t\t\r\n\t\topens = wp.GetOpenings()\t\t\r\n\t\tif opens:\r\n\t\t\tfor open in opens:\r\n\t\t\t\tdstsToSingleOpenSP = []\r\n\t\t\t\tdstsToSingleOpenEP = []\r\n\t\t\t\tfor wanc in wancs:\r\n\t\t\t\t\tif wanc.N == 1:\r\n\t\t\t\t\t\tdstsToSingleOpenSP.append(round(open.SP.DistanceTo(wanc.Location)*304.8))\r\n\t\t\t\t\t\tdstsToSingleOpenEP.append(round(open.EP.DistanceTo(wanc.Location)*304.8))\r\n\t\t\t\tdstsToSingleOpenSP = sorted(set(dstsToSingleOpenSP))\r\n\t\t\t\tdstsToSingleOpenEP = sorted(set(dstsToSingleOpenEP))\r\n\t\t\t\tfor wanc in wancs:\r\n\t\t\t\t\tif wanc.N == 1:\r\n\t\t\t\t\t\tdst = min([round(open.SP.DistanceTo(wanc.Location)*304.8), round(open.EP.DistanceTo(wanc.Location)*304.8)])\r\n\t\t\t\t\t\tif dst == dstsToSingleOpenSP[0] or dst == dstsToSingleOpenSP[1] or dst == dstsToSingleOpenEP[0] or dst == dstsToSingleOpenEP[1]: \r\n\t\t\t\t\t\t\twanc.Assignment = 'NearOpening'\r\n\t\t\t\t\r\n#\t\treturn dstsToSingleSP, dstsToSingleEP, dstsToArray, [wanc.Assignment for wanc in wancs]\r\n\t\t\t\t\r\ndef GetRebarLevel(rebar):\r\n\tif rebar.GetType() == Rebar:\r\n\t\thost = doc.GetElement(rebar.GetHostId())\r\n\t\tlvl = doc.GetElement(host.LevelId)\r\n\telif rebar.GetType() == FamilyInstance:\t\r\n\t\tlvl = doc.GetElement(rebar.LevelId)\r\n\telse:\r\n\t\tlvl = None\r\n\treturn lvl\r\n\r\ndef GetWallAnchors(wp):\r\n\tpLvl = wp.GetPreviousLevel()\r\n\trebars = [rebar for rebar in FilteredElementCollector(doc, workView.Id).OfCategory(BuiltInCategory.OST_Rebar).ToElements() if GetRebarLevel(rebar) is not None and GetRebarLevel(rebar).Id.IntegerValue == pLvl.Id.IntegerValue]\r\n\tWAncSet = []\r\n\tfor rebar in rebars:\r\n\t\twanc = WallAnchor()\r\n\t\twanc.RefreshData(wp, rebar)\r\n\t\tif wanc.L is not None and wanc.ForOverlap:\r\n\t\t\tWAncSet.append(wanc)\r\n\tif WAncSet:\r\n\t\twanc.UpdateRebarAssignment(WAncSet, wp)\r\n\telse:\r\n\t\tWAncSet.append(WallAnchor())\r\n\treturn WAncSet#, rebars\r\n\t\r\ndef GetToken(wp, point):\r\n\tif point.IsAlmostEqualTo(wp.EP):\r\n\t\ttoken = -1\r\n\telse:\r\n\t\ttoken = 1\r\n\treturn token\r\n\t\r\n#def GetUpperSlabThickness(wp, catchPoint):\r\n#\tfilter = ElementLevelFilter(wp.TopLvlId)\r\n#\tslabs = FilteredElementCollector(doc).OfClass(Floor).WherePasses(filter).ToElements()\r\n#\tt = 0\r\n#\tfor slab in slabs:\r\n#\t\tmainFace = [face for face in list(slab.Geometry[optForSlabs])[0].Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(XYZ.BasisZ)][0]\r\n#\t\tif mainFace.Project(catchPoint) is not None:\r\n#\t\t\tt = slab.Parameter[BuiltInParameter.FLOOR_ATTR_THICKNESS_PARAM].AsDouble()\r\n#\t\t\tbreak\r\n#\treturn t\r\n\t\r\n#def GetBottomSlabThickness(wp, catchPoint):\r\n#\tfilter = ElementLevelFilter(wp.BottomLvlId)\r\n#\tslabs = FilteredElementCollector(doc).OfClass(Floor).WherePasses(filter).ToElements()\r\n#\tt = 0\r\n#\tfor slab in slabs:\r\n#\t\tmainFace = [face for face in list(slab.Geometry[optForSlabs])[0].Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(XYZ.BasisZ)][0]\r\n#\t\tif mainFace.Project(catchPoint) is not None:\r\n#\t\t\tt = slab.Parameter[BuiltInParameter.FLOOR_ATTR_THICKNESS_PARAM].AsDouble()\r\n#\t\t\tbreak\r\n#\treturn t\r\n\t\r\ndef GetUpperWall(wp, point):\r\n\tcatchPoint = point + XYZ.BasisZ*(wp.BaseOffset + wp.H + 400/304.8)\r\n\tfilter = ElementLevelFilter(wp.TopLvlId)\r\n\twalls = FilteredElementCollector(doc).OfClass(Wall).WherePasses(filter).ToElements()\r\n\tupwall = None\r\n\tfor wall in walls:\r\n\t\tfilter = BoundingBoxContainsPointFilter(catchPoint)\r\n\t\tif filter.PassesFilter(wall):\r\n\t\t\tupwall = wall\r\n\t\t\tbreak\r\n\treturn upwall\r\n\t\r\ndef CreateVRebars(wp, wr, wancs):\r\n#\tallAncLs = [round(wanc.L*304.8) for wanc in wancs]\r\n\tsolid = wp.Solid\r\n\tlines = []\r\n\tadditLines = []\r\n\ttest = []\r\n\tfor wanc in wancs:\r\n\t\tif wanc.Assignment == 'Edge':\r\n\t\t\tD = wr.DY2\r\n\t\telif wanc.Assignment == 'NearOpening':\r\n\t\t\tD = wanc.D\r\n\t\telse:\r\n\t\t\tD = wr.DY1\r\n#\t\tif wp.BaseOffset == 0:\r\n#\t\t\toffset = GetBottomSlabThickness(wp, wanc.Location)\r\n#\t\telse:\r\n#\t\t\toffset = 0\r\n\t\tsp = wanc.Location# + offset\r\n\t\tcutline = Line.CreateBound(sp, sp + XYZ.BasisZ * wp.H)\r\n\t\tspotlines = list(solid.IntersectWithCurve(cutline, None))\r\n\r\n\t\t\r\n\t\t\r\n\t\tif len(spotlines) == 1: \r\n\t\t\tupslabT = wp.GetUpperSlabThickness(wanc.Location)\r\n\t\t\tif wp.TopOffset == upslabT:\r\n\t\t\t\tupslabT = 0\r\n\t\t\tif wp.LvlParity == 1:\r\n\t\t\t\trebarOffsetX = D/2 + wanc.D/2\r\n\t\t\telse:\r\n\t\t\t\trebarOffsetX = -(D/2 + wanc.D/2)\r\n\t\t\tp0 = XYZ(sp.X, sp.Y, wp.Z) + wanc.DistPathDir*rebarOffsetX\r\n\t\t\tp1 = p0 + XYZ.BasisZ*(wp.H + upslabT)\r\n\t\t\t\r\n\t\t\tL0min = round(ComputeOverlapLength(wanc.D, wp.BClass)*304.8)\r\n\t\t\tL0max = math.ceil(ComputeOverlapLength(wanc.D, wp.BClass)*2.3/10*304.8)*10\r\n\t\t\tL = round(wanc.L*304.8, -1)\r\n\t\t\t\r\n\t\t\trebarType = [rt for rt in FilteredElementCollector(doc).OfClass(RebarBarType).ToElements() if rt.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString().find('A500') != -1 and round(rt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()*304.8) == round(D*304.8) and rt.get_Parameter(System.Guid('844a01e2-19fc-4dc5-baa0-a4bda30ef1f6')).AsInteger() == 0 and rt.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsElementId() == ElementId.InvalidElementId][0]\r\n#\t\t\tuw = GetUpperWall(wp, p0)\r\n#\t\t\ttest.append(uw)\r\n\t\t\tif GetUpperWall(wp, p0) is not None:\r\n\t\t\t\tplaceTo = None\r\n\t\t\t\tuwpBClass = GetUpperWall(wp, p0).GetParameters('1Пп_Класс бетона')[0].AsString()\r\n\t\t\t\t\r\n\t\t\t\ttest.append([D*304.8, L, L0min, L0max])\r\n\t\t\t\t\r\n\t\t\t\tif L == L0min:\r\n\t\t\t\t\tp1 = p1 + XYZ.BasisZ*ComputeOverlapLength(D, uwpBClass)\r\n\t\t\t\telif L == L0max:\r\n\t\t\t\t\tp0 = p0 + XYZ.BasisZ*math.ceil(ComputeOverlapLength(D, wp.BClass)*1.3/10*304.8)*10/304.8\r\n\t\t\t\t\tp1 = p1 + XYZ.BasisZ*math.ceil(ComputeOverlapLength(D, uwpBClass)*2.3/10*304.8)*10/304.8\r\n\t\t\t\t\r\n\t\t\t\tupwallStep = GetUpperWall(wp, p0).GetParameters('1Пп_Арм_Вертикальная_Шаг')[0].AsDouble()\r\n\t\t\t\tif round(upwallStep*304.8) != round(wr.StepY*304.8) and wanc.N > 1:\r\n\t\t\t\t\tancN = wanc.N - 1\r\n\t\t\t\t\tancStep = wanc.Step\r\n\t\t\t\t\twanc.N = math.ceil(float(wanc.N)/2)\r\n\t\t\t\t\twanc.Step = upwallStep*2\r\n\t\t\t\t\tif wanc.Assignment != 'EdgeLinear':\r\n\t\t\t\t\t\tif L == L0min:\r\n\t\t\t\t\t\t\tp0 = p0 + wanc.DistPathDir*upwallStep/2 + XYZ.BasisZ*math.ceil(ComputeOverlapLength(D, wp.BClass)*1.3/10*304.8)*10/304.8\r\n\t\t\t\t\t\telif L == L0max:\r\n\t\t\t\t\t\t\tp0 = p0 + wanc.DistPathDir*upwallStep/2 - XYZ.BasisZ*math.ceil(ComputeOverlapLength(D, wp.BClass)*1.3/10*304.8)*10/304.8\r\n\t\t\t\t\t\tp1 = p1 + wanc.DistPathDir*upwallStep/2\r\n\t\t\t\t\telif wanc.Assignment == 'EdgeLinear':\r\n\t\t\t\t\t\tif L == L0min:\r\n\t\t\t\t\t\t\tp0a = p0 + wanc.DistPathDir*wr.StepY + XYZ.BasisZ*math.ceil(ComputeOverlapLength(D, wp.BClass)*1.3/10*304.8)*10/304.8\r\n\t\t\t\t\t\t\tp1a = p1 + wanc.DistPathDir*wr.StepY - XYZ.BasisZ*ComputeOverlapLength(D, uwpBClass) + XYZ.BasisZ*ComputeAnchorLength(D, uwpBClass)\r\n\t\t\t\t\t\telif L == L0max:\r\n\t\t\t\t\t\t\tp0a = p0 + wanc.DistPathDir*wr.StepY - XYZ.BasisZ*math.ceil(ComputeOverlapLength(D, wp.BClass)*1.3/10*304.8)*10/304.8\r\n\t\t\t\t\t\t\tp1a = p1 + wanc.DistPathDir*wr.StepY - XYZ.BasisZ*math.ceil(ComputeOverlapLength(D, uwpBClass)*2.3/10*304.8)*10/304.8 + XYZ.BasisZ*ComputeAnchorLength(D, uwpBClass)\r\n\t\t\t\t\t\tadditLines.append([[Line.CreateBound(p0a, p1a)], ancN, ancStep, rebarType, wanc.DistPathDir])\r\n\t\t\telse:\r\n\t\t\t\tplaceTo = 'shortRebars'\r\n\r\n\t\t\t\tp1 = p1 - XYZ.BasisZ*15/304.8\r\n\t\t\t\tif L == L0max:\r\n\t\t\t\t\tp0 = p0 + XYZ.BasisZ*math.ceil(ComputeOverlapLength(D, wp.BClass)*1.3/10*304.8)*10/304.8\r\n\t\t\t\t\t\t\t\t\r\n\t\t\tlines.append([[Line.CreateBound(p0, p1)], placeTo, rebarType, wanc.DistPathDir])\r\n\t\t\t\t\t\r\n\t\r\n\r\n\trebars = []\r\n\tshortRebars = []\r\n\tfor i, line in enumerate(lines):\r\n\t\trebar = Rebar.CreateFromCurves(doc, RebarStyle.Standard, line[2], None, None, doc.GetElement(ElementId(wp.Id)), line[3], line[0], RebarHookOrientation.Left, RebarHookOrientation.Left, True, False)\r\n#\t\trebar.Parameter[BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS].Set(wancs[i].Assignment)\r\n\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_LAYOUT_RULE].Set(3)\r\n\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_QUANTITY_OF_BARS].Set(wancs[i].N)\r\n\t\tif wancs[i].N > 1:\r\n\t\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_BAR_SPACING].Set(wancs[i].Step)\r\n\t\trebars.append(rebar)\r\n\t\tif line[1] == 'shortRebars':\r\n\t\t\tshortRebars.append(rebar)\r\n\t\t\r\n\tfor line in additLines:\r\n\t\trebar = Rebar.CreateFromCurves(doc, RebarStyle.Standard, line[3], None, None, doc.GetElement(ElementId(wp.Id)), line[4], line[0], RebarHookOrientation.Left, RebarHookOrientation.Left, True, False)\r\n\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_LAYOUT_RULE].Set(3)\r\n\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_QUANTITY_OF_BARS].Set(line[1])\r\n\t\tif line[1] > 1:\r\n\t\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_BAR_SPACING].Set(line[2])\r\n\t\trebars.append(rebar)\t\r\n\t\r\n\tdoc.Regenerate()\r\n\treturn rebars, shortRebars, test\r\n\t\r\n# Введенные в этом узле данные сохраняется в виде списка в переменных IN.\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nnewRebars = []\r\nnewShortRebars = []\r\n\r\nfor i, wp in enumerate(WPars):\r\n\twr = WRebs[i]\r\n\twancs = GetWallAnchors(wp)\r\n\tRebarSet = CreateVRebars(wp, wr, wancs)\r\n\tnewRebars.append(RebarSet[0])\r\n\tif RebarSet[1]:\t\r\n\t\tnewShortRebars.append(RebarSet[1])\r\n\telse:\r\n\t\tnewShortRebars.append([None])\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\n# Назначьте вывод переменной OUT\r\nOUT = newRebars, WPars, WRebs, newShortRebars, RebarSet[2], wancs",
