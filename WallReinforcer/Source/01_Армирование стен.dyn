    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Загрузить стандартную библиотеку Python и библиотеку DesignScript\r\nimport sys\r\nimport clr\r\nimport math\r\nimport System\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ndef ByElevation(lvl):\r\n\treturn round(lvl.Elevation*304.8)\r\n\t\r\ndef ByElevation2(wall):\r\n\treturn round(doc.GetElement(wall.LevelId).Elevation*304.8)\r\n\r\nlevels = []\r\nlevels2 = sorted(FilteredElementCollector(doc).OfClass(Level).ToElements(), key=ByElevation)\r\nfor lvl in levels2:\r\n\tif len(lvl.Name.split('.')) == 1:\r\n\t\tlevels.append([])\r\n\t\tlevels[-1].append(lvl)\r\n\telse:\r\n\t\tlevels[-1].append(lvl)\r\n\r\nworkView = UnwrapElement(IN[0])\r\nwalls = sorted(UnwrapElement(IN[1]), key=ByElevation2)\r\n\r\n#interPoints = UnwrapElement(IN[0][0])\r\n\r\noptForWalls = Options()\r\noptForWalls.ComputeReferences = True\r\n\r\nclass OpeningParameters:\r\n\tdef __init__(self, wp, open):\r\n\t\tself.Id = open.Id\r\n\t\tself.B = wp.Dir.DotProduct(open.BoundingBox[workView].Max) - wp.Dir.DotProduct(open.BoundingBox[workView].Min)\r\n\t\tself.H = open.BoundingBox[workView].Max.Z - open.BoundingBox[workView].Min.Z\r\n\t\tself.Origin = (open.Location.Point + XYZ.BasisZ*(self.H - wp.H))\r\n\t\tself.SP = self.Origin - wp.Dir*self.B/2\r\n\t\tself.EP = self.Origin + wp.Dir*self.B/2\r\n\t\r\nclass WallReinforcement:\r\n\tdef __init__(self, wall):\r\n\t\tself.DX = wall.GetParameters('1Пп_Арм_Горизонтальная_Диаметр')[0].AsDouble()\r\n\t\tself.DY1 = wall.GetParameters('1Пп_Арм_Вертикальная_Диаметр 1')[0].AsDouble()\r\n\t\tself.DY2 = wall.GetParameters('1Пп_Арм_Вертикальная_Диаметр 2')[0].AsDouble()\r\n\t\tself.DY3 = wall.GetParameters('1Пп_Арм_Вертикальная_Диаметр 3')[0].AsDouble()\r\n\t\tself.StepX = wall.GetParameters('1Пп_Арм_Горизонтальная_Шаг')[0].AsDouble()\r\n\t\tself.StepY = wall.GetParameters('1Пп_Арм_Вертикальная_Шаг')[0].AsDouble()\r\n\t\tself.DStud = wall.GetParameters('1Пп_Арм_Шпильки_Диаметр')[0].AsDouble()\r\n\t\tself.CovExt = doc.GetElement(wall.Parameter[BuiltInParameter.CLEAR_COVER_EXTERIOR].AsElementId()).CoverDistance\r\n\t\tself.CovInt = doc.GetElement(wall.Parameter[BuiltInParameter.CLEAR_COVER_INTERIOR].AsElementId()).CoverDistance\r\n\t\tself.CovOth = doc.GetElement(wall.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].AsElementId()).CoverDistance\r\n\t\tself.DStudS = self.DStud * 2.5\r\n\t\t\r\n\tdef GetDY1RebarType(self):\r\n\t\tfor rt in FilteredElementCollector(doc).OfClass(RebarBarType).ToElements():\r\n\t\t\tname = rt.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString()\r\n\t\t\tdiameter = round(rt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()*304.8)\r\n\t\t\tinMeteres = rt.get_Parameter(System.Guid('844a01e2-19fc-4dc5-baa0-a4bda30ef1f6')).AsInteger()\r\n\t\t\tif name.find('A500') != -1 and diameter == round(self.DY1*304.8) and inMeteres == 0:\r\n\t\t\t\tbreak\r\n\t\telse:\r\n\t\t\trt = None\t\r\n\t\treturn rt\r\n\t\t\r\n\tdef GetDY2RebarType(self):\r\n\t\tfor rt in FilteredElementCollector(doc).OfClass(RebarBarType).ToElements():\r\n\t\t\tname = rt.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString()\r\n\t\t\tdiameter = round(rt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()*304.8)\r\n\t\t\tinMeteres = rt.get_Parameter(System.Guid('844a01e2-19fc-4dc5-baa0-a4bda30ef1f6')).AsInteger()\r\n\t\t\tif name.find('A500') != -1 and diameter == round(self.DY2*304.8) and inMeteres == 0:\r\n\t\t\t\tbreak\r\n\t\telse:\r\n\t\t\trt = None\t\r\n\t\treturn rt\r\n\t\t\r\n\tdef GetDXRebarType(self):\r\n\t\tfor rt in FilteredElementCollector(doc).OfClass(RebarBarType).ToElements():\r\n\t\t\tname = rt.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString()\r\n\t\t\tdiameter = round(rt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()*304.8)\r\n\t\t\tinMeteres = rt.get_Parameter(System.Guid('844a01e2-19fc-4dc5-baa0-a4bda30ef1f6')).AsInteger()\r\n\t\t\tif name.find('A500') != -1 and diameter == round(self.DX*304.8) and inMeteres == 0:\r\n\t\t\t\tbreak\r\n\t\telse:\r\n\t\t\trt = None\t\r\n\t\treturn rt\r\n\t\t\r\nclass WallParameters:\r\n\tdef __init__(self, wall):\r\n\t\tself.Id = wall.Id.IntegerValue\r\n\t\tself.T = wall.Width\r\n\t\tself.H = wall.Parameter[BuiltInParameter.WALL_USER_HEIGHT_PARAM].AsDouble()\r\n\t\tself.TopOffset = wall.Parameter[BuiltInParameter.WALL_TOP_OFFSET].AsDouble()\r\n\t\tself.BaseOffset = wall.Parameter[BuiltInParameter.WALL_BASE_OFFSET].AsDouble()\r\n\t\tself.Z = wall.Location.Curve.GetEndPoint(0).Z + self.BaseOffset\r\n\t\tself.Dir = wall.Location.Curve.Direction.Normalize()\r\n\t\tself.Orient = wall.Orientation.Normalize()\r\n\t\tself.CenterLine = wall.Location.Curve\r\n\t\tself.TopLvlId = wall.Parameter[BuiltInParameter.WALL_HEIGHT_TYPE].AsElementId()\r\n\t\tself.BottomLvlId = wall.Parameter[BuiltInParameter.WALL_BASE_CONSTRAINT].AsElementId()\t\t\r\n\t\tself.SP = wall.Location.Curve.GetEndPoint(0)\r\n\t\tself.EP = wall.Location.Curve.GetEndPoint(1)\r\n\t\tself.BClass = wall.GetParameters('1Пп_Класс бетона')[0].AsString()\r\n\t\tself.Solid = [geom for geom in list(wall.Geometry[optForWalls]) if geom.GetType() == Solid and geom.Volume > 0][0]\r\n\t\tself.JoinAllowedAtStart = WallUtils.IsWallJoinAllowedAtEnd(wall, 0)\r\n\t\tself.JoinAllowedAtEnd = WallUtils.IsWallJoinAllowedAtEnd(wall, 1)\r\n\t\tself.JoinedWallsAtStart = list(wall.Location.ElementsAtJoin[0])\r\n\t\tself.JoinedWallsAtEnd = list(wall.Location.ElementsAtJoin[1])\r\n\t\t\r\n\t\twallLvlId = wall.LevelId.IntegerValue\r\n\t\tfor i, lvlSet in enumerate(levels):\r\n\t\t\tfor lvl in lvlSet:\r\n\t\t\t\tif lvl.Id.IntegerValue == wallLvlId:\r\n\t\t\t\t\tself.LvlParity = i % 2\r\n\t\r\n\tdef GetPreviousLevel(self):\r\n\t\tif len(doc.GetElement(self.BottomLvlId).Name.split('.')) == 2:\r\n\t\t\tpLvl = levels2[0]\r\n\t\telse:\r\n\t\t\tcatchPoint = self.CenterLine.ComputeDerivatives(0.5, True).Origin - XYZ.BasisZ* 500/304.8\r\n\t\t\tfilter = BoundingBoxContainsPointFilter(catchPoint)\r\n\t\t\tlowerWall = list(FilteredElementCollector(doc).OfClass(Wall).WherePasses(filter).ToElements())[0]\r\n\t\t\tpLvl = doc.GetElement(lowerWall.Parameter[BuiltInParameter.WALL_BASE_CONSTRAINT].AsElementId())\r\n\t\treturn pLvl\r\n\t\t\r\n\tdef GetTopZ(self):\r\n\t\treturn doc.GetElement(self.TopLvlId).Elevation + self.TopOffset\r\n\t\t\r\n\tdef GetBaseZ(self):\r\n\t \treturn doc.GetElement(self.BottomLvlId).Elevation + self.BaseOffset\r\n\t \t\r\n\tdef GetMidPointOfCenterLine(self):\r\n\t\treturn self.CenterLine.ComputeDerivatives(0.5, True).Origin\r\n\t\t\r\n\tdef GetUpperSlabThickness(self, catchPoint):\r\n\t\tfilter = ElementLevelFilter(self.TopLvlId)\r\n\t\tslabs = FilteredElementCollector(doc).OfClass(Floor).WherePasses(filter).ToElements()\r\n\t\toptForSlabs = Options()\r\n\t\tt = 0\r\n\t\tfor slab in slabs:\r\n\t\t\tmainFace = [face for face in list(slab.Geometry[optForSlabs])[0].Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(XYZ.BasisZ)][0]\r\n\t\t\tif mainFace.Project(catchPoint) is not None:\r\n\t\t\t\tt = slab.Parameter[BuiltInParameter.FLOOR_ATTR_THICKNESS_PARAM].AsDouble()\r\n\t\t\t\tbreak\r\n\t\treturn t\r\n\t\t\r\n\tdef GetBottomSlabThickness(self, catchPoint):\r\n\t\tfilter = ElementLevelFilter(self.BottomLvlId)\r\n\t\tslabs = FilteredElementCollector(doc).OfClass(Floor).WherePasses(filter).ToElements()\r\n\t\toptForSlabs = Options()\r\n\t\tt = 0\r\n\t\tfor slab in slabs:\r\n\t\t\tmainFace = [face for face in list(slab.Geometry[optForSlabs])[0].Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(XYZ.BasisZ)][0]\r\n\t\t\tif mainFace.Project(catchPoint) is not None:\r\n\t\t\t\tt = slab.Parameter[BuiltInParameter.FLOOR_ATTR_THICKNESS_PARAM].AsDouble()\r\n\t\t\t\tbreak\r\n\t\treturn t\r\n\t\t\r\n\tdef GetFloor(self, catchPoint):\r\n\t\tfilter = ElementLevelFilter(self.BottomLvlId)\r\n\t\tslabs = FilteredElementCollector(doc).OfClass(Floor).WherePasses(filter).ToElements()\r\n\t\tfloor = None\r\n\t\toptForSlabs = Options()\r\n\t\tfor slab in slabs:\r\n\t\t\tmainFace = [face for face in list(slab.Geometry[optForSlabs])[0].Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(XYZ.BasisZ)][0]\r\n\t\t\tif mainFace.Project(catchPoint) is not None:\r\n\t\t\t\tfloor = slab\r\n\t\t\t\tbreak\r\n\t\treturn floor\r\n\t\t\r\n\tdef GetOpenings(self):\r\n\t\twall = doc.GetElement(ElementId(self.Id))\r\n\t\tfilter = LogicalAndFilter(ElementClassFilter(FamilyInstance), ElementCategoryFilter(BuiltInCategory.OST_Windows))\r\n\t\topenings = [doc.GetElement(id) for id in wall.GetDependentElements(filter)]\r\n\t\treturn [OpeningParameters(self, open) for open in openings]\r\n\t\t\r\n#\tdef HasIntersectionWithOtherWall(self):\r\n#\t\tfor ip in interPoints[0]:\r\n#\t\t\tif self.SP.IsAlmostEqualTo(ip, self.T) and not self.EP.IsAlmostEqualTo(ip, self.T):\r\n#\t\t\t\treturn 'AtStart'\r\n#\t\t\telif not self.SP.IsAlmostEqualTo(ip, self.T) and self.EP.IsAlmostEqualTo(ip, self.T):\r\n#\t\t\t\treturn 'AtEnd'\r\n#\t\t\telif self.SP.IsAlmostEqualTo(ip, self.T) and self.EP.IsAlmostEqualTo(ip, self.T):\r\n#\t\t\t\treturn 'Both'\r\n#\t\t\telse:\r\n#\t\t\t\treturn None\r\n\t\t\t\t\r\n# Введенные в этом узле данные сохраняется в виде списка в переменных IN.\r\n\r\nWPars = [WallParameters(wall) for wall in walls]\r\nWRebs = [WallReinforcement(wall) for wall in walls]\r\n\t\r\n# Назначьте вывод переменной OUT\r\nOUT = WPars, WRebs#, WPars[0].HasIntersectionWithOtherWall()",
      "VariableInputPorts": true,
      "Id": "d3314e31343b45ada9a62b08e455c999",
      "Inputs": [
        {
          "Id": "32a231fe68c34e6796c4f575439ed0f2",
          "Name": "IN[0]",
          "Description": "Input #0",
