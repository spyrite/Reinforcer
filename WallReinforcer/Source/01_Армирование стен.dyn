    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nimport math\r\nimport System\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ndata = IN[0]\r\nWPars = data[1]\r\nWRebs = data[2]\r\nARs = UnwrapElement(data[3])\r\n\r\ndef VecABS(vec):\r\n\tx = abs(vec.X)\r\n\ty = abs(vec.Y)\r\n\tz = abs(vec.Z)\r\n\treturn XYZ(x,y,z)\r\n\r\ndef GetOriginsForUHRebars(AR, wp):\r\n\trebars = [doc.GetElement(id) for id in AR.GetRebarInSystemIds()]\r\n\tlines = [rebar.GetCenterlineCurves(False, True, True)[0] for rebar in rebars] \r\n\torigins = []\r\n\tfor i, line in enumerate(lines):\r\n\t\tlocZ = GetRebarLocAndDir(rebars[i])[0].Z\r\n\t\tZ = locZ + min([rebars[i].GetBarPositionTransform(j).Origin.Z for j in range(rebar.NumberOfBarPositions)])\r\n\t\tsp = XYZ(line.GetEndPoint(0).X, line.GetEndPoint(0).Y, Z)\r\n\t\tep = XYZ(line.GetEndPoint(1).X, line.GetEndPoint(1).Y, Z)\r\n\t\tpoints = [sp, ep]\r\n\t\tfor j, p in enumerate(points):\r\n\t\t\tn = rebars[i].Parameter[BuiltInParameter.REBAR_ELEM_QUANTITY_OF_BARS].AsInteger()\r\n\t\t\tif n > 1:\r\n\t\t\t\tstep = rebars[i].Parameter[BuiltInParameter.REBAR_ELEM_BAR_SPACING].AsDouble()\r\n\t\t\telse:\r\n\t\t\t\tstep = None\r\n\t\t\tif j == 0:\r\n\t\t\t\ttoken = 1\r\n\t\t\telse:\r\n\t\t\t\ttoken = -1\r\n\t\t\torigins.append([p, n, step, token])\r\n\treturn origins\r\n\t\r\ndef GetRebarLocAndDir(rebar):\r\n\tif rebar.GetType() == RebarInSystem:\r\n\t\tcenterLine = rebar.GetCenterlineCurves(False, True, True)[0]\r\n\t\tdir2 = VecABS(rebar.Normal.Normalize())\r\n\telse:\r\n\t\tcenterLine = rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)[0]\r\n\t\tdir2 = VecABS(rebar.GetShapeDrivenAccessor().Normal.Normalize())\r\n\tloc = centerLine.GetEndPoint(0)\r\n\tdir = VecABS(centerLine.Direction)\r\n\treturn loc, dir, dir2\r\n\t\r\ndef GetNearestUHRebar(p0, rebars):\r\n\tnearestRebar = None\r\n\tdsts = []\r\n\tfor rebar in rebars:\r\n\t\tloc = GetRebarLocAndDir(rebar)[0]\r\n\t\tdst = loc.DistanceTo(p0)\r\n\t\tdsts.append(dst)\r\n\tif dsts:\r\n\t\tminDst = min(dsts)\r\n\t\tfor i, rebar in enumerate(rebars):\r\n\t\t\tloc = GetRebarLocAndDir(rebar)[0]\r\n\t\t\tdst = loc.DistanceTo(p0)\r\n\t\t\tif dst == minDst:\r\n\t\t\t\tnearestRebar = rebars.pop(i)\r\n\t\t\t\tbreak\r\n\treturn nearestRebar\r\n\t\r\ndef ModifyUHRebars(AR, wp, wr):\r\n\thost = doc.GetElement(AR.GetHostId())\r\n\texistUHRebars = []\r\n\tfor id in host.GetDependentElements(ElementClassFilter(Rebar)):\r\n\t\trebar = doc.GetElement(id)\r\n\t\trebarPart = rebar.Parameter[BuiltInParameter.NUMBER_PARTITION_PARAM].AsString()\r\n\t\trebarDir = GetRebarLocAndDir(rebar)[2]\r\n\t\tif rebarPart == '02_П-образные хомуты' and rebarDir.IsAlmostEqualTo(XYZ.BasisZ):\r\n\t\t\texistUHRebars.append(rebar)\r\n\t\t\t\r\n\tif existUHRebars:\t\t\t\r\n\t\trebarType = [rt for rt in FilteredElementCollector(doc).OfClass(RebarBarType).ToElements() if rt.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString().find('A500') != -1 and round(rt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()*304.8) == round(wr.DX*304.8) and rt.get_Parameter(System.Guid('844a01e2-19fc-4dc5-baa0-a4bda30ef1f6')).AsInteger() == 0][0]\r\n\t\torigins = GetOriginsForUHRebars(AR, wp) \r\n\t\txvec = wp.Dir\r\n\t\tyvec = wp.Orient\r\n\t\trebars = []\r\n\t\tfor p in origins:\r\n\t\t\tplacePoint = p[0] + XYZ.BasisZ*wr.DX*p[3] - xvec*wr.DX/2*p[3] - yvec*wr.DX/2\r\n\t\t\trebar = GetNearestUHRebar(placePoint, existUHRebars) \r\n\t\t\tif rebar:\r\n\t\t\t\trebar.GetShapeDrivenAccessor().SetRebarShapeId(shape.Id)\t\t\t\r\n\t\t\t\trebar.ChangeTypeId(rebarType.Id)\r\n\t\t\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_LAYOUT_RULE].Set(3)\r\n\t\t\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_LAYOUT_RULE].Set(3)\r\n\t\t\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_QUANTITY_OF_BARS].Set(p[1])\r\n\t\t\t\tif p[1] > 1:\r\n\t\t\t\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_BAR_SPACING].Set(p[2])\r\n\r\n\t\t\t\txVecBox = xvec*(wp.T*2+wr.DX/2)*p[3] \r\n\t\t\t\tyVecBox = yvec*(wp.T - wr.CovExt - wr.CovInt) \r\n\t\t\t\trebar.GetShapeDrivenAccessor().ScaleToBox(placePoint, xVecBox, yVecBox)\r\n\t\t\t\trebar.SetSolidInView(doc.ActiveView, True)\r\n\t\t\t\trebars.append(rebar)\r\n\t\treturn rebars\r\n\telse:\r\n\t\treturn None\r\n\t\t\r\nshape = [shape for shape in FilteredElementCollector(doc).OfClass(RebarShape).ToElements() if shape.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString() == IN[1]][0]\r\n\t\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nupdatedRebars = []\r\n\r\nfor i, ARset in enumerate(ARs):\r\n\twp = WPars[i]\r\n\twr = WRebs[i]\r\n\tfor AR in ARset:\t\r\n\t\tupdatedRebars.append(ModifyUHRebars(AR, wp, wr))\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = updatedRebars",
