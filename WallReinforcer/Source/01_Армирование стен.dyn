      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nimport math\r\nimport System\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nWPars = IN[0][1]\r\nWRebs = IN[0][2]\r\n\r\n\r\ndef ByElevation(lvl):\r\n\treturn round(lvl.Elevation*304.8)\r\n\r\nlevels = []\r\nfor lvl in sorted(FilteredElementCollector(doc).OfClass(Level).ToElements(), key=ByElevation):\r\n\tif len(lvl.Name.split('.')) == 1:\r\n\t\tlevels.append([])\r\n\t\tlevels[-1].append(lvl)\r\n\telse:\r\n\t\tlevels[-1].append(lvl)\r\n\r\noptForSlabs = Options()\r\n\r\ndef VecABS(vec):\r\n\tx = abs(vec.X)\r\n\ty = abs(vec.Y)\r\n\tz = abs(vec.Z)\r\n\treturn XYZ(x,y,z)\r\n\t\r\ndef MultiplyVecs(vec1, vec2):\r\n\tx = vec1.X * vec2.X\r\n\ty = vec1.Y * vec2.Y\r\n\tz = vec1.Z * vec2.Z\r\n\treturn XYZ(x,y,z)\r\n\t\r\ndef GetNonZeroCoord(vec):\r\n\tif round(vec.X*304.8) != 0:\r\n\t\treturn vec.X\r\n\telif round(vec.Y*304.8) != 0:\r\n\t\treturn vec.Y\r\n\telse:\r\n\t\treturn vec.Z\r\n\t\t\r\ndef GetVecToken(vec):\r\n\treturn vec.X+vec.Y+vec.Z\r\n\t\r\ndef GetRebarsForIntSide(allRebarsV, wp):\r\n\trebars = []\r\n\tfor rebar in allRebarsV:\r\n\t\textFace = [face for face in wp.Solid.Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(wp.Orient)][0]\r\n\t\tintFace = [face for face in wp.Solid.Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(-wp.Orient)][0]\r\n\t\tline = rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)[0]\r\n\t\tp0 = line.GetEndPoint(0) + XYZ.BasisZ*10/304.8\r\n\t\textDst = p0.DistanceTo(extFace.Project(p0).XYZPoint)\r\n\t\tintDst = p0.DistanceTo(intFace.Project(p0).XYZPoint)\r\n\t\tif extDst > intDst:\r\n\t\t\trebars.append(rebar)\r\n\treturn rebars\r\n\t\r\ndef GetOriginsForUVRebars(allRebarsV, wp):\r\n\trebars =  [r for r in GetRebarsForIntSide(allRebarsV, wp) if r.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()*304.8 < 20]\r\n\torigins = []\r\n\tfor rebar in rebars:\r\n\t\tline = rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)[0]\r\n\t\tpoint = line.GetEndPoint(1)\r\n\t\tn = rebar.Parameter[BuiltInParameter.REBAR_ELEM_QUANTITY_OF_BARS].AsInteger()\r\n\t\td = rebar.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()\r\n\t\tif n > 1:\r\n\t\t\tstep = rebar.Parameter[BuiltInParameter.REBAR_ELEM_BAR_SPACING].AsDouble()\r\n\t\telse:\r\n\t\t\tstep = None\r\n\t\torigins.append([point, n, step, d])\r\n\treturn origins\r\n\t\r\ndef GetRebarLocAndDir(rebar):\r\n\tif rebar.GetType() == RebarInSystem:\r\n\t\tcenterLine = rebar.GetCenterlineCurves(False, True, True)[0]\r\n\t\tdir2 = VecABS(rebar.Normal.Normalize())\r\n\telse:\r\n\t\tcenterLine = rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)[0]\r\n\t\tdir2 = VecABS(rebar.GetShapeDrivenAccessor().Normal.Normalize())\r\n\tloc = centerLine.GetEndPoint(0)\r\n\tdir = VecABS(centerLine.Direction)\r\n\treturn loc, dir, dir2\r\n\t\r\ndef GetNearestUVRebar(p0, rebars):\r\n\tnearestRebar = None\r\n\tdsts = []\r\n\tfor rebar in rebars:\r\n\t\tloc = GetRebarLocAndDir(rebar)[0]\r\n\t\tdst = loc.DistanceTo(p0)\r\n\t\tdsts.append(dst)\r\n\tif dsts:\r\n\t\tminDst = min(dsts)\r\n\t\tfor i, rebar in enumerate(rebars):\r\n\t\t\tloc = GetRebarLocAndDir(rebar)[0]\r\n\t\t\tdst = loc.DistanceTo(p0)\r\n\t\t\tif dst == minDst:\r\n\t\t\t\tnearestRebar = rebars.pop(i)\r\n\t\t\t\tbreak\r\n\treturn nearestRebar\r\n\t\r\ndef ModifyUVRebars(rebarsV, rebarsUV, wp, wr):\r\n\thost = doc.GetElement(ElementId(wp.Id))\r\n\torigins = GetOriginsForUVRebars(rebarsV, wp)\r\n\txvec = -XYZ.BasisZ\r\n\tyvec = wp.Orient\r\n\trebars = []\r\n\tfor p in origins:\r\n\t\trebarType = [rt for rt in FilteredElementCollector(doc).OfClass(RebarBarType).ToElements() if rt.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString().find('A500') != -1 and round(rt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()*304.8) == round(p[3]*304.8) and rt.get_Parameter(System.Guid('844a01e2-19fc-4dc5-baa0-a4bda30ef1f6')).AsInteger() == 0][0]\r\n\r\n\t\tplacePoint = p[0] + wp.Dir*(p[3]) - yvec*(p[3]/2)\r\n\t\t\r\n\t\trebar = GetNearestUVRebar(placePoint, rebarsUV)\r\n\t\tif rebar:\r\n\t\t\trebar.GetShapeDrivenAccessor().SetRebarShapeId(shapeUV.Id)\t\t\t\r\n\t\t\trebar.ChangeTypeId(rebarType.Id)\r\n\t\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_LAYOUT_RULE].Set(3)\r\n\t\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_QUANTITY_OF_BARS].Set(p[1])\r\n\t\t\tif p[1] > 1:\r\n\t\t\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_BAR_SPACING].Set(p[2])\r\n\r\n\t\t\txVecBox = xvec*(wp.GetUpperSlabThickness(p[0])*2)\r\n\t\t\tyVecBox = yvec*(wp.T - wr.CovExt - wr.CovInt-wr.DX*2)\r\n\t\t\trebar.GetShapeDrivenAccessor().ScaleToBox(placePoint, xVecBox, yVecBox)\r\n\t\t\trebar.SetSolidInView(doc.ActiveView, True)\r\n\t\t\trebars.append(rebar)\r\n\tdoc.Regenerate()\r\n\treturn rebars, origins\r\n\t\r\nshapeUV = [shape for shape in FilteredElementCollector(doc).OfClass(RebarShape).ToElements() if shape.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString() == IN[1]][0]\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nupdatedRebars = []\r\n\r\nfor i, wp in enumerate(WPars):\r\n\twall = doc.GetElement(ElementId(wp.Id))\r\n\trebars = [doc.GetElement(id) for id in wall.GetDependentElements(ElementClassFilter(Rebar))]\r\n\trebarsUV = []\r\n\tfor rebar in rebars:\r\n\t\tdir = GetRebarLocAndDir(rebar)[1]\r\n\t\tshapeId = rebar.GetShapeId().IntegerValue\r\n\t\trebarPart = rebar.Parameter[BuiltInParameter.NUMBER_PARTITION_PARAM].AsString()\r\n\t\tif dir.IsAlmostEqualTo(XYZ.BasisZ) and shapeId == shapeUV.Id.IntegerValue and rebarPart == '02_П-образные хомуты':\r\n\t\t\trebarsUV.append(rebar)\r\n\tif rebarsUV:\r\n\t\trebarsV = []\r\n\t\tfor rebar in rebars:\r\n\t\t\tdir = GetRebarLocAndDir(rebar)[1]\r\n\t\t\tisSimple = doc.GetElement(rebar.GetShapeId()).SimpleLine\r\n\t\t\tif dir.IsAlmostEqualTo(XYZ.BasisZ) and isSimple:\r\n\t\t\t\trebarsV.append(rebar)\r\n\t\twr = WRebs[i]\r\n\t\tupdatedRebars.append(ModifyUVRebars(rebarsV, rebarsUV, wp, wr))\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = updatedRebars",
      "VariableInputPorts": true,
