      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nimport math\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nWPars = IN[0][0]\r\nWRebs = IN[0][1]\r\n\r\nworkView = doc.ActiveView\r\n\r\ndef VecABS(vec):\r\n\tx = abs(vec.X)\r\n\ty = abs(vec.Y)\r\n\tz = abs(vec.Z)\r\n\treturn XYZ(x,y,z)\r\n\r\nRbtValues = {'B15':0.75, 'B20':0.9, 'B25':1.05, 'B30':1.15, 'B35':1.3, 'B40':1.4, 'B45':1.5}\r\n\r\ndef ComputeBaseAnchorLength(d, bclass):\r\n\tRbt = RbtValues[bclass]\r\n\tRs = 435\r\n\tRbond = Rbt*2.5*1\r\n\tAs = (math.pi*d**2)/4\r\n\tus = math.pi*d\r\n\tl0an = (Rs*As)/(Rbond*us)\r\n\treturn l0an\r\n\t\r\ndef ComputeAnchorLength(d, bclass):\r\n\tl0an = ComputeBaseAnchorLength(d, bclass)\r\n\tlan = 0.75*l0an\r\n\treturn math.ceil(max([0.3*l0an, 15*d, 200/304.8, lan])*304.8/10)*10/304.8\r\n\t\r\ndef ComputeOverlapLength(d, bclass):\r\n\tl0an = ComputeBaseAnchorLength(d, bclass)\r\n\tlan = 0.9*l0an\r\n\treturn math.ceil(max([0.3*l0an, 15*d, 200/304.8, lan])*304.8/10)*10/304.8\r\n\t\r\ndef GetRebarLevel(rebar):\r\n\tif rebar.GetType() == Rebar:\r\n\t\thost = doc.GetElement(rebar.GetHostId())\r\n\t\tlvl = doc.GetElement(host.LevelId)\r\n\telse:\r\n\t\tlvl = None\r\n\treturn lvl\r\n\r\ndef GetWallAnchors(wp, wr):\r\n\tpLvl = wp.GetPreviousLevel()\r\n\trebars = [rebar for rebar in FilteredElementCollector(doc, workView.Id).OfClass(Rebar).ToElements() if GetRebarLevel(rebar) is not None and GetRebarLevel(rebar).Id.IntegerValue == pLvl.Id.IntegerValue]\r\n\tWAncSet = []\r\n\tfor rebar in rebars:\r\n\t\twanc = WallAnchor()\r\n\t\twanc.RefreshData(wp, rebar, wr)\r\n\t\t\r\n#\t\ttest.append([wanc.L*304.8, wanc.ForOverlap1, wanc.ForOverlap2])\r\n\r\n\t\tif wanc.L is not None and (wanc.ForOverlap1 or wanc.ForOverlap2):\r\n\t\t\tWAncSet.append(wanc)\r\n\tif WAncSet:\r\n\t\twanc.UpdateRebarAssignment(WAncSet, wp)\r\n\treturn WAncSet\r\n\t\r\nclass WallAnchor:\r\n\tdef __init__(self):\r\n\t\tself.Location = None\r\n\t\tself.L = None\r\n\t\tself.D = None\r\n\t\tself.N = None\r\n\t\tself.Step = None\r\n\t\tself.DistPathDir = None\r\n\t\tself.Assignment = 'Linear'\r\n\t\tself.Reb = None\r\n\t\r\n\tdef RefreshData(self, wp, rebar, wr):\r\n\t\tif rebar.GetType() == Rebar:\r\n\t\t\tsolid = wp.Solid\r\n\t\t\tcenterLines = rebar.GetCenterlineCurves(True, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)\r\n\t\t\tfor item in centerLines:\r\n\t\t\t\tif item.GetType() == Line and VecABS(item.Direction.Normalize()).IsAlmostEqualTo(XYZ.BasisZ):\r\n\t\t\t\t\tspotlines = list(solid.IntersectWithCurve(item, None))\r\n\t\t\t\t\tif spotlines:\r\n\t\t\t\t\t\tsp = spotlines[0].GetEndPoint(0)\r\n\t\t\t\t\t\tself.Location = XYZ(sp.X, sp.Y, wp.Z)\r\n\t\t\t\t\t\tself.L = round(spotlines[0].Length*304.8)/304.8\r\n\t\t\t\t\t\tself.D = rebar.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()\r\n\t\t\t\t\t\tself.N = rebar.Parameter[BuiltInParameter.REBAR_ELEM_QUANTITY_OF_BARS].AsInteger()\r\n\t\t\t\t\t\tself.Step = rebar.Parameter[BuiltInParameter.REBAR_ELEM_BAR_SPACING].AsDouble()\r\n\t\t\t\t\t\tself.DistPathDir = rebar.GetShapeDrivenAccessor().GetDistributionPath().Direction.Normalize()\r\n\t\t\t\t\t\tself.Reb = rebar\r\n\t\t\t\t\t\tbreak\r\n\t\t\r\n\t\tol1 = round(ComputeOverlapLength(wr.DY1, wp.BClass)*304.8)\r\n\t\tol2 = round(ComputeOverlapLength(wr.DY2, wp.BClass)*304.8)\r\n\t\tif wr.DY3 > 0:\r\n\t\t\tol3 = round(ComputeOverlapLength(wr.DY3, wp.BClass)*304.8)\r\n\t\telse:\r\n\t\t\tol3 = ol1\r\n\t\tminOverlaps = [ol1, ol2, ol3]\r\n\t\ttest.append(minOverlaps)\r\n\r\n\t\tol4 = math.ceil(2.3*ComputeOverlapLength(wr.DY1, wp.BClass)*304.8/10)*10\r\n\t\tol5 = math.ceil(2.3*ComputeOverlapLength(wr.DY2, wp.BClass)*304.8/10)*10\r\n\t\tif wr.DY3 > 0:\r\n\t\t\tol6 = math.ceil(2.3*ComputeOverlapLength(wr.DY3, wp.BClass)*304.8/10)*10\r\n\t\telse:\r\n\t\t\tol6 = ol4\r\n\t\tmaxOverlaps = [ol4, ol5, ol6]\r\n\t\t\r\n\t\tif self.L is not None:\r\n\t\t\tif round(self.L*304.8, -1) == round(ComputeAnchorLength(self.D, wp.BClass)*304.8):\r\n\t\t\t\tself.ForAnchor = True\r\n\t\t\t\tself.ForOverlap1 = False\r\n\t\t\t\tself.ForOverlap2 = False\r\n\t\t\telif round(self.L*304.8, -1) in minOverlaps:\r\n\t\t\t\tself.ForAnchor = False\r\n\t\t\t\tself.ForOverlap1 = True\r\n\t\t\t\tself.ForOverlap2 = False\r\n\t\t\telif round(self.L*304.8, -1) in maxOverlaps:\r\n\t\t\t\tself.ForAnchor = False\r\n\t\t\t\tself.ForOverlap1 = False\r\n\t\t\t\tself.ForOverlap2 = True\r\n\t\t\telse:\r\n\t\t\t\tself.ForAnchor = None\r\n\t\t\t\tself.ForOverlap1 = None\r\n\t\t\t\tself.ForOverlap2 = None\r\n\r\n\tdef UpdateRebarAssignment(self, wancs, wp):\r\n\t\tdstsToSingleSP = []\r\n\t\tdstsToSingleEP = []\r\n\t\tdstsToArray = []\r\n\r\n\t\tfor wanc in wancs:\r\n\t\t\tif wanc.N == 1:\r\n\t\t\t\tdstsToSingleSP.append(round(wp.SP.DistanceTo(wanc.Location)*304.8))\r\n\t\t\t\tdstsToSingleEP.append(round(wp.EP.DistanceTo(wanc.Location)*304.8))\t\t\r\n\t\t\telse:\r\n\t\t\t\tdstsToArray.append(round(wp.SP.DistanceTo(wanc.Location)*304.8))\r\n\t\t\t\tdstsToArray.append(round(wp.EP.DistanceTo(wanc.Location)*304.8))\t\t\r\n\t\tdstsToSingleSP = sorted(set(dstsToSingleSP))\r\n\t\tdstsToSingleEP = sorted(set(dstsToSingleEP))\r\n\t\tdstsToArray = sorted(set(dstsToArray))\r\n\t\tfor wanc in wancs:\r\n\t\t\tdst = min([round(wp.SP.DistanceTo(wanc.Location)*304.8), round(wp.EP.DistanceTo(wanc.Location)*304.8)])\r\n\t\t\tif wanc.N == 1:\r\n\t\t\t\tdstSP = round(wp.SP.DistanceTo(wanc.Location)*304.8)\r\n\t\t\t\tdstEP = round(wp.EP.DistanceTo(wanc.Location)*304.8)\r\n\t\t\t\tif dstSP == dstsToSingleSP[0] or dstSP == dstsToSingleSP[1]:\r\n\t\t\t\t\twanc.Assignment = 'EdgeStart'\r\n\t\t\t\telif dstEP == dstsToSingleEP[0] or dstEP == dstsToSingleEP[1]: \r\n\t\t\t\t\twanc.Assignment = 'EdgeEnd'\r\n\t\t\telif dst == dstsToArray[0]:\r\n\t\t\t\twanc.Assignment = 'EdgeLinear'\r\n\t\t\r\n\t\topens = wp.GetOpenings()\r\n\t\topens = False\r\n\t\tif opens:\r\n\t\t\tfor open in opens:\r\n\t\t\t\tdstsToSingleOpenSP = []\r\n\t\t\t\tdstsToSingleOpenEP = []\r\n\t\t\t\tfor wanc in wancs:\r\n\t\t\t\t\tif wanc.N == 1:\r\n\t\t\t\t\t\tdstsToSingleOpenSP.append(round(open.SP.DistanceTo(wanc.Location)*304.8))\r\n\t\t\t\t\t\tdstsToSingleOpenEP.append(round(open.EP.DistanceTo(wanc.Location)*304.8))\r\n\t\t\t\tdstsToSingleOpenSP = sorted(set(dstsToSingleOpenSP))\r\n\t\t\t\tdstsToSingleOpenEP = sorted(set(dstsToSingleOpenEP))\r\n\t\t\t\tfor wanc in wancs:\r\n\t\t\t\t\tif wanc.N == 1:\r\n\t\t\t\t\t\tdst = min([round(open.SP.DistanceTo(wanc.Location)*304.8), round(open.EP.DistanceTo(wanc.Location)*304.8)])\r\n\t\t\t\t\t\tif dst == dstsToSingleOpenSP[0] or dst == dstsToSingleOpenSP[1] or dst == dstsToSingleOpenEP[0] or dst == dstsToSingleOpenEP[1]: \r\n\t\t\t\t\t\t\twanc.Assignment = 'NearOpening'\r\n\r\ntr1 = Transform.Identity\r\ntr2 = Transform.Identity\r\nWAncs = []\r\ntest = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor i, wp in enumerate(WPars):\r\n\twr = WRebs[i]\r\n\twancs = GetWallAnchors(wp, wr)\r\n#\twancs = True\r\n\tif wancs:\r\n\t\tWAncs.append(wancs)\r\n\t\twall = doc.GetElement(ElementId(wp.Id))\r\n\t\twr = WRebs[i]\r\n\t\ttr1.Origin = -wp.SP\r\n\t\ttr2.BasisX = wp.Dir\r\n\t\ttr2.BasisY = wp.Orient\r\n\t\t\r\n\t\tdsts1 = []\r\n\t\tdsts2 = []\r\n\t\tfor wanc in wancs:\r\n\t\t\ty = tr2.OfVector(tr1.OfPoint(wanc.Location)).Y\r\n\t\t\tif y > 0:\r\n\t\t\t\tdsts1.append(wp.T/2 - (y + wanc.D/2))\r\n\t\t\telse:\r\n\t\t\t\tdsts2.append(wp.T/2 - (abs(y) + wanc.D/2))\r\n\t\t\t\r\n\t\tdst1 = min(dsts1) - wr.DX\r\n\t\tdst2 = min(dsts2) - wr.DX\r\n\t\tdst3 = 15/304.8\r\n\t\t\r\n\t\tcovTypes1 = [ct for ct in FilteredElementCollector(doc).OfClass(RebarCoverType).ToElements() if round(ct.CoverDistance*304.8, 1) == round(dst1*304.8, 1)]\r\n\t\tcovTypes2 = [ct for ct in FilteredElementCollector(doc).OfClass(RebarCoverType).ToElements() if round(ct.CoverDistance*304.8, 1) == round(dst2*304.8, 1)]\r\n\t\tcovTypes3 = [ct for ct in FilteredElementCollector(doc).OfClass(RebarCoverType).ToElements() if round(ct.CoverDistance*304.8, 1) == round(dst3*304.8, 1)]\r\n\t\tif covTypes1:\r\n\t\t\tcovType1 = covTypes1[0]\r\n\t\telse:\r\n\t\t\tcovType1 = RebarCoverType.Create(doc, str(round(dst1*304.8, 1)), dst1)\r\n\t\tif covTypes2:\r\n\t\t\tcovType2 = covTypes2[0]\r\n\t\telse:\r\n\t\t\tcovType2 = RebarCoverType.Create(doc, str(round(dst2*304.8, 1)), dst2)\r\n\t\tif covTypes3:\r\n\t\t\tcovType3 = covTypes3[0]\r\n\t\telse:\r\n\t\t\tcovType3 = RebarCoverType.Create(doc, str(round(dst3*304.8, 1)), dst3)\r\n\t\t\t\r\n\t\tif wr.CovExt and wr.CovExt != dst1:\r\n\t\t\twr.CovExt = dst1\r\n\t\t\twall.Parameter[BuiltInParameter.CLEAR_COVER_EXTERIOR].Set(covType1.Id)\r\n\t\tif wr.CovInt and wr.CovInt != dst2:\r\n\t\t\twr.CovInt = dst2\r\n\t\t\twall.Parameter[BuiltInParameter.CLEAR_COVER_INTERIOR].Set(covType2.Id)\r\n\t\tif wr.CovOth != dst3:\r\n\t\t\twr.CovOth = dst3\r\n\t\t\twall.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].Set(covType3.Id)\r\n#\telse:\r\n#\t\tWancs.append(None)\r\n\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = WPars, WRebs, WAncs\r\n#OUT = doc.GetElement(ElementId(wp.Id)), test, [[wanc.Reb for wanc in wancs] for wancs in WAncs]\r\n#OUT = test",
