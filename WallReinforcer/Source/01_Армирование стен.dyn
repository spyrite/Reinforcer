    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nimport math\r\nimport System\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nrebars = UnwrapElement(IN[0][0])\r\nWPars = IN[0][1]\r\nWRebs = IN[0][2]\r\nARs = UnwrapElement(IN[0][3])\r\n\r\noptForSlabs = Options()\r\n\r\ndef VecABS(vec):\r\n\tx = abs(vec.X)\r\n\ty = abs(vec.Y)\r\n\tz = abs(vec.Z)\r\n\treturn XYZ(x,y,z)\r\n\r\ndef ByZ(rebar):\r\n\tline = rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)[0]\r\n\tmidpoint = line.ComputeDerivatives(0.5, True).Origin\r\n\treturn midpoint.Z\r\n\t\r\ndef GetRebarsForIntSide(allRebarsV, wp):\r\n\trebars = []\r\n\tfor rebar in allRebarsV:\r\n\t\textFace = [face for face in wp.Solid.Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(wp.Orient)][0]\r\n\t\tintFace = [face for face in wp.Solid.Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(-wp.Orient)][0]\r\n\t\tline = rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)[0]\r\n\t\tp0 = line.GetEndPoint(0) + XYZ.BasisZ*10/304.8\r\n\t\textDst = p0.DistanceTo(extFace.Project(p0).XYZPoint)\r\n\t\tintDst = p0.DistanceTo(intFace.Project(p0).XYZPoint)\r\n\t\tif extDst > intDst:\r\n\t\t\trebars.append(rebar)\r\n\treturn rebars\r\n\t\r\ndef RebarIsOnFloor(rebar, wp):\r\n\tline = rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)[0]\r\n\tp0 = line.GetEndPoint(0)\r\n\tfloor = wp.GetFloor(p0)\r\n\tif floor:\r\n\t\tmainFace = [face for face in list(floor.Geometry[optForSlabs])[0].Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(XYZ.BasisZ)][0]\r\n\t\tprojection = mainFace.Project(p0)\r\n\telse:\r\n\t\tbottomFaces = [face for face in wp.Solid.Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(-XYZ.BasisZ)]\r\n\t\tfor bf in bottomFaces:\r\n\t\t\tprojection = bf.Project(p0)\r\n\t\t\tif projection:\r\n\t\t\t\tbreak\t\t\t\t\r\n\tdst = round(p0.DistanceTo(projection.XYZPoint)*304.8)\r\n\tif dst == 0:\r\n\t\treturn True, dst\r\n\telse:\r\n\t\treturn False, dst\r\n\t\r\ndef GetOriginsForSRebars(AR, allRebarsV, wp):\r\n\trebarsH = [doc.GetElement(id) for id in AR.GetRebarInSystemIds()]\r\n\tZs = []\r\n\tfor rebar in rebarsH:\r\n\t\tlocZ = GetRebarLocAndDir(rebar)[0].Z\r\n\t\tZs += [rebar.GetBarPositionTransform(i).Origin.Z + locZ for i in range(rebar.NumberOfBarPositions)]\r\n\tZs = sorted(set(Zs))\r\n\tZs1 = []\r\n\tZs2 = []\r\n\tfor i, z in enumerate(Zs):\r\n\t\tif i%2 == 0:\r\n\t\t\tZs1.append(z)\r\n\t\telse:\r\n\t\t\tZs2.append(z)\r\n\trebarsV = [rebar for rebar in GetRebarsForIntSide(allRebarsV, wp) if rebar.LayoutRule != RebarLayoutRule.Single]\r\n\torigins = []\r\n\tfor rebar in rebarsV:\r\n\t\tline = rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)[0]\r\n\t\tx = line.Origin.X\r\n\t\ty = line.Origin.Y\r\n\t\tif RebarIsOnFloor(rebar, wp)[0]:\r\n\t\t\tpoints = [XYZ(x,y,z) for z in Zs1]\r\n\t\t\tpart = '06_Шпильки_Нечетный ряд'\r\n\t\telse:\r\n\t\t\tpoints = [XYZ(x,y,z) for z in Zs2]\r\n\t\t\tpart = '06_Шпильки_Четный ряд'\r\n\t\tstepV = round(rebar.Parameter[BuiltInParameter.REBAR_ELEM_BAR_SPACING].AsDouble()*304.8)\r\n\t\tK = float(IN[2])/stepV\r\n\t\tn = int(math.ceil(float(rebar.Parameter[BuiltInParameter.REBAR_ELEM_QUANTITY_OF_BARS].AsInteger())/K))\r\n\t\tif n > 1:\r\n\t\t\tstep = IN[2]/304.8\r\n\t\telse:\r\n\t\t\tstep = None\r\n\t\torigins.append([points, n, step, part])\r\n\treturn origins\r\n\r\ndef GetRebarLocAndDir(rebar):\r\n\tif rebar.GetType() == RebarInSystem:\r\n\t\tcenterLine = rebar.GetCenterlineCurves(False, True, True)[0]\r\n\t\tdir2 = VecABS(rebar.Normal.Normalize())\r\n\telse:\r\n\t\tcenterLine = rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)[0]\r\n\t\tdir2 = VecABS(rebar.GetShapeDrivenAccessor().Normal.Normalize())\r\n\tloc = centerLine.GetEndPoint(0)\r\n\tdir = VecABS(centerLine.Direction)\r\n\treturn loc, dir, dir2\r\n\r\ndef EditConstrains(rebar):\r\n\tconMan = rebar.GetRebarConstraintsManager()\r\n\thandle = [con for con in conMan.GetAllHandles() if con.GetHandleName() == 'Начало стержня'][0]\r\n\tconsts = conMan.GetConstraintCandidatesForHandle(handle)\r\n\tconst = [const for const in consts if const.GetRebarConstraintTargetHostFaceType() == RebarConstraintTargetHostFaceType.Side0 and const.IsToCover()][0]\r\n\tconst.SetDistanceToTargetCover(0)\r\n\tconMan.SetPreferredConstraintForHandle(handle, const)\r\n\thandle = [con for con in conMan.GetAllHandles() if con.GetHandleName() == 'Конец стержня'][0]\r\n\tconsts = conMan.GetConstraintCandidatesForHandle(handle)\r\n\tconst = [const for const in consts if const.GetRebarConstraintTargetHostFaceType() == RebarConstraintTargetHostFaceType.Side1 and const.IsToCover()][0]\r\n\tconst.SetDistanceToTargetCover(0)\r\n\tconMan.SetPreferredConstraintForHandle(handle, const)\r\n\tdoc.Regenerate()\r\n\r\ndef CreateSRebars(AR, rebarsV, wp, wr):\r\n\t\r\n\tshape = [shape for shape in FilteredElementCollector(doc).OfClass(RebarShape).ToElements() if shape.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString() == IN[1]][0]\r\n\trebarType = [rt for rt in FilteredElementCollector(doc).OfClass(RebarBarType).ToElements() if rt.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString().find('A240') != -1 and round(rt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()*304.8) == round(wr.DStud*304.8) and rt.get_Parameter(System.Guid('844a01e2-19fc-4dc5-baa0-a4bda30ef1f6')).AsInteger() == 0][0]\r\n\thost = doc.GetElement(ElementId(wp.Id))\r\n\torigins = GetOriginsForSRebars(AR, rebarsV, wp)\r\n\trebars = []\r\n\tfor pSet in origins:\r\n\t\tfor p in pSet[0]:\r\n\t\t\trsp = RebarSParameters(wp, wr, p)\r\n\t\t\tplacePoint = rsp.Origin + wp.Dir*((wr.DY1)/2+wr.DStud)\r\n\t\t\trebar = Rebar.CreateFromRebarShape(doc, shape, rebarType, host, placePoint, rsp.XVec, rsp.YVec)\r\n\t\t\tdoc.Regenerate()\r\n\t\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_LAYOUT_RULE].Set(3)\r\n\t\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_QUANTITY_OF_BARS].Set(pSet[1])\r\n\t\t\tif pSet[1] > 1:\r\n\t\t\t\trebar.Parameter[BuiltInParameter.REBAR_ELEM_BAR_SPACING].Set(pSet[2])\r\n\t\t\trebar.Parameter[BuiltInParameter.NUMBER_PARTITION_PARAM].Set(pSet[3])\r\n\t\t\t\t\r\n\t\t\tEditConstrains(rebar)\r\n\t\t\trebar.SetSolidInView(doc.ActiveView, True)\r\n\t\t\trebars.append(rebar)\r\n\r\n\t\tdoc.Regenerate()\r\n\treturn rebars, origins\r\n\t\r\nclass RebarSParameters:\r\n\tdef __init__(self, wp, wr, startPoint):\r\n\t\tself.Angle = math.asin((wr.DStudS + wr.DStud)/(wp.T-wr.CovExt-wr.CovInt-wr.DX))\r\n\t\tself.XVec = wp.Orient - XYZ.BasisZ * math.tan(self.Angle)\r\n\t\tself.YVec = XYZ.BasisZ + wp.Orient * math.tan(self.Angle)\r\n\t\tself.Origin = startPoint - self.XVec*(wr.DStudS/2 + wr.DStud*1.5) + self.YVec*wr.DStudS/2 - wp.Orient*(wr.DY1/2+wr.DX/2)\r\n\t\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nnewRebars = []\r\n\r\nfor i, ARset in enumerate(ARs):\r\n\trebarsV = rebars[i]\r\n\twp = WPars[i]\r\n\twr = WRebs[i]\r\n\tnewRebars.append(CreateSRebars(ARset[0], rebarsV, wp, wr))\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = newRebars",
      "VariableInputPorts": true,
