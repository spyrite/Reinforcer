      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nimport math\r\nimport System\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ndata = IN[0]\r\nWPars = data[1]\r\nWRebs = data[2]\r\n\r\noptForSlabs = Options()\r\n\r\ndef VecABS(vec):\r\n\tx = abs(vec.X)\r\n\ty = abs(vec.Y)\r\n\tz = abs(vec.Z)\r\n\treturn XYZ(x,y,z)\r\n\r\ndef GetSlabThickness(lvl, catchPoint):\r\n\tfilter = ElementLevelFilter(lvl.Id)\r\n\tslabs = FilteredElementCollector(doc).OfClass(Floor).WherePasses(filter).ToElements()\r\n\tt = -15/304.8\r\n\tfor slab in slabs:\r\n\t\tmainFace = [face for face in list(slab.Geometry[optForSlabs])[0].Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(XYZ.BasisZ)][0]\r\n\t\tif mainFace.Project(catchPoint) is not None:\r\n\t\t\tt = slab.Parameter[BuiltInParameter.FLOOR_ATTR_THICKNESS_PARAM].AsDouble()\r\n\t\t\tbreak\r\n\treturn t\r\n\t\r\nARsInt = []\r\ntr = Transform.Identity\r\ntest = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor i, wp in enumerate(WPars):\r\n\twall = doc.GetElement(ElementId(wp.Id))\r\n\tARs = [doc.GetElement(id) for id in wall.GetDependentElements(ElementClassFilter(AreaReinforcement))]\r\n\tARsInt.append([])\r\n\tif ARs:\r\n\t\twr = WRebs[i]\r\n\t\tlvlBot = doc.GetElement(wp.BottomLvlId)\r\n\t\tlvlTop = doc.GetElement(wp.TopLvlId)\r\n\t\tbotSlabT = GetSlabThickness(lvlBot, wp.GetMidPointOfCenterLine())\r\n\t\toffsetMin =  IN[1]/304.8\r\n\t\tN = int(math.floor((lvlTop.Elevation-(lvlBot.Elevation+botSlabT)-2*offsetMin)/wr.StepX))+1\r\n\t\toffsetStart = (lvlTop.Elevation - (lvlBot.Elevation+botSlabT) - wr.StepX*(N-1))/2\r\n\t\r\n\t\tif VecABS(wp.Dir).IsAlmostEqualTo(XYZ.BasisY) and wp.JoinedWallsAtStart and wp.JoinedWallsAtEnd:\r\n\t\t\tadditOffset = wr.DX\r\n\t\telse:\r\n\t\t\tadditOffset = 0\r\n\t\tbaseOffset = offsetStart - wr.DX/2 - additOffset\r\n\t\ttopOffset = (wp.H - abs(baseOffset) - math.floor((wp.H - (abs(baseOffset) + wr.DX/2)) / wr.StepX) * wr.StepX - wr.DX)\r\n\t\t\r\n\t\trebarType = [rt for rt in FilteredElementCollector(doc).OfClass(RebarBarType).ToElements() if rt.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString().find('A500') != -1 and round(rt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()*304.8) == round(wr.DX*304.8) and rt.get_Parameter(System.Guid('844a01e2-19fc-4dc5-baa0-a4bda30ef1f6')).AsInteger() == 0][0]\t\t\r\n\t\t\r\n\t\tfor AR in ARs:\r\n\t\t\trebars = [doc.GetElement(id) for id in AR.GetRebarInSystemIds()]\r\n\t\t\t[rebar.SetSolidInView(doc.ActiveView, True) for rebar in rebars]\r\n\t\t\t\r\n\t\t\tarCurves = [doc.GetElement(id) for id in AR.GetBoundaryCurveIds()]\r\n\t\t\tZs = [arCurve.Curve.ComputeDerivatives(0.5,True).Origin.Z for arCurve in arCurves]\r\n\t\t\t\r\n\t\t\tfor i, arCurve in enumerate(arCurves):\r\n\t\t\t\t\r\n\t\t\t\toldCur = arCurve.Curve\r\n\t\t\t\tdir = VecABS(oldCur.Direction.Normalize())\r\n\t\t\t\tif dir.IsAlmostEqualTo(VecABS(wp.Dir)):\r\n\t\t\t\t\tz = oldCur.Origin.Z\r\n\t\t\t\t\tif z == min(Zs):\r\n\t\t\t\t\t\tdelta = (baseOffset + wp.Z) - z\r\n\t\t\t\t\telif z == max(Zs):\r\n\t\t\t\t\t\tdelta = (wp.Z + wp.H - topOffset) - z\r\n\t\t\t\t\t\r\n\t\t\t\t\ttr.Origin = XYZ(0,0, delta)\t\t\t\t\r\n\t\t\t\t\tnewCur = oldCur.CreateTransformed(tr)\r\n\t\t\t\t\t\r\n\t\t\t\t\tif i == 0:\r\n\t\t\t\t\t\tprev = len(arCurves)-1\r\n\t\t\t\t\telse:\r\n\t\t\t\t\t\tprev = i-1\r\n\t\t\t\t\tif i == len(arCurves)-1:\r\n\t\t\t\t\t\tnext = 0\r\n\t\t\t\t\telse:\r\n\t\t\t\t\t\tnext = i+1\r\n\t\t\t\t\t\r\n\t\t\t\t\toldPrevCur = arCurves[prev].Curve\r\n\t\t\t\t\tnewPrevCur = Line.CreateBound(oldPrevCur.GetEndPoint(0), oldPrevCur.GetEndPoint(1) - oldPrevCur.Direction*delta)\r\n\t\t\t\t\toldNextCur = arCurves[next].Curve\r\n\t\t\t\t\tnewNextCur = Line.CreateBound(oldNextCur.GetEndPoint(0) + oldNextCur.Direction*delta, oldNextCur.GetEndPoint(1))\r\n\t\t\t\t\t\r\n\t\t\t\t\tarCurves[prev].SetGeometryCurve(newPrevCur, False)\r\n\t\t\t\t\tarCurves[next].SetGeometryCurve(newNextCur, False)\r\n#\t\t\t\t\tarCurve.SetGeometryCurve(newCur, True)\r\n\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n#\t\t\t\t\ttest.append(arCurve.GetAdjoinedCurveElements(0))\r\n\t\t\r\n\t\t\tif AR.Parameter[BuiltInParameter.REBAR_SYSTEM_ACTIVE_BOTTOM_DIR_1_GENERIC].AsInteger() == 1:\r\n\t\t\t\tAR.Parameter[BuiltInParameter.REBAR_SYSTEM_BAR_TYPE_BOTTOM_DIR_1_GENERIC].Set(rebarType.Id)\r\n\t\t\t\tAR.Parameter[BuiltInParameter.REBAR_SYSTEM_SPACING_BOTTOM_DIR_1_GENERIC].Set(wr.StepX)\r\n\t\t\t\tAR.Parameter[BuiltInParameter.NUMBER_PARTITION_PARAM].Set('01_Расположение_Горизонтальная_Внутренняя')\r\n\t\t\t\tARsInt[-1].append(AR)\r\n\t\t\t\r\n\t\t\tif AR.Parameter[BuiltInParameter.REBAR_SYSTEM_ACTIVE_TOP_DIR_1_GENERIC].AsInteger() == 1:\r\n\t\t\t\tAR.Parameter[BuiltInParameter.REBAR_SYSTEM_BAR_TYPE_TOP_DIR_1_GENERIC].Set(rebarType.Id)\r\n\t\t\t\tAR.Parameter[BuiltInParameter.REBAR_SYSTEM_SPACING_TOP_DIR_1_GENERIC].Set(wr.StepX)\r\n\t\t\t\tAR.Parameter[BuiltInParameter.NUMBER_PARTITION_PARAM].Set('01_Расположение_Горизонтальная_Наружняя')\r\n\t\t\t\t\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\ndata.append(ARsInt)\r\n\r\nOUT = data\r\n#OUT = test",
