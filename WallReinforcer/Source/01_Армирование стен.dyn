      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Загрузить стандартную библиотеку Python и библиотеку DesignScript\r\nimport sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# Введенные в этом узле данные сохраняется в виде списка в переменных IN.\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nrebars = UnwrapElement(IN[0][0])\r\nWPars = IN[0][1]\r\nWRebs = IN[0][2]\r\nshortRebars = IN[0][3]\r\n\r\ndef GetSide(rebar, wp):\r\n\textFace = [face for face in wp.Solid.Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(wp.Orient)][0]\r\n\tintFace = [face for face in wp.Solid.Faces if face.FaceNormal.Normalize().IsAlmostEqualTo(-wp.Orient)][0]\r\n\tline = rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)[0]\r\n\tp0 = line.GetEndPoint(0) + XYZ.BasisZ*300/304.8\r\n\textDst = p0.DistanceTo(extFace.Project(p0).XYZPoint)\r\n\tintDst = p0.DistanceTo(intFace.Project(p0).XYZPoint)\r\n\tif extDst < intDst:\r\n\t\treturn RebarConstraintTargetHostFaceType.Side0, '01_Расположение_Вертикальная_Наружняя'\r\n\telse:\r\n\t\treturn RebarConstraintTargetHostFaceType.Side1, '01_Расположение_Вертикальная_Внутренняя'\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\ndoc.Regenerate()\r\n\r\ntest = []\r\n\r\nfor i, wp in enumerate(WPars):\r\n\twall = doc.GetElement(ElementId(wp.Id))\r\n\twr = WRebs[i]\r\n\tdst1 = float(IN[1])/304.8 - wr.DX/2\r\n\tdst2 = float(IN[2])/304.8\r\n\tcovTypes1 = [ct1 for ct1 in FilteredElementCollector(doc).OfClass(RebarCoverType).ToElements() if round(ct1.CoverDistance*304.8) == round(dst1*304.8)]\r\n\tif covTypes1:\r\n\t\tcovType1 = covTypes1[0]\r\n\telse:\r\n\t\tcovType1 = RebarCoverType.Create(doc, str(round(dst1*304.8)), dst1)\r\n\t\t\r\n\tcovTypes2 = [ct2 for ct2 in FilteredElementCollector(doc).OfClass(RebarCoverType).ToElements() if round(ct2.CoverDistance*304.8) == round(dst2*304.8)]\r\n\tif covTypes2:\r\n\t\tcovType2 = covTypes2[0]\r\n\telse:\r\n\t\tcovType2 = RebarCoverType.Create(doc, str(round(dst2*304.8)), dst2)\r\n\t\t\r\n\tif wr.CovExt != dst1:\r\n\t\twr.CovExt = dst1\r\n\t\twall.Parameter[BuiltInParameter.CLEAR_COVER_EXTERIOR].Set(covType1.Id)\r\n\tif wr.CovInt != dst1:\r\n\t\twr.CovInt = dst1\r\n\t\twall.Parameter[BuiltInParameter.CLEAR_COVER_INTERIOR].Set(covType1.Id)\r\n\tif wr.CovOth != dst2:\r\n\t\twr.CovOth = dst2\r\n\t\twall.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].Set(covType2.Id)\r\n\r\n\r\nfor i, rebarSet in enumerate(rebars):\r\n\tDH = WRebs[i].DX\r\n\twp = WPars[i]\r\n\tfor rebar in rebarSet:\r\n\t\t\r\n#\t\tDV = doc.GetElement(rebar.GetTypeId()).Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()\r\n#\t\tcovDst = doc.GetElement(doc.GetElement(rebar.GetHostId()).Parameter[BuiltInParameter.CLEAR_COVER_EXTERIOR].AsElementId()).Parameter[BuiltInParameter.COVER_TYPE_LENGTH].AsDouble()\r\n\t\tconMan = rebar.GetRebarConstraintsManager()\r\n\t\thandles = [con for con in conMan.GetAllHandles() if con.GetHandleName() == 'Сегмент стержня 1']\r\n\t\t\r\n\t\tfor hand in handles:\r\n#\t\t\tconst = conMan.GetCurrentConstraintOnHandle(hand)\r\n#\t\t\tif const:\r\n#\t\t\t\tif const.IsToHostFaceOrCover() and not const.IsToCover():\r\n#\t\t\t\t\tconst.SetDistanceToTargetHostFace(-(covDst+DH+DV/2))\r\n#\t\t\t\telif const.IsToCover():\r\n#\t\t\t\t\tconst.SetDistanceToTargetCover(-DH)\r\n#\t\t\t\telse:\r\n#\t\t\t\t\tcontinue\r\n#\t\t\telse:\r\n\t\t\tconsts = conMan.GetConstraintCandidatesForHandle(hand)\r\n\t\t\tconst = [const for const in consts if const.GetRebarConstraintTargetHostFaceType() == GetSide(rebar, wp)[0] and const.IsToCover()][0]\r\n\t\t\tconst.SetDistanceToTargetCover(-DH)\r\n\t\t\t\t\r\n\t\t\tconMan.SetPreferredConstraintForHandle(hand, const)\r\n\t\t\t\r\n\t\tpart = GetSide(rebar, wp)[1]\r\n\t\trebar.Parameter[BuiltInParameter.NUMBER_PARTITION_PARAM].Set(part)\r\n\t\t\r\n\r\n\t\r\ndoc.Regenerate()\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# Назначьте вывод переменной OUT.\r\nOUT = rebars, WPars, WRebs, shortRebars",
