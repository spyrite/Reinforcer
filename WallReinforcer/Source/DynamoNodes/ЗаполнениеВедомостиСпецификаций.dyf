    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nlineStyles = Category.GetCategory(doc, BuiltInCategory.OST_Lines).SubCategories\r\n\r\ntos = [vs for vs in FilteredElementCollector(doc).OfClass(ViewSchedule).ToElements() if not vs.IsTemplate and vs.Name.find(IN[3]) == 0][0]\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nif tos.GetParameters(IN[1]):\r\n\ttos.GetParameters(IN[1])[0].Set(IN[0])\r\n\r\ntosData = tos.GetTableData().GetSectionData(SectionType.Header)\r\n\r\noverrides = TableCellStyleOverrideOptions()\r\noverrides.BorderLeftLineStyle = True\r\noverrides.BorderRightLineStyle = True\r\noverrides.HorizontalAlignment = True\r\noverrides.VerticalAlignment = True\r\noverrides.Font = True\r\noverrides.FontSize = True\r\noverrides.Bold = True\r\noverrides.Italics = True\r\noverrides.Underline = True\r\n\r\ntosStyle = TableCellStyle()\r\ntosStyle.SetCellStyleOverrideOptions(overrides)\r\ntosStyle.FontVerticalAlignment = VerticalAlignmentStyle.Middle\r\ntosStyle.BorderLeftLineStyle = [ls.Id for ls in lineStyles if ls.Name == IN[4]][0]\r\ntosStyle.BorderRightLineStyle = [ls.Id for ls in lineStyles if ls.Name == IN[4]][0]\r\ntosStyle.FontName = 'Mipgost'\r\ntosStyle.TextSize = 9.448223734\r\ntosStyle.IsFontBold = True\r\ntosStyle.IsFontItalic = False\r\ntosStyle.IsFontUnderline = False\r\n\r\n \r\nfor i, data in enumerate(IN[2]):\r\n\ttosData.InsertRow(2+i)\r\n\ttosData.SetRowHeight(2+i, 0.02625)\r\n\ttosStyle.FontHorizontalAlignment = HorizontalAlignmentStyle.Center\r\n\ttosData.SetCellStyle(2+i, 0, tosStyle)\r\n\ttosStyle.FontHorizontalAlignment = HorizontalAlignmentStyle.Left\r\n\ttosData.SetCellStyle(2+i, 1, tosStyle)\r\n\ttosStyle.FontHorizontalAlignment = HorizontalAlignmentStyle.Center\r\n\ttosData.SetCellStyle(2+i, 2, tosStyle)\r\n\ttosData.SetCellText(2+i, 0, str(data[0]))\r\n\ttosData.SetCellText(2+i, 1, data[1])\r\n\t\t\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = ''\r\n",
