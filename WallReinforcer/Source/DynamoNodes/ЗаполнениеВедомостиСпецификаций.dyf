    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Загрузить стандартную библиотеку Python и библиотеку DesignScript\r\nimport sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ndef ByNumber(sheet):\r\n\tif IN[1] or not sheet.GetParameters(IN[3]):\r\n\t\treturn float(sheet.SheetNumber.split('-')[-1])\r\n\telse:\r\n\t\treturn float(sheet.GetParameters(IN[3])[0].AsString())\r\n\r\nsheets = []\r\nfor sheet in FilteredElementCollector(doc).OfClass(ViewSheet).ToElements():\r\n\tif sheet.GetParameters(IN[2]):\r\n\t\tsheetSet = sheet.GetParameters(IN[2])[0].AsString()\r\n\t\tif sheetSet == IN[0]:\r\n\t\t\tsheets.append(sheet)\r\n\t\t\t\r\nsheets = sorted(sheets, key=ByNumber)\r\n\r\ndata = []\r\nfor sheet in sheets:\r\n\tssis = [doc.GetElement(id) for id in sheet.GetDependentElements(ElementClassFilter(ScheduleSheetInstance))]\r\n\tif ssis:\r\n\t\tfor ssi in ssis:\r\n\t\t\tif not ssi.IsTitleblockRevisionSchedule:\r\n\t\t\t\tsheetNumber = ByNumber(sheet)\r\n\t\t\t\tschedule = doc.GetElement(ssi.ScheduleId)\r\n\t\t\t\tif schedule.Definition.ShowTitle:\r\n\t\t\t\t\tname = schedule.GetCellText(SectionType.Header, 0, 0)\r\n\t\t\t\telif schedule.Definition.ShowHeaders:\r\n\t\t\t\t\tname = schedule.GetCellText(SectionType.Body, 0, 0)\r\n\t\t\t\telse:\r\n\t\t\t\t\tname = None\r\n\t\t\t\tif name and name.find('Спецификация') == 0:\r\n\t\t\t\t\tdata.append([int(sheetNumber), name])\t\r\n\t\r\nOUT = data",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "5c1d98a919a54677bf14e47743743b3a",
      "Inputs": [
        {
          "Id": "5dc83b6355a542d4a6602b4ac5612ad1",
          "Name": "IN[0]",
