    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef CreateCropCurveLoop(lines, vp):\r\n\tcl = CurveLoop.Create(lines)\r\n\tcl = CurveLoop.CreateViaOffset(cl, IN[2][0]/304.8, vp.Dirs[2])\r\n\ttransform = Transform.CreateTranslation(vp.Dirs[2]*(vp.CropBox.H))\r\n\tcl = CurveLoop.CreateViaTransform(cl, transform)\r\n\treturn cl\r\n\t\r\ndef CreateConcreteViewSolid(vp):\r\n\tfilter = VisibleInViewFilter(doc, vp.View.Id)\r\n\tconcrete = FilteredElementCollector(doc, List[ElementId](IN[3])).WherePasses(filter).ToElements()\r\n\tviewSolid = vp.CropBox.CreateViewSolid(vp.CropBox.H)\r\n\tsolids = []\r\n\tfor elem in concrete:\r\n\t\telemSolids = [geom for geom in list(elem.Geometry[opt]) if geom.GetType() == Solid and geom.Volume > 0]\r\n\t\tfor elemSolid in elemSolids:\r\n\t\t\tsolids.append(BooleanOperationsUtils.ExecuteBooleanOperation(viewSolid, elemSolid, BooleanOperationsType.Intersect))\r\n\tfor solid in solids[1:]:\r\n\t\tBooleanOperationsUtils.ExecuteBooleanOperationModifyingOriginalSolid(solids[0], solid, BooleanOperationsType.Union)\r\n\treturn solids[0]\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nVPs = IN[0]\r\n\r\ncropLineAnnotationType = [sym for sym in FilteredElementCollector(doc).OfClass(FamilySymbol).ToElements() if sym.FamilyName == IN[1][0] and sym.Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsValueString() == IN[1][1]][0]\r\n\r\nopt = Options()\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor vp in VPs:\r\n\tlines = [vp.CropBox.LeftLine, vp.CropBox.TopLine, vp.CropBox.RightLine.CreateReversed(), vp.CropBox.BotLine.CreateReversed()]\r\n\tcl = CreateCropCurveLoop(lines, vp)\r\n\tsolid = CreateConcreteViewSolid(vp)\r\n\ttransform = Transform.CreateTranslation(-vp.Dirs[2]*vp.CropBox.H/2)\r\n\tfor line in list(cl):\r\n\t\tline = line.CreateTransformed(transform)\r\n\t\tspotlines = list(solid.IntersectWithCurve(line, None))\r\n\t\tfor line in spotlines:\r\n\t\t\tline = line.CreateTransformed(transform.Inverse)\r\n\t\t\tann = doc.Create.NewFamilyInstance.Overloads[Line, FamilySymbol, View](line, cropLineAnnotationType, vp.View)\r\n\t\t\tann.GetParameters('Глубина')[0].Set(IN[2][1]/304.8)\r\n\t\t\tann.GetParameters('Выступы области')[0].Set(IN[2][2]/304.8)\r\n\t\t\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\t\t\t\t\r\nOUT = ''",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "ddee81d2906a446ab47f37f886c6ebe9",
