  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nimport math\r\nimport System\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nbasePoint = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_ProjectBasePoint).FirstElement()\r\n\r\nRbtValues = {'B15':0.75, 'B20':0.9, 'B25':1.05, 'B30':1.15, 'B35':1.3, 'B40':1.4, 'B45':1.5}\r\n\r\ndef ComputeBaseAnchorLength(d, bclass):\r\n\tRbt = RbtValues[bclass]\r\n\tRs = 435\r\n\tn2 = 1\r\n\tif round(d*304.8) > 32:\r\n\t\tn2 = 0.9\r\n\tRbond = Rbt*2.5*n2\r\n\tAs = (math.pi*d**2)/4\r\n\tus = math.pi*d\r\n\tl0an = (Rs*As)/(Rbond*us)\r\n\treturn l0an\r\n\t\r\ndef ComputeOverlapLength(d, bclass):\r\n\tl0an = ComputeBaseAnchorLength(d, bclass)\r\n\tlan = 0.9*l0an\r\n\treturn math.ceil(max([0.3*l0an, 15*d, 200/304.8, lan])*304.8/10)*10/304.8\r\n\r\ndef VecABS(vec):\r\n\tx = abs(vec.X)\r\n\ty = abs(vec.Y)\r\n\tz = abs(vec.Z)\r\n\treturn XYZ(x,y,z)\r\n\r\ndef SortGeomByZ(geom):\r\n\treturn geom.Origin.Z\r\n\t\r\ndef ComputeBendDiameter(d, rClass):\r\n\tif rClass == 'А240':\r\n\t\tif round(d*304.8) < 20:\r\n\t\t\tdb = 2.5*d\r\n\t\telse:\r\n\t\t\tdb = 4*d\r\n\telse:\r\n\t\tif round(d*304.8) < 20:\r\n\t\t\tdb = 5*d\r\n\t\telse:\r\n\t\t\tdb = 8*d\r\n\treturn db\r\n\t\r\ndef SetRebarBarTypeParameters(rt, d1, d2, rClass, im):\r\n\trt.GetParameters(IN[5][4])[0].Set(im)\r\n\trt.GetParameters(IN[5][5])[0].Set(int(rClass.split('А')[-1].split('С')[0]))\r\n\trt.GetParameters(IN[5][6])[0].Set('ГОСТ 34028-2016')\r\n\trt.GetParameters(IN[5][7])[0].Set(rClass)\r\n\trt.GetParameters(IN[5][8])[0].Set(0)\r\n\tif rClass == 'А240':\r\n\t\trt.Parameter[BuiltInParameter.REBAR_BAR_DEFORMATION_TYPE].Set(1)\r\n\telse:\r\n\t\trt.Parameter[BuiltInParameter.REBAR_BAR_DEFORMATION_TYPE].Set(0)\r\n\trt.Parameter[BuiltInParameter.REBAR_MODEL_BAR_DIAMETER].Set(d1)\r\n\trt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].Set(d1)\r\n\tif d2 > 0:\r\n\t\tdb = d2\r\n\telse:\r\n\t\tdb = ComputeBendDiameter(d, rClass)\r\n\trt.Parameter[BuiltInParameter.REBAR_STANDARD_BEND_DIAMETER].Set(db)\r\n\trt.Parameter[BuiltInParameter.REBAR_BAR_STIRRUP_BEND_DIAMETER].Set(db)\r\n\trt.Parameter[BuiltInParameter.REBAR_STANDARD_HOOK_BEND_DIAMETER].Set(db)\r\n\tmaterials = [mat for mat in FilteredElementCollector(doc).OfClass(Material).ToElements() if mat.Name.find('Арматура D') == 0 and int(mat.Name.split('D')[-1]) == int(round(d1*304.8))]\r\n\tif materials:\r\n\t\trt.Parameter[BuiltInParameter.MATERIAL_ID_PARAM].Set(materials[0].Id)\r\n\tsubCats = [sc for sc in Category.GetCategory(doc, BuiltInCategory.OST_Rebar).SubCategories if sc.Name == 'D'+str(int(round(d1*304.8)))]\r\n\tif subCats:\r\n\t\trt.Parameter[BuiltInParameter.REBAR_BAR_STYLE].Set(subCats[0].Id)\r\n\r\nview = UnwrapElement(IN[0])\r\ncolumns = UnwrapElement(IN[1])\r\ncolumnIds = UnwrapElement(IN[2])\r\nwallIds = UnwrapElement(IN[3])\r\nslabIds = UnwrapElement(IN[4])\r\nbeamIds = UnwrapElement(IN[6])\r\n\r\nopt = Options()\r\nopt.ComputeReferences = True\r\n\t\t\r\nclass SlabParameters:\r\n\tdef __init__(self, slab):\r\n\t\tself.Elem = slab\r\n\t\tself.Id = slab.Id.IntegerValue\r\n\t\tif slab.GetType() == Floor:\r\n\t\t\tself.T = slab.Parameter[BuiltInParameter.FLOOR_ATTR_THICKNESS_PARAM].AsDouble()\r\n\t\t\tself.SpanAngle = slab.SpanDirectionAngle\r\n\t\telse:\r\n\t\t\tself.T = slab.Symbol.Parameter[BuiltInParameter.STRUCTURAL_FOUNDATION_THICKNESS].AsDouble()\r\n\t\t\tself.SpanAngle = slab.GetTransform().BasisX.Normalize().AngleOnPlaneTo(XYZ.BasisX, XYZ.BasisZ)\r\n\t\t\t\r\n\t\tself.LvlId = slab.LevelId\r\n\t\tmaxVol = max([geom.Volume for geom in list(slab.Geometry[opt]) if geom.GetType() == Solid])\r\n\t\tself.Solid = [geom for geom in list(slab.Geometry[opt]) if geom.GetType() == Solid and geom.Volume == maxVol][0]\r\n\t\tself.Supports = None\r\n\t\tself.BClass = slab.GetParameters('1Пп_Класс бетона')[0].AsValueString()\r\n\t\tif self.BClass.find('B') == -1:\r\n\t\t\tself.BClass = 'B' + self.BClass\r\n\t\tself.TopCovDst = 0\r\n\t\tself.BotCovDst = 0\r\n\t\tself.OthCovDst = 0\r\n\t\tif slab.GetType() == FamilyInstance or slab.Parameter[BuiltInParameter.FLOOR_PARAM_IS_STRUCTURAL].AsInteger() == 1:\r\n\t\t\tif doc.GetElement(slab.Parameter[BuiltInParameter.CLEAR_COVER_TOP].AsElementId()):\r\n\t\t\t\tself.TopCovDst = doc.GetElement(slab.Parameter[BuiltInParameter.CLEAR_COVER_TOP].AsElementId()).CoverDistance\r\n\t\t\tif doc.GetElement(slab.Parameter[BuiltInParameter.CLEAR_COVER_BOTTOM].AsElementId()):\r\n\t\t\t\tself.BotCovDst = doc.GetElement(slab.Parameter[BuiltInParameter.CLEAR_COVER_BOTTOM].AsElementId()).CoverDistance\r\n\t\t\tif doc.GetElement(slab.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].AsElementId()):\r\n\t\t\t\tself.OthCovDst = doc.GetElement(slab.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].AsElementId()).CoverDistance\r\n\t\t\t\t\r\n\t\tif round(self.SpanAngle*100)/100 == 0 or round(self.SpanAngle*100)/100 == round(3.14*100)/100:\r\n\t\t\tself.DMainTOP = slab.GetParameters('1Пп_Арм_X_Верх_Диаметр')[0].AsDouble()\r\n\t\t\tself.DMainBOT = slab.GetParameters('1Пп_Арм_X_Низ_Диаметр')[0].AsDouble()\r\n\t\t\tself.DSecTOP = slab.GetParameters('1Пп_Арм_Y_Верх_Диаметр')[0].AsDouble()\r\n\t\t\tself.DSecBOT = slab.GetParameters('1Пп_Арм_Y_Низ_Диаметр')[0].AsDouble()\r\n\t\telse:\r\n\t\t\tself.DMainTOP = slab.GetParameters('1Пп_Арм_Y_Верх_Диаметр')[0].AsDouble()\r\n\t\t\tself.DMainBOT = slab.GetParameters('1Пп_Арм_Y_Низ_Диаметр')[0].AsDouble()\r\n\t\t\tself.DSecTOP = slab.GetParameters('1Пп_Арм_X_Верх_Диаметр')[0].AsDouble()\r\n\t\t\tself.DSecBOT = slab.GetParameters('1Пп_Арм_X_Низ_Диаметр')[0].AsDouble()\r\n\t\tself.Phase = slab.Parameter[BuiltInParameter.PHASE_CREATED].AsElementId()\r\n\t\tself.Workset = slab.Parameter[BuiltInParameter.ELEM_PARTITION_PARAM].AsInteger()\r\n\t\tif slab.GetParameters(IN[5][9]):\r\n\t\t\tself.Section = slab.GetParameters(IN[5][9])[0].AsString()\r\n\t\telse:\r\n\t\t\tself.Section = None\r\n\t\t\r\n\t\t\r\n\tdef GetSlabBottomSupports(self, wp):\r\n\t\tcutLine = Line.CreateBound(wp.Geom.BotCenterLine.GetEndPoint(0) - XYZ.BasisZ*10/304.8, wp.Geom.BotCenterLine.GetEndPoint(1) - XYZ.BasisZ*10/304.8)\r\n\t\tsolid = self.Solid\r\n\t\tspotLines = list(solid.IntersectWithCurve(cutLine, None))\r\n\t\tslabSupports = []\r\n\t\tfor spotLine in spotLines:\r\n\t\t\tp0 = spotLine.GetEndPoint(0) + XYZ.BasisZ*10/304.8\r\n\t\t\tp1 = spotLine.GetEndPoint(1) + XYZ.BasisZ*10/304.8\r\n\t\t\tslabSupports.append(Line.CreateBound(p0, p1))\r\n\t\treturn slabSupports\r\n\t\t\r\n\tdef GetSlabSupports(self, wp, delta):\r\n\t\tcutLine = Line.CreateBound(wp.Geom.TopCenterLine.GetEndPoint(0) + XYZ.BasisZ*(10/304.8+delta), wp.Geom.TopCenterLine.GetEndPoint(1) + XYZ.BasisZ*(10/304.8+delta))\r\n\t\tsolid = self.Solid\r\n\t\tspotLines = list(solid.IntersectWithCurve(cutLine, None))\r\n\t\tslabSupports = []\r\n\t\tfor spotLine in spotLines:\r\n\t\t\tp0 = spotLine.GetEndPoint(0) - XYZ.BasisZ*10/304.8\r\n\t\t\tp1 = spotLine.GetEndPoint(1) - XYZ.BasisZ*10/304.8\r\n\t\t\tslabSupports.append(Line.CreateBound(p0, p1))\r\n\t\treturn slabSupports\r\n\t\t\r\nclass ElemFaces:\r\n\tdef __init__(self, geom):\r\n\t\tfaces = geom.Solid.Faces\r\n\t\txDir = VecABS(geom.XDir)\r\n\t\tyDir = VecABS(geom.YDir)\r\n\t\tself.Top = [face for face in faces if face.FaceNormal.Normalize().IsAlmostEqualTo(XYZ.BasisZ)]\r\n\t\tself.Bottom = [face for face in faces if face.FaceNormal.Normalize().IsAlmostEqualTo(-XYZ.BasisZ)]\r\n\t\tself.Short = [face for face in faces if VecABS(face.FaceNormal.Normalize()).IsAlmostEqualTo(xDir)]\r\n\t\tself.Long = [face for face in faces if VecABS(face.FaceNormal.Normalize()).IsAlmostEqualTo(yDir)]\r\n\t\t\r\nclass BeamParameters:\r\n\tdef __init__(self, beam):\r\n\t\tself.Elem = beam\r\n\t\tself.Id = beam.Id.IntegerValue\r\n\t\tself.LvlId = beam.Parameter[BuiltInParameter.INSTANCE_REFERENCE_LEVEL_PARAM].AsElementId()\r\n\t\tself.Solid = [geom for geom in list(beam.Geometry[opt]) if geom.GetType() == Solid and geom.Volume > 0][0]\r\n\t\tself.Supports = None\r\n\t\tif beam.Symbol.GetParameters('Высота'):\r\n\t\t\tself.H = beam.Symbol.GetParameters('Высота')[0].AsDouble()\r\n\t\telse:\r\n\t\t\tself.H = None\r\n\t\t\r\n\tdef GetBeamSupports(self, wp):\r\n\t\tcutLine = Line.CreateBound(wp.Geom.TopCenterLine.GetEndPoint(0) + XYZ.BasisZ*10/304.8, wp.Geom.TopCenterLine.GetEndPoint(1) + XYZ.BasisZ*10/304.8)\r\n\t\tsolid = self.Solid\r\n\t\tspotLines = list(solid.IntersectWithCurve(cutLine, None))\r\n\t\tbeamSupports = []\r\n\t\tfor spotLine in spotLines:\r\n\t\t\tp0 = spotLine.GetEndPoint(0) - XYZ.BasisZ*10/304.8\r\n\t\t\tp1 = spotLine.GetEndPoint(1) - XYZ.BasisZ*10/304.8\r\n\t\t\tline = Line.CreateBound(p0, p1)\r\n\t\t\tif round(line.Length*304.8) == round(spotLine.Length*304.8):\r\n\t\t\t\tbeamSupports.append(line)\r\n\t\treturn beamSupports\t\t\r\n\t\r\nclass ColumnGeometryParameters:\r\n\tdef __init__(self, column):\r\n\t\tself.Elem = column\r\n\t\tself.CutCornerBL = 0\r\n\t\tif column.GetParameters('Подрезка углов BL'):\r\n\t\t\tself.CutCornerBL = column.GetParameters('Подрезка углов BL')[0].AsDouble()\r\n\t\tself.CutCornerBR = 0\r\n\t\tif column.GetParameters('Подрезка углов BR'):\r\n\t\t\tself.CutCornerBR = column.GetParameters('Подрезка углов BR')[0].AsDouble()\r\n\t\t\r\n\t\tself.L = column.Symbol.GetParameters(IN[5][0])[0].AsDouble() - self.CutCornerBL - self.CutCornerBR\r\n\t\tself.T = column.Symbol.GetParameters(IN[5][1])[0].AsDouble()\r\n\t\tself.H = column.GetParameters(IN[5][2])[0].AsDouble()\r\n\t\tself.BotOffset = column.Parameter[BuiltInParameter.FAMILY_BASE_LEVEL_OFFSET_PARAM].AsDouble()\r\n\t\tself.BotLvlId = column.Parameter[BuiltInParameter.FAMILY_BASE_LEVEL_PARAM].AsElementId()\r\n\t\tself.BotZ = doc.GetElement(self.BotLvlId).Elevation + self.BotOffset\r\n\t\tself.TopOffset = column.Parameter[BuiltInParameter.FAMILY_TOP_LEVEL_OFFSET_PARAM].AsDouble()\r\n\t\tself.TopLvlId = column.Parameter[BuiltInParameter.FAMILY_TOP_LEVEL_PARAM].AsElementId()\r\n\t\tself.TopZ = self.BotZ + self.H\t\t\t\r\n\t\tself.XDir = column.GetTransform().BasisX\r\n\t\tself.YDir = column.GetTransform().BasisY\r\n\t\tself.BotOrigin = column.Location.Point + XYZ.BasisZ*(self.BotZ + basePoint.Position.Z) - self.XDir*self.CutCornerBR/2 + self.XDir*self.CutCornerBL/2\r\n\t\tself.MiddleOrigin = self.BotOrigin + XYZ.BasisZ*self.H/2\r\n\t\tself.EndPoints = [self.BotOrigin - self.XDir*self.L/2, self.BotOrigin + self.XDir*self.L/2]\t\r\n\t\tself.BotCenterLine = Line.CreateBound(self.EndPoints[0], self.EndPoints[1])\r\n\t\tself.TopCenterLine = Line.CreateBound(self.EndPoints[0] + XYZ.BasisZ*self.H, self.EndPoints[1] + XYZ.BasisZ*self.H)\r\n\t\tself.Solid = [geom for geom in list(column.Geometry[opt]) if geom.GetType() == Solid and geom.Volume > 0][0]\r\n\t\tself.Faces = ElemFaces(self)\r\n\t\tself.Chamfer = None\r\n\t\t\t\t\t\r\n\tdef TurnOnOffChamfers(self, switch):\r\n\t\tif self.Elem.GetParameters('Фаски'):\r\n\t\t\tif switch:\r\n\t\t\t\tvalue = [id for id in self.Elem.Symbol.Family.GetFamilyTypeParameterValues(self.Elem.GetParameters('Фаски')[0].Id) if doc.GetElement(id).FamilyName == 'Угол'][0]\r\n\t\t\telse:\r\n\t\t\t\tvalue = [id for id in self.Elem.Symbol.Family.GetFamilyTypeParameterValues(self.Elem.GetParameters('Фаски')[0].Id) if doc.GetElement(id).FamilyName == 'Без подрезки'][0]\r\n\t\t\tself.Elem.GetParameters('Фаски')[0].Set(value)\r\n\t\t\treturn self.Elem.Symbol.GetParameters('Размер фаски')[0].AsDouble()\r\n\t\telse:\r\n\t\t\treturn None\r\n\t\t\r\nclass ColumnReinforcement:\r\n\tdef __init__(self, column):\r\n\t\tself.Type = 'Column'\r\n\t\tself.Elem = column\r\n\t\tself.DX = column.GetParameters('1Пп_Арм_Хомуты_Диаметр')[0].AsDouble()\r\n\t\tself.DY1 = column.GetParameters('1Пп_Арм_Вертикальная_Диаметр 1')[0].AsDouble()\r\n\t\tself.NY1 = column.GetParameters('1Пп_Арм_Вертикальная_Количество')[0].AsInteger()\r\n\t\tself.StepX = column.GetParameters('1Пп_Арм_Хомуты_Шаг приопорный')[0].AsDouble()\r\n\t\tself.StepX2 = column.GetParameters('1Пп_Арм_Хомуты_Шаг пролетный')[0].AsDouble()\r\n\t\tself.CovOth = None\r\n\t\tself.HasAnchorPlates = column.GetParameters('1Пп_Арм_Вертикальная_Анкерные пластины')[0].AsInteger()\r\n\t\tself.HasVStirrups = column.GetParameters('1Пп_Арм_Вертикальная_Пшки')[0].AsInteger()\r\n\t\tself.NX = None\r\n\t\tself.VRebarParameters = []\r\n\t\tself.VStirrupParameters = []\r\n\t\tself.HStirrupParameters = []\r\n\t\tself.AnchorParameters = []\r\n\t\tself.RCTypeId = None\r\n\t\t\r\n\tdef GetRCType(self):\r\n\t\tself.RCTypeId = RebarContainerType.GetOrCreateRebarContainerType(doc, 'Арматурный каркас')\r\n\t\t\t\t\r\n\tdef GetRebarTypes(self):\t\r\n\t\tself.RebarTypeDX = self.GetRebarType(self.DX, 'А240', self.DY1)\r\n\t\tself.RebarTypeDY1 = self.GetRebarType(self.DY1, 'А500С', 0)\r\n\t\t\r\n\tdef GetRebarType(self, d, rClass, dV):\r\n\t\tfor rt in FilteredElementCollector(doc).OfClass(RebarBarType).ToElements():\r\n\t\t\tname = rt.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString()\r\n\t\t\tdiameter = round(rt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()*304.8)\r\n\t\t\tinMeteres = rt.get_Parameter(System.Guid('844a01e2-19fc-4dc5-baa0-a4bda30ef1f6')).AsInteger()\r\n\t\t\tif name.find(rClass) != -1 and diameter == round(d*304.8) and inMeteres == 0 and (dV == 0 or name.find(str(int(round(dV*304.8)))) != -1):\r\n\t\t\t\tbreak\r\n\t\telse:\r\n\t\t\trt = RebarBarType.Create(doc)\r\n\t\t\tif dV > 0:\r\n\t\t\t\tsuffix = '_' + str(int(round(dV*304.8)))\r\n\t\t\telse:\r\n\t\t\t\tsuffix = ''\r\n\t\t\trt.Name = str(int(round(d*304.8))) + '-' + rClass + suffix\r\n\t\t\tSetRebarBarTypeParameters(rt, d, dV, rClass, 0)\r\n\t\treturn rt\r\n\t\t\r\n\tdef UpdateRebarCoverType(self):\r\n\t\tdst = 0\r\n\t\tfor rct in FilteredElementCollector(doc).OfClass(RebarCoverType).ToElements():\r\n\t\t\tif round(rct.CoverDistance*304.8) == round(dst*304.8):\r\n\t\t\t\tbreak\r\n\t\telse:\r\n\t\t\trct = RebarCoverType.Create(doc, str(round(dst*304.8)), dst)\r\n\t\tfor parName in [BuiltInParameter.CLEAR_COVER_TOP, BuiltInParameter.CLEAR_COVER_BOTTOM, BuiltInParameter.CLEAR_COVER_OTHER]:\r\n\t\t\tif not self.Elem.Parameter[parName].IsReadOnly:\r\n\t\t\t\tself.Elem.Parameter[parName].Set(rct.Id)\t\r\n\t\tself.CovOth = doc.GetElement(self.Elem.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].AsElementId()).CoverDistance\t\t\r\n\t\r\nclass ColumnParameters:\r\n\tdef __init__(self, column):\r\n\t\tself.Elem = column\r\n\t\tself.Id = column.Id\r\n\t\tself.Geom = ColumnGeometryParameters(column)\r\n\t\tself.Reinf = ColumnReinforcement(column)\r\n\t\tself.BClass = column.GetParameters('1Пп_Класс бетона')[0].AsValueString()\r\n\t\tif self.BClass.find('B') == -1:\r\n\t\t\tself.BClass = 'B' + self.BClass\t\r\n\t\tself.Phase = column.Parameter[BuiltInParameter.PHASE_CREATED].AsElementId()\r\n\t\tself.Reinf.NX = self.GetReinfNX()\r\n\t\tif column.GetParameters(IN[5][9]):\r\n\t\t\tself.Section = column.GetParameters(IN[5][9])[0].AsString()\r\n\t\telse:\r\n\t\t\tself.Section = None\r\n\t\tself.Mark = column.Parameter[BuiltInParameter.ALL_MODEL_MARK].AsString()\r\n\t\t\r\n\tdef HasBottomSlab(self):\r\n\t\tfilter = ElementLevelFilter(self.Geom.BotLvlId)\r\n\t\tslabs = FilteredElementCollector(doc, List[ElementId](slabIds)).WherePasses(filter).ToElements()\r\n#\t\tcutLine = Line.CreateBound(self.Geom.BotCenterLine.GetEndPoint(0) - XYZ.BasisZ*10/304.8, self.Geom.BotCenterLine.GetEndPoint(1) - XYZ.BasisZ*10/304.8)\r\n\t\tfor slab in slabs:\r\n\t\t\tsp = SlabParameters(slab)\r\n\t\t\tsups = sp.GetSlabBottomSupports(self)\r\n\t\t\tif sups:\r\n\t\t\t\tsp.Supports = sups\r\n\t\t\t\treturn sp\r\n\t\treturn None\r\n\t\t\r\n\tdef HasUpperSlab(self, delta):\r\n\t\tfilter = ElementLevelFilter(self.Geom.TopLvlId)\r\n\t\tslabs = FilteredElementCollector(doc, List[ElementId](slabIds)).OfClass(Floor).WherePasses(filter).ToElements()\r\n#\t\tcutLine = Line.CreateBound(self.Geom.TopCenterLine.GetEndPoint(0) + XYZ.BasisZ*10/304.8, self.Geom.TopCenterLine.GetEndPoint(1) + XYZ.BasisZ*10/304.8)\r\n\t\tfor slab in slabs:\r\n\t\t\tsp = SlabParameters(slab)\r\n\t\t\tsups = sp.GetSlabSupports(self, delta)\r\n\t\t\tif sups:\r\n\t\t\t\tsp.Supports = sups\r\n\t\t\t\treturn sp\r\n\t\treturn None\r\n\r\n\tdef HasUpperColumn(self, delta):\r\n\t\tfilter = ElementLevelFilter(self.Geom.TopLvlId)\r\n\t\tcolumns = FilteredElementCollector(doc, List[ElementId](columnIds)).WherePasses(filter).ToElements()\r\n\t\tcutLine = Line.CreateBound(self.Geom.TopCenterLine.GetEndPoint(0) + XYZ.BasisZ*(300/304.8+delta), self.Geom.TopCenterLine.GetEndPoint(1) + XYZ.BasisZ*(300/304.8+delta))\r\n\t\tfor column in columns:\r\n\t\t\tcp = ColumnParameters(column)\r\n\t\t\tspotLines = list(cp.Geom.Solid.IntersectWithCurve(cutLine, None))\r\n\t\t\tif spotLines and VecABS(cp.Geom.XDir).IsAlmostEqualTo(VecABS(self.Geom.XDir)):\r\n\t\t\t\treturn cp\r\n\t\treturn None\r\n\t\t\r\n#\tdef HasUpperWall(self, delta):\r\n#\t\tfilter = ElementLevelFilter(self.Geom.TopLvlId)\r\n#\t\tcolumns = FilteredElementCollector(doc, List[ElementId](wallIds)).WherePasses(filter).ToElements()\r\n#\t\tcutLine = Line.CreateBound(self.Geom.TopCenterLine.GetEndPoint(0) + XYZ.BasisZ*(300/304.8+delta), self.Geom.TopCenterLine.GetEndPoint(1) + XYZ.BasisZ*(300/304.8+delta))\r\n#\t\tfor wall in walls:\r\n#\t\t\twp = ColumnParameters(column)\r\n#\t\t\tspotLines = list(cp.Geom.Solid.IntersectWithCurve(cutLine, None))\r\n#\t\t\tif spotLines and VecABS(cp.Geom.XDir).IsAlmostEqualTo(VecABS(self.Geom.XDir)):\r\n#\t\t\t\treturn cp\r\n#\t\treturn None\t\r\n\t\t\r\n\tdef HasUpperBeam(self):\r\n\t\tbeams = [beam for beam in FilteredElementCollector(doc, List[ElementId](beamIds)).WhereElementIsNotElementType().ToElements() if beam.Parameter[BuiltInParameter.INSTANCE_REFERENCE_LEVEL_PARAM].AsElementId().IntegerValue == self.Geom.TopLvlId.IntegerValue]\r\n#\t\tcutLine = Line.CreateBound(self.Geom.TopCenterLine.GetEndPoint(0) + XYZ.BasisZ*10/304.8, self.Geom.TopCenterLine.GetEndPoint(1) + XYZ.BasisZ*10/304.8)\r\n\t\tfor beam in beams:\r\n\t\t\tbp = BeamParameters(beam)\r\n\t\t\tsups = bp.GetBeamSupports(self)\r\n\t\t\tif sups:\r\n\t\t\t\tbp.Supports = sups\r\n\t\t\t\treturn bp\r\n\t\treturn None\r\n\r\n\tdef GetReinfNX(self):\r\n\t\tbotOv = math.ceil(ComputeOverlapLength(self.Reinf.DY1, self.BClass)*304.8/10)*10/304.8\r\n\t\tif round(self.Reinf.StepX*304.8) != round(self.Reinf.StepX2*304.8):\r\n\t\t\tH1 = math.ceil(self.Geom.H*IN[7][3]/self.Reinf.StepX)*self.Reinf.StepX\r\n\t\t\tn3 = math.floor((self.Geom.H-2*H1) / self.Reinf.StepX2)\r\n\t\t\tif round((self.Geom.H-2*H1 - n3*self.Reinf.StepX2)*304.8) > (self.Reinf.StepX + self.Reinf.StepX2)/2:\r\n\t\t\t\tn3 += 1\r\n\t\t\tif round(H1*304.8) < round(botOv*304.8):\r\n\t\t\t\tn1 = round((H1 - IN[7][0]/304.8)/self.Reinf.StepX) + 1\r\n\t\t\t\tn2 = math.floor((botOv - H1)/self.Reinf.StepX2)\r\n\t\t\t\tn3 -= n2\t\r\n\t\t\t\tn4 = math.floor((self.Geom.H - (IN[7][0]/304.8 + (n1-1)*self.Reinf.StepX + (n2+n3)*self.Reinf.StepX2))/self.Reinf.StepX)\r\n\t\t\telse:\r\n\t\t\t\tn1 = math.floor((botOv - IN[7][0]/304.8)/self.Reinf.StepX)\r\n\t\t\t\tn2 = round((H1-(IN[1][0]/304.8+(n1-1)*self.Reinf.StepX))/self.Reinf.StepX)\r\n\t\t\t\tn4 = math.floor((self.Geom.H - (IN[1][0]/304.8 + (n1+n2)*self.Reinf.StepX + n3*self.Reinf.StepX2))/self.Reinf.StepX)\r\n\t\telse:\r\n\t\t\tn1 = math.floor((botOv - IN[7][0]/304.8)/self.Reinf.StepX2) + 1\r\n\t\t\tn2 = math.floor((self.Geom.H - IN[7][0]/304.8 - (n1-1)*self.Reinf.StepX2)/self.Reinf.StepX2)\r\n\t\t\tn3 = 0\r\n\t\t\tn4 = 0\t\r\n\t\treturn [n1, n2, n3, n4]\r\n\r\nCPars = [ColumnParameters(column) for column in columns if column.GetParameters('Тип армирования') and column.GetParameters('Тип армирования')[0].AsElementId()]\r\nsortedCPars = []\r\nsortedCPars.append([cp for cp in CPars if cp.Reinf.NY1 == 4])\r\nsortedCPars.append([cp for cp in CPars if cp.Reinf.NY1 == 8 and round(cp.Geom.L*304.8) == round(cp.Geom.T*304.8)])\r\nsortedCPars.append([cp for cp in CPars if cp.Reinf.NY1 == 8 and round(cp.Geom.L*304.8) != round(cp.Geom.T*304.8)])\r\nsortedCPars.append([cp for cp in CPars if cp.Reinf.NY1 == 12 and round(cp.Geom.L*304.8) != round(cp.Geom.T*304.8)])\r\nsortedCPars.append([cp for cp in CPars if cp.Reinf.NY1 == 12 and round(cp.Geom.L*304.8) == round(cp.Geom.T*304.8)])\r\n\r\nOUT = sortedCPars + [CPars]",
