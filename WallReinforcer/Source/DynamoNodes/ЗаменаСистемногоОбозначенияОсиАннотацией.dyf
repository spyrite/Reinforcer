    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "NodeType": "StringInputNode",
      "InputValue": "030_Обозначение оси (ТиповАннот)",
      "Id": "6d7c223b62854357bf0f12ae6c908edd",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "c509660367c14860a5557ac4ea1b9fe1",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Создание строки."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef SetGridAnnotationInsteadBubble(gp):\r\n\tdirs = []\r\n\tfor i in range(2):\r\n\t\tif gp.HasBubbles[i]:\r\n\t\t\tgp.Grid.HideBubbleInView(des[i], gp.View)\r\n\t\t\tpoint = gp.Lines[1].GetEndPoint(i)\r\n\t\t\tann = doc.Create.NewFamilyInstance(point, gridAnnotationType, gp.View)\r\n\t\t\tdoc.Regenerate()\r\n\t\t\tSetGridAnnotationParameters(ann, gp)\r\n\t\t\t\t\t\t\r\ndef SetGridAnnotationParameters(ann, gp):\r\n\tannDirs = [ann.GetTransform().BasisX.Normalize(), ann.GetTransform().BasisY.Normalize()]\r\n\tann.GetParameters('Ось_Название')[0].Set(gp.Names[0])\r\n\tif gp.Directions[0].IsAlmostEqualTo(gp.View.RightDirection) or gp.Directions[0].IsAlmostEqualTo(-gp.View.RightDirection):\r\n\t\tann.GetParameters('Вертикально')[0].Set(1)\r\n\t\tdoc.Regenerate()\r\n\tnearGPs = gp.GetNearGridPars()\r\n\tfor i in range(2):\r\n\t\tif nearGPs[i]:\r\n\t\t\tif ann.GetParameters('Вертикально')[0].AsInteger() == 1:\r\n\t\t\t\tif nearGPs[i].RayWhereGridHasBeenCatchedDir.IsAlmostEqualTo(annDirs[1]):\r\n\t\t\t\t\tann.GetParameters('Стрелка_Сверху')[0].Set(1)\r\n\t\t\t\t\tann.GetParameters('Ось_Название_Сверху')[0].Set(nearGPs[i].Names[0])\r\n\t\t\t\tif nearGPs[i].RayWhereGridHasBeenCatchedDir.IsAlmostEqualTo(-annDirs[1]):\r\n\t\t\t\t\tann.GetParameters('Стрелка_Снизу')[0].Set(1)\r\n\t\t\t\t\tann.GetParameters('Ось_Название_Снизу')[0].Set(nearGPs[i].Names[0])\r\n\t\t\telse:\r\n\t\t\t\tif nearGPs[i].RayWhereGridHasBeenCatchedDir.IsAlmostEqualTo(annDirs[0]):\r\n\t\t\t\t\tann.GetParameters('Стрелка_Справа')[0].Set(1)\r\n\t\t\t\t\tann.GetParameters('Ось_Название_Справа')[0].Set(nearGPs[i].Names[0])\r\n\t\t\t\tif nearGPs[i].RayWhereGridHasBeenCatchedDir.IsAlmostEqualTo(-annDirs[0]):\r\n\t\t\t\t\tann.GetParameters('Стрелка_Слева')[0].Set(1)\r\n\t\t\t\t\tann.GetParameters('Ось_Название_Слева')[0].Set(nearGPs[i].Names[0])\r\n\t\t\t\t\t\r\ndef CalculateAmountOfGrids(GPs, view):\r\n\tn = [0, 0, 0]\r\n\tfor gp in GPs:\r\n\t\tif gp.Directions[0].IsAlmostEqualTo(view.RightDirection) or gp.Directions[0].IsAlmostEqualTo(-view.RightDirection):\r\n\t\t\tn[0] += 1\r\n\t\telif gp.Directions[0].IsAlmostEqualTo(view.UpDirection) or gp.Directions[0].IsAlmostEqualTo(-view.UpDirection):\r\n\t\t\tn[1] += 1\r\n\t\telse:\r\n\t\t\tn[2] += 1\r\n\treturn n\r\n\r\ndef AllowToSetGridAnnotation(gp, n, view):\r\n\tcondition1 = (gp.Directions[0].IsAlmostEqualTo(view.RightDirection) or gp.Directions[0].IsAlmostEqualTo(-view.RightDirection)) and n[0] == 1\r\n\tcondition2 = (gp.Directions[0].IsAlmostEqualTo(view.UpDirection) or gp.Directions[0].IsAlmostEqualTo(-view.UpDirection)) and n[1] == 1\r\n\treturn (condition1 or condition2)\r\n\t\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nGPSets = IN[0]\r\nviews = UnwrapElement(IN[1])\r\ndes = [DatumEnds.End0, DatumEnds.End1]\r\n\r\ngridAnnotationType = [sym for sym in FilteredElementCollector(doc).OfClass(FamilySymbol).ToElements() if sym.FamilyName == IN[2][0] and sym.Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsValueString() == IN[2][1]][0]\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor i, view in enumerate(views):\r\n\tif view.ViewDirection.IsAlmostEqualTo(XYZ.BasisZ) or view.ViewDirection.IsAlmostEqualTo(-XYZ.BasisZ):\r\n\t\tGPs = GPSets[i]\r\n\t\tn = CalculateAmountOfGrids(GPs, view)\r\n\t\tfor gp in GPs:\r\n\t\t\tif AllowToSetGridAnnotation(gp, n, view):\r\n\t\t\t\tgp.UpdateViewGeometrics(view)\r\n\t\t\t\tSetGridAnnotationInsteadBubble(gp)\r\n\t\t\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\t\t\t\t\r\nOUT = ''",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
