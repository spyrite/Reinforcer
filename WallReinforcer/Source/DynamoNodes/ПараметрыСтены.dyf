    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import sys\r\nimport clr\r\nimport math\r\nimport System\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nbasePoint = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_ProjectBasePoint).FirstElement()\r\n\t\r\ndef VecABS(vec):\r\n\tx = abs(vec.X)\r\n\ty = abs(vec.Y)\r\n\tz = abs(vec.Z)\r\n\treturn XYZ(x,y,z)\r\n\r\ndef SortGeomByZ(geom):\r\n\treturn geom.Origin.Z\r\n\t\r\ndef SortPointsByCoords(p0, p1):\r\n\tconditions = []\r\n\tconditions.append(round(p0.X*304.8) <= round(p1.X*304.8))\r\n\tconditions.append(round(p0.Y*304.8) <= round(p1.Y*304.8))\r\n\tconditions.append(round(p0.Z*304.8) <= round(p1.Z*304.8))\r\n#\treturn conditions\r\n\tif conditions[0] and conditions[1] and conditions[2]:\r\n\t\treturn [p0, p1]\r\n\telse:\r\n\t\treturn [p1, p0]\r\n\t\t\r\ndef SortByElevation(id):\r\n\treturn round(doc.GetElement(ElementId(id)).Elevation)*304.8\r\n\t\r\ndef ComputeBendDiameter(d, rClass):\r\n\tif rClass == 'А240':\r\n\t\tif round(d*304.8) < 20:\r\n\t\t\tdb = 2.5*d\r\n\t\telse:\r\n\t\t\tdb = 4*d\r\n\telse:\r\n\t\tif round(d*304.8) < 20:\r\n\t\t\tdb = 5*d\r\n\t\telse:\r\n\t\t\tdb = 8*d\r\n\treturn db\r\n\t\r\ndef SetRebarBarTypeParameters(rt, d1, d2, rClass, im):\r\n\trt.GetParameters(IN[5][4])[0].Set(im)\r\n\trt.GetParameters(IN[5][5])[0].Set(int(rClass.split('А')[-1].split('С')[0]))\r\n\trt.GetParameters(IN[5][6])[0].Set('ГОСТ 34028-2016')\r\n\trt.GetParameters(IN[5][7])[0].Set(rClass)\r\n\trt.GetParameters(IN[5][8])[0].Set(0)\r\n\tif rClass == 'А240':\r\n\t\trt.Parameter[BuiltInParameter.REBAR_BAR_DEFORMATION_TYPE].Set(1)\r\n\telse:\r\n\t\trt.Parameter[BuiltInParameter.REBAR_BAR_DEFORMATION_TYPE].Set(0)\r\n\trt.Parameter[BuiltInParameter.REBAR_MODEL_BAR_DIAMETER].Set(d1)\r\n\trt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].Set(d1)\r\n\tif d2 > 0:\r\n\t\tdb = d2\r\n\telse:\r\n\t\tdb = ComputeBendDiameter(d1, rClass)\r\n\trt.Parameter[BuiltInParameter.REBAR_STANDARD_BEND_DIAMETER].Set(db)\r\n\trt.Parameter[BuiltInParameter.REBAR_BAR_STIRRUP_BEND_DIAMETER].Set(db)\r\n\trt.Parameter[BuiltInParameter.REBAR_STANDARD_HOOK_BEND_DIAMETER].Set(db)\r\n\tmaterials = [mat for mat in FilteredElementCollector(doc).OfClass(Material).ToElements() if mat.Name.find('Арматура D') == 0 and int(mat.Name.split('D')[-1]) == int(round(d1*304.8))]\r\n\tif materials:\r\n\t\trt.Parameter[BuiltInParameter.MATERIAL_ID_PARAM].Set(materials[0].Id)\r\n\tsubCats = [sc for sc in Category.GetCategory(doc, BuiltInCategory.OST_Rebar).SubCategories if sc.Name == 'D'+str(int(round(d1*304.8)))]\r\n\tif subCats:\r\n\t\trt.Parameter[BuiltInParameter.REBAR_BAR_STYLE].Set(subCats[0].Id)\r\n\t\t\r\ndef GetUnboundFaces(faces):\r\n\treturn [Plane.CreateByNormalAndOrigin(face.FaceNormal, face.Origin) for face in faces]\r\n\r\nview = UnwrapElement(IN[0])\r\nwalls = UnwrapElement(IN[1])\r\ncolumnIds = UnwrapElement(IN[2])\r\nwallIds = UnwrapElement(IN[3])\r\nslabIds = UnwrapElement(IN[4])\r\nintersector = UnwrapElement(IN[6])\r\n\r\nopt = Options()\r\nopt.ComputeReferences = True\r\n\r\nclass ElemFaces:\r\n\tdef __init__(self, geom):\r\n\t\tfaces = geom.Solid.Faces\r\n\t\txDir = VecABS(geom.XDir)\r\n\t\tyDir = VecABS(geom.YDir)\r\n\t\tself.Top = [face for face in faces if face.FaceNormal.Normalize().IsAlmostEqualTo(XYZ.BasisZ)]\r\n\t\tself.Bottom = [face for face in faces if face.FaceNormal.Normalize().IsAlmostEqualTo(-XYZ.BasisZ)]\r\n\t\tself.Short = [face for face in faces if VecABS(face.FaceNormal.Normalize()).IsAlmostEqualTo(xDir)]\r\n\t\tself.Long = [face for face in faces if VecABS(face.FaceNormal.Normalize()).IsAlmostEqualTo(yDir)]\r\n\r\nclass OpeningParameters:\r\n\tdef __init__(self, wp, open):\r\n\t\tself.Id = open.Id\r\n\t\tself.Elem = open\r\n\t\tif open.GetParameters(IN[5][3]):\r\n\t\t\tself.B = open.GetParameters(IN[5][3])[0].AsDouble()\r\n\t\telse:\r\n\t\t\tself.B = None\r\n\t\tif open.GetParameters(IN[5][2]):\r\n\t\t\tself.H = open.GetParameters(IN[5][2])[0].AsDouble()\r\n\t\telse:\r\n\t\t\tself.H = None\t\r\n\t\tself.Origin = open.Location.Point\r\n\t\tself.Z = self.Origin.Z\r\n\t\tself.XDir = open.GetTransform().BasisX\r\n\t\tself.ZDir = open.GetTransform().BasisZ\r\n\t\tself.EndPoints = [self.Origin - self.XDir*self.B/2, self.Origin + self.XDir*self.B/2]\r\n\t\tself.Host = wp.Elem\r\n\t\tself.HostPars = wp\r\n\t\tself.Solid = GeometryCreationUtilities.CreateExtrusionGeometry([CurveLoop.Create(self.GetSketch())], wp.Geom.YDir, wp.Geom.T)\r\n\t\t\r\n\tdef GetSketch(self):\r\n\t\tp0 = self.EndPoints[0] - self.HostPars.Geom.YDir*self.HostPars.Geom.T/2\r\n\t\tp1 = p0 + XYZ.BasisZ*self.H\r\n\t\tp2 = self.EndPoints[1] - self.HostPars.Geom.YDir*self.HostPars.Geom.T/2 + XYZ.BasisZ*self.H\r\n\t\tp3 = p2 - XYZ.BasisZ*self.H\r\n\t\tlines = []\r\n\t\tlines.append(Line.CreateBound(p0, p1))\r\n\t\tlines.append(Line.CreateBound(p1, p2))\r\n\t\tlines.append(Line.CreateBound(p2, p3))\r\n\t\tlines.append(Line.CreateBound(p3, p0))\r\n\t\treturn lines\r\n\t\t\r\n\tdef GetAttachedFaces(self):\r\n\t\topenFaces = [face for face in self.Solid.Faces if not VecABS(face.FaceNormal.Normalize()).IsAlmostEqualTo(VecABS(self.HostPars.Geom.YDir))]\r\n\t\tattFaces = []\r\n\t\tfor openFace in openFaces:\r\n\t\t\tpoint = openFace.Evaluate(UV(10/304.8, 10/304.8))\r\n\t\t\tcutLine = Line.CreateBound(point, point + openFace.FaceNormal.Normalize()*10/304.8)\r\n\t\t\tspotLines = list(self.HostPars.Geom.Solid.IntersectWithCurve(cutLine, None))\r\n\t\t\tif not spotLines:\r\n\t\t\t\tattFaces.append(openFace)\r\n\t\treturn attFaces\r\n\t\t\t\t\t\r\nclass VoidParameters:\r\n\tdef __init__(self, wp, void):\r\n\t\tself.Id = void.Id\r\n\t\tself.Elem = void\r\n\t\tself.H = void.Symbol.Parameter[BuiltInParameter.DOOR_HEIGHT].AsDouble()\r\n\t\tself.B = void.Symbol.Parameter[BuiltInParameter.FURNITURE_WIDTH].AsDouble()\t\r\n\t\tself.Origin = void.Location.Point\r\n\t\tself.Z = self.Origin.Z\r\n\t\tself.XDir = void.GetTransform().BasisX\r\n\t\tself.ZDir = void.GetTransform().BasisZ\r\n\t\tself.EndPoints = [self.Origin - self.XDir*self.B/2, self.Origin + self.XDir*self.B/2]\r\n\t\tself.ZPoints = [self.Origin, self.Origin + XYZ.BasisZ*self.H]\r\n\t\tself.Host = wp.Elem\r\n\t\tself.HostPars = wp\r\n\t\tself.Solid = GeometryCreationUtilities.CreateExtrusionGeometry([CurveLoop.Create(self.GetSketch())], -wp.Geom.YDir, wp.Geom.T)\r\n\t\tself.BotCenterLine = Line.CreateBound(self.EndPoints[0], self.EndPoints[1])\t\t\r\n\t\t\r\n\tdef GetSketch(self):\r\n\t\tp0 = self.EndPoints[0] + self.HostPars.Geom.YDir*self.HostPars.Geom.T/2\r\n\t\tp1 = p0 + XYZ.BasisZ*self.H\r\n\t\tp2 = self.EndPoints[1] + self.HostPars.Geom.YDir*self.HostPars.Geom.T/2 + XYZ.BasisZ*self.H\r\n\t\tp3 = p2 - XYZ.BasisZ*self.H\r\n\t\tlines = []\r\n\t\tlines.append(Line.CreateBound(p0, p1))\r\n\t\tlines.append(Line.CreateBound(p1, p2))\r\n\t\tlines.append(Line.CreateBound(p2, p3))\r\n\t\tlines.append(Line.CreateBound(p3, p0))\r\n\t\treturn lines\r\n\r\n\tdef GetAttachedFaces(self):\r\n\t\topenFaces = [face for face in self.Solid.Faces if not VecABS(face.FaceNormal.Normalize()).IsAlmostEqualTo(VecABS(self.HostPars.Geom.YDir))]\r\n\t\tattFaces = []\r\n\t\tfor openFace in openFaces:\r\n\t\t\tcenter = openFace.Evaluate(UV(10/304.8, 10/304.8))\r\n\t\t\tcutLine = Line.CreateBound(center, center + openFace.FaceNormal.Normalize()*10/304.8)\r\n\t\t\tspotLines = list(self.HostPars.Geom.Solid.IntersectWithCurve(cutLine, None))\r\n\t\t\tif not spotLines:\r\n\t\t\t\tattFaces.append(openFace)\r\n\t\treturn attFaces\r\n\t\t\r\n\tdef GetBoundFaces(self):\r\n\t\topenFaces = [face for face in self.Solid.Faces if not VecABS(face.FaceNormal.Normalize()).IsAlmostEqualTo(VecABS(self.HostPars.Geom.YDir))]\r\n\t\thostFaces = [face for face in self.HostPars.Geom.Solid.Faces if not VecABS(face.FaceNormal.Normalize()).IsAlmostEqualTo(VecABS(self.HostPars.Geom.YDir))]\r\n\t\tboundFaces = []\r\n\t\tfor openFace in openFaces:\r\n\t\t\tcenter = openFace.Evaluate(UV(10/304.8, 10/304.8))\r\n\t\t\tcutLine = Line.CreateBound(center, center + openFace.FaceNormal.Normalize()*10/304.8)\r\n\t\t\tfor hostFace in hostFaces:\r\n\t\t\t\tproject = hostFace.Project(center)\r\n\t\t\t\tif project and MathComparisonUtils.IsAlmostZero(project.Distance):\r\n\t\t\t\t\tboundFaces.append(hostFace)\r\n\t\t\t\t\tbreak\r\n\t\t\telse:\r\n\t\t\t\tboundFaces.append(None)\r\n\t\treturn boundFaces\t\t\r\n\t\t\r\n\tdef HasUpperEqualVoid(self):\r\n\t\tends = [None, None]\r\n\t\tupperWPs = self.HostPars.HasUpperWalls()\r\n\t\tfor upWP in upperWPs:\r\n\t\t\tvps = upWP.Voids\r\n\t\t\tfor vp in vps:\r\n\t\t\t\tfor i in range(2):\r\n\t\t\t\t\tline = Line.CreateBound(self.EndPoints[i], vp.EndPoints[i])\r\n\t\t\t\t\tif line.Direction.Normalize().IsAlmostEqualTo(XYZ.BasisZ):\r\n\t\t\t\t\t\tends[i] = vp\r\n\t\treturn ends\r\n\t\t\r\n\tdef GetRegionSolid(self):\r\n\t\tcutLine = Line.CreateBound(self.Origin + XYZ.BasisZ*10/304.8 - self.XDir*(self.B/2+10/304.8), self.Origin + XYZ.BasisZ*10/304.8 + self.XDir*(self.B/2*10/304.8))\r\n\t\tfor region in self.HostPars.Regions:\r\n\t\t\tsolid = region.GetRegionSolid() \r\n\t\t\tspotLines = list(solid.IntersectWithCurve(cutLine, None))\r\n\t\t\tif spotLines:\r\n\t\t\t\treturn solid\r\n\t\telse:\r\n#\t\t\treturn [r.GetRegionSolid() for r in self.HostPars.Regions]\r\n\t\t\treturn None\r\n\r\nclass SlabGeometry:\r\n\tdef __init__(self, sp):\r\n\t\tslab = sp.Elem\r\n\t\tself.SpanAngle = slab.SpanDirectionAngle\r\n\t\ttransform = Transform.CreateRotation(XYZ.BasisZ, self.SpanAngle)\r\n\t\tself.XDir = transform.BasisX\r\n\t\tself.YDir = transform.BasisY\r\n\t\tself.Solid = [geom for geom in list(slab.Geometry[opt]) if geom.GetType() == Solid and geom.Volume > 0][0]\r\n\t\tself.Faces = ElemFaces(self)\r\n\t\t\r\nclass SlabParameters:\r\n\tdef __init__(self, slab):\r\n\t\tself.Elem = slab\r\n\t\tself.Id = slab.Id\r\n\t\tself.T = slab.Parameter[BuiltInParameter.FLOOR_ATTR_THICKNESS_PARAM].AsDouble()\r\n\t\tself.SpanAngle = slab.SpanDirectionAngle\r\n\t\tself.LvlId = slab.LevelId\r\n\t\tself.Solid = [geom for geom in list(slab.Geometry[opt]) if geom.GetType() == Solid and geom.Volume > 0][0]\r\n\t\t\r\n\t\tself.Geom = SlabGeometry(self)\r\n\t\t\r\n\t\tself.Supports = None\r\n\t\tbClassPar = slab.GetParameters('1Пп_Класс бетона')[0]\r\n\t\tif bClassPar.StorageType == StorageType.Double:\r\n\t\t\tself.BClass = 'B' + str(int(round(bClassPar.AsDouble())))\r\n\t\telse:\r\n\t\t\tself.BClass = slab.GetParameters('1Пп_Класс бетона')[0].AsString()\r\n\t\tself.TopCovDst = 0\r\n\t\tself.BotCovDst = 0\r\n\t\tself.OthCovDst = 0\r\n\t\tif slab.Parameter[BuiltInParameter.FLOOR_PARAM_IS_STRUCTURAL].AsInteger() == 1:\r\n\t\t\tif doc.GetElement(slab.Parameter[BuiltInParameter.CLEAR_COVER_TOP].AsElementId()):\r\n\t\t\t\tself.TopCovDst = doc.GetElement(slab.Parameter[BuiltInParameter.CLEAR_COVER_TOP].AsElementId()).CoverDistance\r\n\t\t\tif doc.GetElement(slab.Parameter[BuiltInParameter.CLEAR_COVER_BOTTOM].AsElementId()):\r\n\t\t\t\tself.BotCovDst = doc.GetElement(slab.Parameter[BuiltInParameter.CLEAR_COVER_BOTTOM].AsElementId()).CoverDistance\r\n\t\t\tif doc.GetElement(slab.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].AsElementId()):\r\n\t\t\t\tself.OthCovDst = doc.GetElement(slab.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].AsElementId()).CoverDistance\r\n\t\t\t\t\r\n\t\tif round(self.SpanAngle*100)/100 == 0 or round(self.SpanAngle*100)/100 == round(3.14*100)/100:\r\n\t\t\tself.DMainTOP = slab.GetParameters('1Пп_Арм_X_Верх_Диаметр')[0].AsDouble()\r\n\t\t\tself.DMainBOT = slab.GetParameters('1Пп_Арм_X_Низ_Диаметр')[0].AsDouble()\r\n\t\t\tself.DSecTOP = slab.GetParameters('1Пп_Арм_Y_Верх_Диаметр')[0].AsDouble()\r\n\t\t\tself.DSecBOT = slab.GetParameters('1Пп_Арм_Y_Низ_Диаметр')[0].AsDouble()\r\n\t\telse:\r\n\t\t\tself.DMainTOP = slab.GetParameters('1Пп_Арм_Y_Верх_Диаметр')[0].AsDouble()\r\n\t\t\tself.DMainBOT = slab.GetParameters('1Пп_Арм_Y_Низ_Диаметр')[0].AsDouble()\r\n\t\t\tself.DSecTOP = slab.GetParameters('1Пп_Арм_X_Верх_Диаметр')[0].AsDouble()\r\n\t\t\tself.DSecBOT = slab.GetParameters('1Пп_Арм_X_Низ_Диаметр')[0].AsDouble()\r\n\t\tself.Phase = slab.Parameter[BuiltInParameter.PHASE_CREATED].AsElementId()\r\n\t\tself.Workset = slab.Parameter[BuiltInParameter.ELEM_PARTITION_PARAM].AsInteger()\r\n\t\tif slab.GetParameters(IN[5][9]):\r\n\t\t\tself.Zone = slab.GetParameters(IN[5][9])[0].AsString()\r\n\t\telse:\r\n\t\t\tself.Zone = None\r\n\t\tif slab.GetParameters(IN[5][10]):\r\n\t\t\tself.Section = slab.GetParameters(IN[5][10])[0].AsString()\r\n\t\telse:\r\n\t\t\tself.Section = None\t\r\n\t\t\r\n\t\t\r\n\tdef GetSlabBottomSupports(self, wp):\r\n\t\tcutLine = Line.CreateBound(wp.Geom.BotCenterLine.GetEndPoint(0) - XYZ.BasisZ*10/304.8, wp.Geom.BotCenterLine.GetEndPoint(1) - XYZ.BasisZ*10/304.8)\r\n\t\tsolid = self.Solid\r\n\t\tspotLines = list(solid.IntersectWithCurve(cutLine, None))\r\n\t\tslabSupports = []\r\n\t\tfor spotLine in spotLines:\r\n\t\t\tp0 = spotLine.GetEndPoint(0) + XYZ.BasisZ*10/304.8\r\n\t\t\tp1 = spotLine.GetEndPoint(1) + XYZ.BasisZ*10/304.8\r\n\t\t\tslabSupports.append(Line.CreateBound(p0, p1))\r\n\t\treturn slabSupports\r\n\t\t\r\n\tdef GetSlabSupports(self, wp):\r\n\t\tcutLine = Line.CreateBound(wp.Geom.TopCenterLine.GetEndPoint(0) + XYZ.BasisZ*10/304.8, wp.Geom.TopCenterLine.GetEndPoint(1) + XYZ.BasisZ*10/304.8)\r\n\t\tsolid = self.Solid\r\n\t\tspotLines = list(solid.IntersectWithCurve(cutLine, None))\r\n\t\tslabSupports = []\r\n\t\tfor spotLine in spotLines:\r\n\t\t\tp0 = spotLine.GetEndPoint(0) - XYZ.BasisZ*10/304.8\r\n\t\t\tp1 = spotLine.GetEndPoint(1) - XYZ.BasisZ*10/304.8\r\n\t\t\tslabSupports.append(Line.CreateBound(p0, p1))\r\n\t\treturn slabSupports\r\n\r\nclass ColumnGeometryParameters:\r\n\tdef __init__(self, column):\r\n\t\tself.L = column.Symbol.GetParameters(IN[5][0])[0].AsDouble()\r\n\t\tself.T = column.Symbol.GetParameters(IN[5][1])[0].AsDouble()\r\n\t\tself.H = column.GetParameters(IN[5][2])[0].AsDouble()\r\n\t\tself.LvlId = column.LevelId\r\n\t\tself.BotOffset = column.Parameter[BuiltInParameter.FAMILY_BASE_LEVEL_OFFSET_PARAM].AsDouble()\r\n\t\tself.BotZ = doc.GetElement(self.LvlId).Elevation + self.BotOffset\r\n\t\tself.BotOrigin = column.Location.Point + XYZ.BasisZ*(self.BotZ + basePoint.Position.Z)\r\n\t\tself.XDir = column.GetTransform().BasisX\r\n\t\tself.YDir = column.GetTransform().BasisY\r\n\t\tself.EndPoints = [self.BotOrigin - self.XDir*self.L/2, self.BotOrigin + self.XDir*self.L/2]\r\n\t\tself.EndPoints2 = [self.BotOrigin - self.YDir*self.T/2, self.BotOrigin + self.YDir*self.T/2]\r\n\t\tself.BotCenterLine = Line.CreateBound(self.EndPoints[0], self.EndPoints[1])\r\n\t\tself.Solid = [geom for geom in list(column.Geometry[opt]) if geom.GetType() == Solid and geom.Volume > 0][0]\r\n\t\tself.Faces = ElemFaces(self)\r\n\t\t\r\nclass ColumnReinforcement:\r\n\tdef __init__(self, column):\r\n\t\tself.Type = 'Column'\r\n\t\tself.Elem = column\r\n\t\tself.DX = column.GetParameters('1Пп_Арм_Хомуты_Диаметр')[0].AsDouble()\r\n\t\tself.DY1 = column.GetParameters('1Пп_Арм_Вертикальная_Диаметр 1')[0].AsDouble()\r\n\t\tself.DY3 = column.GetParameters('1Пп_Арм_Вертикальная_Диаметр 1')[0].AsDouble()\r\n\t\tself.StepX = column.GetParameters('1Пп_Арм_Хомуты_Шаг пролетный')[0].AsDouble()\r\n\t\tcovOth = doc.GetElement(column.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].AsElementId())\r\n\t\tif covOth:\r\n\t\t\tself.CovOth = covOth.CoverDistance\r\n\t\telse:\r\n\t\t\tself.CovOth = None\r\n\t\t\t\t\r\n\tdef GetRebarTypes(self):\t\r\n\t\tself.RebarTypeDX = self.GetRebarType(self.DX, 'А240', self.DY1)\r\n\t\tself.RebarTypeDY1 = self.GetRebarType(self.DY1, 'А500С', 0)\r\n\t\tself.RebarTypeDY3 = self.GetRebarType(self.DY3, 'А500С', 0)\r\n\t\tself.RebarTypeDBinder = self.RebarTypeDX\r\n\t\t\r\n\tdef GetRebarType(self, d, rClass, dV):\r\n\t\tfor rt in FilteredElementCollector(doc).OfClass(RebarBarType).ToElements():\r\n\t\t\tname = rt.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString()\r\n\t\t\tdiameter = round(rt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()*304.8)\r\n\t\t\tinMeteres = rt.get_Parameter(System.Guid('844a01e2-19fc-4dc5-baa0-a4bda30ef1f6')).AsInteger()\r\n\t\t\tif name.find(rClass) != -1 and diameter == round(d*304.8) and inMeteres == 0 and (dV == 0 or name.find(str(int(round(dV*304.8)))) != -1):\r\n\t\t\t\tbreak\r\n\t\telse:\r\n\t\t\trt = RebarBarType.Create(doc)\r\n\t\t\tif dV > 0:\r\n\t\t\t\tsuffix = '_' + str(int(round(dV*304.8)))\r\n\t\t\telse:\r\n\t\t\t\tsuffix = ''\r\n\t\t\trt.Name = str(int(round(d*304.8))) + '-' + rClass + suffix\r\n\t\t\tSetRebarBarTypeParameters(rt, d, dV, rClass, 0)\r\n\t\treturn rt\r\n\t\t\r\n\tdef UpdateRebarCoverType(self, align):\r\n\t\tdst = align - self.DY1/2 - self.DX\r\n\t\tfor rct in FilteredElementCollector(doc).OfClass(RebarCoverType).ToElements():\r\n\t\t\tif round(rct.CoverDistance*304.8) == round(dst*304.8):\r\n\t\t\t\tbreak\r\n\t\telse:\r\n\t\t\trct = RebarCoverType.Create(doc, str(round(dst*304.8)), dst)\r\n\t\tif not self.Elem.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].IsReadOnly:\t\r\n\t\t\tself.Elem.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].Set(rct.Id)\r\n\t\t\tself.CovOth = doc.GetElement(self.Elem.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].AsElementId()).CoverDistance\t\r\n\t\r\nclass ColumnParameters:\r\n\tdef __init__(self, column):\r\n\t\tself.Elem = column\r\n\t\tself.Id = column.Id\r\n\t\tself.Geom = ColumnGeometryParameters(column)\r\n\t\tself.Reinf = ColumnReinforcement(column)\r\n\t\tbClassPar = wall.GetParameters('1Пп_Класс бетона')[0]\r\n\t\tif bClassPar.StorageType == StorageType.Double:\r\n\t\t\tself.BClass = 'B' + str(int(round(bClassPar.AsDouble())))\r\n\t\telse:\r\n\t\t\tself.BClass = wall.GetParameters('1Пп_Класс бетона')[0].AsString()\r\n\t\tif column.GetParameters(IN[5][9]):\r\n\t\t\tself.Zone = column.GetParameters(IN[5][9])[0].AsString()\r\n\t\telse:\r\n\t\t\tself.Zone = None\r\n\t\tif column.GetParameters(IN[5][10]):\r\n\t\t\tself.Section = column.GetParameters(IN[5][10])[0].AsString()\r\n\t\telse:\r\n\t\t\tself.Section = None\t\r\n\t\t\t\r\nclass WallEnd:\r\n\tdef __init__(self, elp):\r\n\t\tself.Type = 'End'\r\n\t\tself.HostPars = elp\r\n\t\tself.T = elp.Geom.T\r\n\t\tself.Origin = None\r\n\t\tself.XDir = None\r\n\t\tself.Region = None\r\n\t\t\r\n\tdef HasUpperElement(self):\r\n\t\tfilters = []\r\n\t\tfilters.append(LogicalOrFilter(ElementLevelFilter(self.HostPars.Geom.TopLvlId), ElementLevelFilter(self.HostPars.Geom.BotLvlId)))\r\n\t\tcatchPoint = self.Origin + self.XDir*10/304.8 + XYZ.BasisZ*(self.HostPars.Geom.H + 300/304.8)\r\n\t\tfilters.append(BoundingBoxContainsPointFilter(catchPoint))\r\n\t\tcomFilter = LogicalAndFilter(filters)\r\n\t\telemIds = list(wallIds) + list(columnIds)\r\n\t\telem = FilteredElementCollector(doc, List[ElementId](elemIds)).WherePasses(comFilter).FirstElement()\r\n\t\tif elem:\t\t\r\n\t\t\tif elem.GetType() == FamilyInstance:\r\n\t\t\t\telp = ColumnParameters(elem)\r\n\t\t\telse:\r\n\t\t\t\telp = WallParameters(elem)\r\n\t\t\treturn elp\r\n\t\treturn None\r\n\t\t\r\n\tdef HasUpperSlab(self):\r\n\t\tfilters = []\r\n\t\tfilters.append(ElementLevelFilter(self.HostPars.Geom.TopLvlId))\r\n\t\tcatchPoint = self.Origin + self.XDir*10/304.8 + XYZ.BasisZ*(self.HostPars.Geom.H + 10/304.8)\r\n\t\tfilters.append(BoundingBoxContainsPointFilter(catchPoint))\r\n\t\tcomFilter = LogicalAndFilter(filters)\r\n\t\tslab = FilteredElementCollector(doc, List[ElementId](slabIds)).OfClass(Floor).WherePasses(comFilter).FirstElement()\r\n\t\tif slab:\r\n\t\t\tsp = SlabParameters(slab)\r\n\t\t\treturn sp\r\n\t\treturn None\r\n\r\n\tdef GetSolid(self):\r\n\t\ttokens = [[0, -1], [1, -1], [1, 1], [0, 1]]\r\n\t\tpoints = []\r\n\t\tdir1 = self.XDir\r\n\t\tdir2 = self.HostPars.Geom.YDir \r\n\t\tfor i in range(4):\r\n\t\t\tpoint = self.Origin + dir1*self.T*tokens[i][0] + dir2*(self.T/2)*tokens[i][1]\r\n\t\t\tpoints.append(point)\r\n\t\tlines = []\r\n\t\tlines.append(Line.CreateBound(points[0], points[1]))\r\n\t\tlines.append(Line.CreateBound(points[1], points[2]))\r\n\t\tlines.append(Line.CreateBound(points[2], points[3]))\r\n\t\tlines.append(Line.CreateBound(points[3], points[0]))\r\n\t\tsolid = GeometryCreationUtilities.CreateExtrusionGeometry([CurveLoop.Create(lines)], XYZ.BasisZ, self.HostPars.Geom.H)\r\n\t\treturn solid\r\n\t\t\r\n\tdef GetOutline(self):\r\n\t\tp0 = self.Origin - VecABS(self.XDir)*self.T - VecABS(self.HostPars.Geom.YDir)*self.T/2\r\n\t\tp1 = self.Origin + VecABS(self.XDir)*self.T + VecABS(self.HostPars.Geom.YDir)*self.T/2 + XYZ.BasisZ*self.HostPars.Geom.H\r\n\t\toutline = Outline(p0, p1)\r\n\t\treturn outline\r\n\r\nclass WallIntersection:\r\n\tdef __init__(self, aelps, elp):\r\n\t\tself.Type = 'Intersection'\r\n\t\tself.HostPars = elp\r\n\t\tself.AttachedElemsPars = aelps\r\n\t\tself.T = []\r\n\t\tfor aelp in aelps:\r\n\t\t\tif VecABS(aelp.Geom.YDir).IsAlmostEqualTo(VecABS(elp.Geom.XDir)) or aelp.Elem.GetType() == Wall:\r\n\t\t\t\tself.T.append(aelp.Geom.T)\r\n\t\t\telse:\r\n\t\t\t\tself.T.append(aelp.Geom.L)\r\n\t\tself.L = [aelp.Geom.L for aelp in aelps if aelp.Elem.GetType() == FamilyInstance]\r\n\t\tself.Origin = None\r\n\t\tself.PlaceRebars = False\r\n\t\t\r\n\tdef HasUpperElement(self):\r\n\t\tfilters = []\r\n\t\tfilters.append(LogicalOrFilter(ElementLevelFilter(self.HostPars.Geom.TopLvlId), ElementLevelFilter(self.HostPars.Geom.BotLvlId)))\r\n\t\tcatchPoint = self.Origin + XYZ.BasisZ*(self.HostPars.Geom.H + 300/304.8)\r\n\t\tfilters.append(BoundingBoxContainsPointFilter(catchPoint))\r\n\t\tcomFilter = LogicalAndFilter(filters)\r\n\t\telemIds = list(wallIds) + list(columnIds)\r\n\t\telem = FilteredElementCollector(doc, List[ElementId](elemIds)).WherePasses(comFilter).FirstElement()\r\n\t\tif elem:\t\t\r\n\t\t\tif elem.GetType() == FamilyInstance:\r\n\t\t\t\tself.PlaceRebars = False\r\n\t\t\t\telp = ColumnParameters(elem)\r\n\t\t\telse:\r\n\t\t\t\telp = WallParameters(elem)\r\n\t\t\treturn elp\r\n\t\treturn None\r\n\t\t\r\n\tdef HasUpperSlab(self):\r\n\t\tfilters = []\r\n\t\tfilters.append(ElementLevelFilter(self.HostPars.Geom.TopLvlId))\r\n\t\tcatchPoint = self.Origin + XYZ.BasisZ*(self.HostPars.Geom.H + 10/304.8)\r\n\t\tfilters.append(BoundingBoxContainsPointFilter(catchPoint))\r\n\t\tcomFilter = LogicalAndFilter(filters)\r\n\t\tslab = FilteredElementCollector(doc, List[ElementId](slabIds)).OfClass(Floor).WherePasses(comFilter).FirstElement()\r\n\t\tif slab:\r\n\t\t\tsp = SlabParameters(slab)\r\n\t\t\treturn sp\r\n\t\treturn None\r\n\t\t\r\n\tdef GetSolid(self):\r\n\t\ttokens = [[-1,-1], [-1, 1], [1, 1], [1, -1]]\r\n\t\tpoints = []\r\n\t\tdir1 = self.HostPars.Geom.XDir\r\n\t\tdir21 = self.AttachedElemsPars[0].Geom.XDir\r\n\t\tdir22 = self.AttachedElemsPars[0].Geom.YDir\r\n\t\tif VecABS(dir1).IsAlmostEqualTo(VecABS(dir21)):\r\n\t\t\tdir2 = dir22\r\n\t\t\tside = self.L[0]\r\n\t\telse:\r\n\t\t\tdir2 = dir21\r\n\t\t\tside = self.T[0]\r\n\t\tfor i in range(4):\r\n\t\t\tpoint = self.Origin + dir1*side/2*tokens[i][0] + dir2*(self.HostPars.Geom.T/2)*tokens[i][1]\r\n\t\t\tpoints.append(point)\r\n\t\tlines = []\r\n\t\tlines.append(Line.CreateBound(points[0], points[1]))\r\n\t\tlines.append(Line.CreateBound(points[1], points[2]))\r\n\t\tlines.append(Line.CreateBound(points[2], points[3]))\r\n\t\tlines.append(Line.CreateBound(points[3], points[0]))\r\n\t\tsolid = GeometryCreationUtilities.CreateExtrusionGeometry([CurveLoop.Create(lines)], XYZ.BasisZ, self.HostPars.Geom.H)\r\n\t\treturn solid\r\n\t\t\r\n\tdef GetOutline(self):\r\n\t\tdir1 = self.HostPars.Geom.XDir\r\n\t\tdir21 = self.AttachedElemsPars[0].Geom.XDir\r\n\t\tdir22 = self.AttachedElemsPars[0].Geom.YDir\r\n\t\tif VecABS(dir1).IsAlmostEqualTo(VecABS(dir21)):\r\n\t\t\tdir2 = dir22\r\n\t\t\tside = self.L[0]\r\n\t\telse:\r\n\t\t\tdir2 = dir21\r\n\t\t\tside = self.T[0]\r\n\t\tp0 = self.Origin - VecABS(dir1)*side/2 - VecABS(dir2)*self.HostPars.Geom.T/2\r\n\t\tp1 = self.Origin + VecABS(dir1)*side/2 + VecABS(dir2)*self.HostPars.Geom.T/2 + XYZ.BasisZ*self.HostPars.Geom.H\r\n\t\toutline = Outline(p0, p1)\r\n\t\treturn outline\r\n\t\t\t\t\r\nclass WallGeometryParameters:\r\n\tdef __init__(self, wall):\r\n\t\tself.T = wall.Width\r\n\t\tself.H = wall.Parameter[BuiltInParameter.WALL_USER_HEIGHT_PARAM].AsDouble()\t\t\r\n\t\tself.BotOffset = wall.Parameter[BuiltInParameter.WALL_BASE_OFFSET].AsDouble()\r\n\t\tself.BotLvlId = wall.Parameter[BuiltInParameter.WALL_BASE_CONSTRAINT].AsElementId()\r\n\t\tself.BotZ = doc.GetElement(self.BotLvlId).Elevation + (self.BotOffset)\r\n\t\tself.TopOffset = wall.Parameter[BuiltInParameter.WALL_TOP_OFFSET].AsDouble()\r\n\t\tself.TopLvlId = wall.Parameter[BuiltInParameter.WALL_HEIGHT_TYPE].AsElementId()\r\n\t\tself.TopZ = self.BotZ + self.H\r\n\t\tself.EndPoints = [wall.Location.Curve.GetEndPoint(0) + XYZ.BasisZ*(self.BotOffset), wall.Location.Curve.GetEndPoint(1) + XYZ.BasisZ*(self.BotOffset)]\r\n\t\tself.BotCenterLine = Line.CreateBound(self.EndPoints[0], self.EndPoints[1])\r\n\t\tself.TopCenterLine = Line.CreateBound(self.EndPoints[0] + XYZ.BasisZ*self.H, self.EndPoints[1] + XYZ.BasisZ*self.H)\r\n\t\tself.MiddleOrigin = self.BotCenterLine.Evaluate(0.5, True) + XYZ.BasisZ*self.H/2\r\n\t\tself.L = self.BotCenterLine.Length\t\r\n\t\tself.XDir = wall.Location.Curve.Direction.Normalize()\r\n\t\tself.YDir = wall.Orientation.Normalize()\t\t\r\n\t\tself.Solid = [geom for geom in list(wall.Geometry[opt]) if geom.GetType() == Solid and geom.Volume > 0][0]\r\n\t\tself.Faces = ElemFaces(self)\r\n\t\tself.CenterPlane = Plane.CreateByNormalAndOrigin(self.YDir, self.EndPoints[0])\r\n\t\tself.BottomPlane = Plane.CreateByNormalAndOrigin(XYZ.BasisZ, self.EndPoints[0])\r\n\t\tself.CuttingSolids = None\r\n\t\t\r\n\tdef GetStartSolid(self):\r\n\t\tp0 = self.EndPoints[0] - self.YDir*self.T/2\r\n\t\tp1 = p0 + XYZ.BasisZ*self.H\r\n\t\tp3 = self.EndPoints[1] - self.YDir*self.T/2\r\n\t\tp2 = p3 + XYZ.BasisZ*self.H\r\n\t\tlines = []\r\n\t\tlines.append(Line.CreateBound(p0, p1))\r\n\t\tlines.append(Line.CreateBound(p1, p2))\r\n\t\tlines.append(Line.CreateBound(p2, p3))\r\n\t\tlines.append(Line.CreateBound(p3, p0))\r\n\t\tsolid = GeometryCreationUtilities.CreateExtrusionGeometry([CurveLoop.Create(lines)], self.YDir, self.T)\r\n\t\treturn solid\r\n\t\t\r\n\tdef GetCuttingSolids(self):\r\n\t\tstartSolid = self.GetBBoxSolid()\r\n\t\tbruttoSolid = self.GetBruttoSolid()\r\n\t\tsolid = BooleanOperationsUtils.ExecuteBooleanOperation(startSolid, bruttoSolid, BooleanOperationsType.Difference)\r\n\t\tsolids = SolidUtils.SplitVolumes(solid)\r\n\t\treturn [bruttoSolid]\r\n\t\t\r\n\tdef GetParity(self):\r\n\t\trayOrigins = []\r\n\t\trayOrigins.append(self.EndPoints[0] + self.XDir*10/304.8)\r\n\t\trayOrigins.append(self.BotCenterLine.ComputeDerivatives(0.5, True).Origin)\r\n\t\trayOrigins.append(self.EndPoints[1] + self.XDir*10/304.8)\r\n\t\trayOrigins.append(self.TopCenterLine.GetEndPoint(0) + self.XDir*10/304.8)\r\n\t\trayOrigins.append(self.TopCenterLine.ComputeDerivatives(0.5, True).Origin)\r\n\t\trayOrigins.append(self.TopCenterLine.GetEndPoint(1) + self.XDir*10/304.8)\r\n#\t\trayOrigins.append(self.EndPoints[0] + self.XDir*10/304.8 - XYZ.BasisZ*(self.BotZ + 50000/304.8))\r\n#\t\trayOrigins.append(self.BotCenterLine.ComputeDerivatives(0.5, True).Origin - XYZ.BasisZ*(self.BotZ + 50000/304.8))\r\n#\t\trayOrigins.append(self.EndPoints[1] + self.XDir*10/304.8 - XYZ.BasisZ*(self.BotZ + 50000/304.8))\r\n\r\n\t\tmaxN = 0\r\n\t\tmaxI = 0\r\n\t\twallBranches = []\r\n\t\tfor i, origin in enumerate(rayOrigins):\r\n\t\t\twallBranches.append([])\r\n\t\t\twallBranches[-1] += intersector.Find(origin, -XYZ.BasisZ)  \r\n\t\t\twallBranches[-1] += intersector.Find(origin, XYZ.BasisZ)\r\n\t\t\tif maxN < len(wallBranches[-1]):\r\n\t\t\t\tmaxN = len(wallBranches[-1])\r\n\t\t\t\tmaxI = i\r\n\t\twallBranch = wallBranches[maxI]\r\n\t\tlevels = [doc.GetElement(doc.GetElement(rwc.GetReference()).LevelId) for rwc in wallBranch]\r\n\t\tlvlIds = sorted(list(set([lvl.Id.IntegerValue for lvl in levels])), key=SortByElevation)\r\n\t\ti = -1 + (lvlIds.index(self.BotLvlId.IntegerValue) % 2)*2\r\n\t\treturn i\r\n\t\t\r\nclass WallAnchor:\r\n\tdef __init__(self, rebar, wp):\r\n\t\tself.Reb = rebar\r\n\t\tline = rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)[0]\r\n\t\tself.RebLine = line\r\n\t\tself.XDir = rebar.GetShapeDrivenAccessor().Normal.Normalize()\r\n\t\tself.ZDir = line.Direction.Normalize()\r\n\t\tself.ZToken = self.ZDir.DotProduct(XYZ(1,1,1))\r\n\t\tif self.ZToken < 0:\r\n\t\t\tself.Origin = line.GetEndPoint(0)\r\n\t\telse:\r\n\t\t\tself.Origin = line.GetEndPoint(1)\t\r\n\t\tself.D = rebar.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()\r\n\t\tself.N = rebar.Quantity\r\n\t\tself.Type = 'OnRegion'\r\n\t\tself.AttachedElemsPars = None\r\n\t\tself.Partition = rebar.Parameter[BuiltInParameter.NUMBER_PARTITION_PARAM].AsString()\t\t\t\r\n\t\t\t\t\t\t\t\t\r\nclass WallReinforcement:\r\n\tdef __init__(self, wp):\r\n\t\tself.WP = wp\r\n\t\tself.Type = 'Wall'\r\n\t\twall = wp.Elem\r\n\t\tself.Elem = wall\r\n\t\tself.DX = wall.GetParameters('1Пп_Арм_Горизонтальная_Диаметр')[0].AsDouble()\r\n\t\tself.DY1 = wall.GetParameters('1Пп_Арм_Вертикальная_Диаметр 1')[0].AsDouble()\r\n\t\tself.DY2 = wall.GetParameters('1Пп_Арм_Вертикальная_Диаметр 2')[0].AsDouble()\r\n\t\tself.DY3 = wall.GetParameters('1Пп_Арм_Вертикальная_Диаметр 3')[0].AsDouble()\r\n\t\tself.DStud = wall.GetParameters('1Пп_Арм_Шпильки_Диаметр')[0].AsDouble()\r\n\t\tself.DStudS = self.DStud * 2.5\r\n\t\tself.DBinder = wall.GetParameters('1Пп_Арм_Хомуты_Диаметр')[0].AsDouble()\r\n\t\tself.StepX = wall.GetParameters('1Пп_Арм_Горизонтальная_Шаг')[0].AsDouble()\r\n\t\tself.StepY = wall.GetParameters('1Пп_Арм_Вертикальная_Шаг')[0].AsDouble()\r\n\t\tself.CovExt = doc.GetElement(wall.Parameter[BuiltInParameter.CLEAR_COVER_EXTERIOR].AsElementId()).CoverDistance\r\n\t\tself.CovInt = doc.GetElement(wall.Parameter[BuiltInParameter.CLEAR_COVER_INTERIOR].AsElementId()).CoverDistance\r\n\t\tif doc.GetElement(wall.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].AsElementId()):\r\n\t\t\tself.CovOth = doc.GetElement(wall.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].AsElementId()).CoverDistance\r\n\t\telse:\r\n\t\t\tself.CovOth = 0\r\n\t\tself.Wancs = None\r\n\t\tself.MidRebs = None\r\n\t\t\r\n\tdef GetRebarTypes(self):\t\r\n\t\tself.RebarTypeDX = self.GetRebarType(self.DX, 'А500С', 0)\r\n\t\tself.RebarTypeDXim = self.GetRebarType(self.DY1, 'А500С', 1)\r\n\t\tself.RebarTypeDY1 = self.GetRebarType(self.DY1, 'А500С', 0)\r\n\t\tself.RebarTypeDY2 = self.GetRebarType(self.DY2, 'А500С', 0)\r\n\t\tself.RebarTypeDY3 = self.GetRebarType(self.DY3, 'А500С', 0)\r\n\t\tself.RebarTypeDStud = self.GetRebarType(self.DStud, 'А240', 0)\r\n\t\tself.RebarTypeDBinder = self.GetRebarType(self.DBinder, 'А240', 0)\r\n\r\n\tdef GetRebarType(self, d, rClass, im):\r\n\t\tfor rt in FilteredElementCollector(doc).OfClass(RebarBarType).ToElements():\r\n\t\t\tname = rt.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString()\r\n\t\t\tdiameter = round(rt.Parameter[BuiltInParameter.REBAR_BAR_DIAMETER].AsDouble()*304.8)\r\n\t\t\tinMeteres = rt.get_Parameter(System.Guid('844a01e2-19fc-4dc5-baa0-a4bda30ef1f6')).AsInteger()\r\n\t\t\tif name.find(rClass) != -1 and diameter == round(d*304.8) and inMeteres == im and not name.split('_')[-1].isdigit():\r\n\t\t\t\tbreak\r\n\t\telse:\r\n\t\t\trt = RebarBarType.Create(doc)\r\n\t\t\tif im == 1:\r\n\t\t\t\tsuffix = '_ПМ'\r\n\t\t\telse:\r\n\t\t\t\tsuffix = ''\r\n\t\t\trt.Name = str(int(round(d*304.8))) + '-' + rClass + suffix\r\n\t\t\tSetRebarBarTypeParameters(rt, d, 0, rClass, im)\r\n\t\treturn rt\r\n\t\t\r\n\tdef UpdateRebarCoverType(self, align, covEnds):\r\n\t\tdst = align - self.DX\r\n\t\tfor rct1 in FilteredElementCollector(doc).OfClass(RebarCoverType).ToElements():\r\n\t\t\tif round(rct1.CoverDistance*304.8) == round(dst*304.8):\r\n\t\t\t\tbreak\r\n\t\telse:\r\n\t\t\trct1 = RebarCoverType.Create(doc, str(round(dst*304.8)), dst)\r\n\t\tfor rct2 in FilteredElementCollector(doc).OfClass(RebarCoverType).ToElements():\r\n\t\t\tif round(rct2.CoverDistance*304.8) == round(covEnds*304.8):\r\n\t\t\t\tbreak\r\n\t\telse:\r\n\t\t\trct2 = RebarCoverType.Create(doc, str(round(covEnds*304.8)), covEnds)\r\n\t\tif not self.Elem.Parameter[BuiltInParameter.CLEAR_COVER_EXTERIOR].IsReadOnly:\r\n\t\t\tself.Elem.Parameter[BuiltInParameter.CLEAR_COVER_EXTERIOR].Set(rct1.Id)\r\n\t\t\tself.CovExt = doc.GetElement(self.Elem.Parameter[BuiltInParameter.CLEAR_COVER_EXTERIOR].AsElementId()).CoverDistance\r\n\t\tif not self.Elem.Parameter[BuiltInParameter.CLEAR_COVER_INTERIOR].IsReadOnly:\r\n\t\t\tself.Elem.Parameter[BuiltInParameter.CLEAR_COVER_INTERIOR].Set(rct1.Id)\r\n\t\t\tself.CovInt = doc.GetElement(self.Elem.Parameter[BuiltInParameter.CLEAR_COVER_INTERIOR].AsElementId()).CoverDistance\r\n\t\tif not self.Elem.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].IsReadOnly:\r\n\t\t\tself.Elem.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].Set(rct2.Id)\r\n\t\t\tself.CovOth = doc.GetElement(self.Elem.Parameter[BuiltInParameter.CLEAR_COVER_OTHER].AsElementId()).CoverDistance\r\n\t\t\t\r\n\tdef GetWallAnchors(self):\r\n\t\twancs = []\t\r\n\t\tcurrentWP = self.WP\r\n\t\twhile not wancs:\r\n\t\t\tbotWPs = currentWP.HasBottomWalls()\t\t\r\n\t\t\tif not botWPs:\r\n\t\t\t\tbreak\r\n\t\t\trebarIds = botWPs[0].Elem.GetDependentElements(ElementClassFilter(Rebar))\r\n\t\t\tif not rebarIds:\r\n\t\t\t\tbreak\r\n\t\t\tfilter = BoundingBoxIntersectsFilter(currentWP.Contour)\r\n\t\t\tvRebars = list(FilteredElementCollector(doc, List[ElementId](rebarIds)).WherePasses(filter).ToElements())\t\t\r\n\t\t\tfilteredVRebars = []\r\n\t\t\tfor rebar in vRebars:\r\n\t\t\t\tline = rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)[0]\r\n\t\t\t\tfilters = []\r\n\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(line.GetEndPoint(0)))\r\n\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(line.GetEndPoint(1)))\r\n\t\t\t\tfilter = LogicalOrFilter(filters)\r\n\t\t\t\tif filter.PassesFilter(self.WP.Elem):\r\n\t\t\t\t\tfilteredVRebars.append(rebar)\t\t\t\t\r\n\t\t\tif filteredVRebars:\r\n\t\t\t\twancs = [WallAnchor(rebar, currentWP) for rebar in filteredVRebars]\r\n\t\t\t\tinters = currentWP.HasEndIntersections()\r\n\t\t\t\tends = currentWP.HasEnds()\r\n\t\t\t\tfor wanc in wancs:\r\n\t\t\t\t\tfor inter in inters:\r\n\t\t\t\t\t\tif inter:\r\n\t\t\t\t\t\t\tsolid = inter.GetSolid()\r\n\t\t\t\t\t\t\tspotlines = list(solid.IntersectWithCurve(wanc.RebLine, None))\r\n\t\t\t\t\t\t\tif spotlines:\r\n\t\t\t\t\t\t\t\twanc.Type = 'OnIntersection'\r\n\t\t\t\t\t\t\t\twanc.AttachedElemsPars = inter.AttachedElemsPars\r\n\t\t\t\t\tfor end in ends:\r\n\t\t\t\t\t\tif end:\r\n\t\t\t\t\t\t\tsolid = end.GetSolid()\r\n\t\t\t\t\t\t\tspotlines = list(solid.IntersectWithCurve(wanc.RebLine, None))\r\n\t\t\t\t\t\t\tif spotlines:\r\n\t\t\t\t\t\t\t\twanc.Type = 'OnEnd'\r\n\t\t\telse:\r\n\t\t\t\tcurrentWP = botWPs[0]\t\t\t\t\t\t\r\n\t\treturn wancs\t\t\r\n\t\r\n\tdef GetMiddleVRebars(self):\r\n\t\tmiddleVRebars = []\r\n\t\tcurrentWP = self.WP\r\n\t\twhile not middleVRebars:\r\n\t\t\tbotWPs = currentWP.HasBottomWalls()\t\t\r\n\t\t\tif not botWPs:\r\n\t\t\t\tbreak\r\n\t\t\trebarIds = botWPs[0].Elem.GetDependentElements(ElementClassFilter(Rebar))\r\n\t\t\tif not rebarIds:\r\n\t\t\t\tbreak\r\n\t\t\tfilter = BoundingBoxIntersectsFilter(currentWP.Contour)\r\n\t\t\tvRebars = list(FilteredElementCollector(doc, List[ElementId](rebarIds)).WherePasses(filter).ToElements())\t\t\t\r\n\t\t\tfor rebar in vRebars:\r\n\t\t\t\tline = rebar.GetCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)[0]\r\n\t\t\t\tfilters = []\r\n\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(line.GetEndPoint(0)))\r\n\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(line.GetEndPoint(1)))\r\n\t\t\t\tfilter = LogicalOrFilter(filters)\r\n\t\t\t\tif not filter.PassesFilter(self.WP.Elem):\r\n\t\t\t\t\tmiddleVRebars.append(rebar)\r\n\t\t\tif not middleVRebars:\r\n\t\t\t\tcurrentWP = botWPs[0]\r\n\t\treturn middleVRebars\r\n\t\t\r\nclass WallParameters:\r\n\tdef __init__(self, wall):\r\n\t\tself.Elem = wall\r\n\t\tself.Id = wall.Id.IntegerValue\r\n\t\tself.Geom = WallGeometryParameters(wall)\r\n\t\tself.Reinf = WallReinforcement(self)\r\n\t\tbClassPar = wall.GetParameters('1Пп_Класс бетона')[0]\r\n\t\tif bClassPar.StorageType == StorageType.Double:\r\n\t\t\tself.BClass = 'B' + str(int(round(bClassPar.AsDouble())))\r\n\t\telse:\r\n\t\t\tself.BClass = wall.GetParameters('1Пп_Класс бетона')[0].AsString()\r\n\t\tself.Regions = []\r\n\t\tself.Intersections = []\r\n\t\tself.Ends = []\r\n\t\tself.Openings = self.GetOpeningAndVoidParameters()[0]\r\n\t\tself.Voids = self.GetOpeningAndVoidParameters()[1]\r\n\t\tself.Phase = wall.Parameter[BuiltInParameter.PHASE_CREATED].AsElementId()\r\n\t\tself.Contour = Outline(wall.BoundingBox[doc.GetElement(intersector.ViewId)].Min, wall.BoundingBox[doc.GetElement(intersector.ViewId)].Max)\r\n\t\tif wall.GetParameters(IN[5][9]):\r\n\t\t\tself.Zone = wall.GetParameters(IN[5][9])[0].AsString()\r\n\t\telse:\r\n\t\t\tself.Zone = None\r\n\t\tif wall.GetParameters(IN[5][10]):\r\n\t\t\tself.Section = wall.GetParameters(IN[5][10])[0].AsString()\r\n\t\telse:\r\n\t\t\tself.Section = None\r\n\t\tself.Mark = wall.Parameter[BuiltInParameter.ALL_MODEL_MARK].AsString()\r\n\t\t\r\n\tdef HasBottomSlabs(self):\r\n\t\tfilter = ElementLevelFilter(self.Geom.BotLvlId)\r\n\t\tslabs = FilteredElementCollector(doc, List[ElementId](slabIds)).OfClass(Floor).WherePasses(filter).ToElements()\r\n\t\tcutLine = Line.CreateBound(self.Geom.BotCenterLine.GetEndPoint(0) - XYZ.BasisZ*10/304.8, self.Geom.BotCenterLine.GetEndPoint(1) - XYZ.BasisZ*10/304.8)\r\n\t\tsps = []\r\n\t\tfor slab in slabs:\r\n\t\t\tsp = SlabParameters(slab)\r\n\t\t\tsups = sp.GetSlabBottomSupports(self)\r\n\t\t\tif sups:\r\n\t\t\t\tsp.Supports = sups\r\n\t\t\t\tsps.append(sp)\r\n\t\treturn sps\r\n\t\t\r\n\tdef HasBottomWalls(self):\r\n\t\tpoints = [self.Geom.BotCenterLine.GetEndPoint(0) - XYZ.BasisZ*500/304.8, self.Geom.BotCenterLine.GetEndPoint(1) - XYZ.BasisZ*500/304.8]\r\n\t\tsortedPoints = SortPointsByCoords(points[0], points[1])\r\n\t\tcutLine = Line.CreateBound(sortedPoints[0], sortedPoints[1])\r\n\t\toutline = Outline(sortedPoints[0]-VecABS(self.Geom.YDir)*10/304.8, sortedPoints[1]+VecABS(self.Geom.YDir)*10/304.8)\r\n\t\tfilter = BoundingBoxIntersectsFilter(outline)\t\t\r\n#\t\ti = IN[8].index(self.Geom.BotLvlId.IntegerValue)-1\r\n#\t\tlvlId = ElementId(IN[8][i])\r\n#\t\tfilter = LogicalOrFilter(ElementLevelFilter(lvlId), ElementLevelFilter(self.Geom.BotLvlId))\r\n\t\twalls = FilteredElementCollector(doc, List[ElementId](wallIds)).WherePasses(filter).ToElements()\r\n#\t\tcutLine = Line.CreateBound(self.Geom.BotCenterLine.GetEndPoint(0) - XYZ.BasisZ*500/304.8, self.Geom.BotCenterLine.GetEndPoint(1) - XYZ.BasisZ*500/304.8)\r\n\t\twps = []\r\n\t\tfor wall in walls:\r\n\t\t\twp = WallParameters(wall)\r\n\t\t\tspotLines = list(wp.Geom.Solid.IntersectWithCurve(cutLine, None))\r\n\t\t\tif spotLines and VecABS(wp.Geom.XDir).IsAlmostEqualTo(VecABS(self.Geom.XDir)):\r\n\t\t\t\twps.append(wp)\r\n\t\treturn wps\t\t\r\n\t\t\r\n\tdef HasUpperSlabs(self):\r\n\t\tfilter = ElementLevelFilter(self.Geom.TopLvlId)\r\n\t\tslabs = FilteredElementCollector(doc, List[ElementId](slabIds)).OfClass(Floor).WherePasses(filter).ToElements()\r\n\t\tcutLine = Line.CreateBound(self.Geom.TopCenterLine.GetEndPoint(0) + XYZ.BasisZ*10/304.8, self.Geom.TopCenterLine.GetEndPoint(1) + XYZ.BasisZ*10/304.8)\r\n\t\tsps = []\r\n\t\tfor slab in slabs:\r\n\t\t\tsp = SlabParameters(slab)\r\n\t\t\tsups = sp.GetSlabSupports(self)\r\n\t\t\tif sups:\r\n\t\t\t\tsp.Supports = sups\r\n\t\t\t\tsps.append(sp)\r\n\t\treturn sps\r\n\t\t\r\n\tdef HasUpperColumns(self):\r\n\t\tfilter = ElementLevelFilter(self.Geom.TopLvlId)\r\n\t\tcolumns = FilteredElementCollector(doc, List[ElementId](columnIds)).WherePasses(filter).ToElements()\r\n\t\tcutLine = Line.CreateBound(self.Geom.TopCenterLine.GetEndPoint(0) + XYZ.BasisZ*300/304.8, self.Geom.TopCenterLine.GetEndPoint(1) + XYZ.BasisZ*300/304.8)\r\n\t\tcps = []\r\n\t\tfor column in columns:\r\n\t\t\tcp = ColumnParameters(column)\r\n\t\t\tspotLines = list(cp.Geom.Solid.IntersectWithCurve(cutLine, None))\r\n\t\t\tif spotLines and VecABS(cp.Geom.XDir).IsAlmostEqualTo(VecABS(self.Geom.XDir)):\r\n\t\t\t\tcps.append(cp)\r\n\t\treturn cps\r\n\t\t\r\n\tdef HasUpperWalls(self):\r\n\t\tpoints = [self.Geom.TopCenterLine.GetEndPoint(0) + XYZ.BasisZ*300/304.8, self.Geom.TopCenterLine.GetEndPoint(1) + XYZ.BasisZ*300/304.8]\r\n\t\tsortedPoints = SortPointsByCoords(points[0], points[1])\r\n\t\tcutLine = Line.CreateBound(sortedPoints[0], sortedPoints[1])\r\n\t\toutline = Outline(sortedPoints[0]-VecABS(self.Geom.YDir)*10/304.8, sortedPoints[1]+VecABS(self.Geom.YDir)*10/304.8)\r\n\t\tfilter = BoundingBoxIntersectsFilter(outline)\r\n#\t\tfilter = LogicalOrFilter(ElementLevelFilter(self.Geom.TopLvlId), ElementLevelFilter(self.Geom.BotLvlId))\r\n\t\twalls = FilteredElementCollector(doc, List[ElementId](wallIds)).WherePasses(filter).ToElements()\r\n\t\twps = []\r\n\t\tfor wall in walls:\r\n\t\t\twp = WallParameters(wall)\r\n\t\t\tspotLines = list(wp.Geom.Solid.IntersectWithCurve(cutLine, None))\r\n\t\t\tif spotLines and VecABS(wp.Geom.XDir).IsAlmostEqualTo(VecABS(self.Geom.XDir)):\r\n\t\t\t\twps.append(wp)\r\n\t\treturn wps\r\n\r\n\tdef HasMiddleIntersections(self):\r\n\t\tintersections = []\r\n\t\ttokens = [1, -1]\r\n\t\telemIds = list(wallIds) + list(columnIds)\r\n\t\telemIds.remove(ElementId(self.Id))\r\n\t\tlvlfilter = ElementLevelFilter(self.Geom.BotLvlId)\r\n#\t\tfilter = BoundingBoxIntersectsFilter(self.Contour)\t\t\r\n\t\telems = FilteredElementCollector(doc, List[ElementId](elemIds)).WherePasses(lvlfilter).ToElements()\t\t\r\n\t\tfor elem in elems:\r\n\t\t\twi = None\r\n\t\t\telp = None\r\n\t\t\tfor i in range(2):\r\n\t\t\t\tif elem.GetType() == Wall:\r\n\t\t\t\t\tjoinedElements = list(elem.Location.ElementsAtJoin[i])\t\t\r\n\t\t\t\t\tif joinedElements and self.Id in [wall.Id.IntegerValue for wall in joinedElements]:\r\n\t\t\t\t\t\totherWall = [wall for wall in joinedElements if wall.Id.IntegerValue != self.Id][0]\r\n\t\t\t\t\t\twp = WallParameters(otherWall)\r\n\t\t\t\t\t\tif not wp.Geom.EndPoints[i].IsAlmostEqualTo(self.Geom.EndPoints[0]) and not wp.Geom.EndPoints[i].IsAlmostEqualTo(self.Geom.EndPoints[1]) and lvlfilter.PassesFilter(otherWall) and round(wp.Geom.BotZ*304.8) == round(self.Geom.BotZ*304.8):\r\n\t\t\t\t\t\t\twi = WallIntersection([wp], self)\r\n\t\t\t\t\t\t\twi.Origin = wp.Geom.EndPoints[i]\t\t\t\t\t\t\t\r\n\t\t\t\t\telif not elp:\r\n\t\t\t\t\t\telp = WallParameters(elem)\t\r\n\t\t\t\telif not elp:\r\n\t\t\t\t\telp = ColumnParameters(elem)\r\n\t\t\t\tif elp:\r\n\t\t\t\t\tfilters = []\r\n\t\t\t\t\tif VecABS(elp.Geom.YDir).IsAlmostEqualTo(VecABS(self.Geom.XDir)) or elp.Elem.GetType() == Wall:\r\n\t\t\t\t\t\tdir1 = elp.Geom.XDir\r\n\t\t\t\t\t\tdir2 = elp.Geom.YDir\r\n\t\t\t\t\t\tpoints = elp.Geom.EndPoints\r\n\t\t\t\t\telif elp.Elem.GetType() == FamilyInstance:\r\n\t\t\t\t\t\tdir1 = elp.Geom.YDir\r\n\t\t\t\t\t\tdir2 = elp.Geom.XDir\r\n\t\t\t\t\t\tpoints = elp.Geom.EndPoints2\t\t\t\t\t\r\n\t\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(points[i] + dir1*IN[7]/304.8*tokens[i] - dir2*(elp.Geom.T/2+IN[7]/304.8) + XYZ.BasisZ*IN[7]/304.8))\r\n\t\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(points[i] + dir1*IN[7]/304.8*tokens[i] + dir2*(elp.Geom.T/2+IN[7]/304.8) + XYZ.BasisZ*IN[7]/304.8))\r\n\t\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(points[i] - dir1*IN[7]/304.8*tokens[i] - dir2*(elp.Geom.T/2+IN[7]/304.8) + XYZ.BasisZ*IN[7]/304.8))\r\n\t\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(points[i] - dir1*IN[7]/304.8*tokens[i] + dir2*(elp.Geom.T/2+IN[7]/304.8) + XYZ.BasisZ*IN[7]/304.8))\r\n\t\t\t\t\tdsts = [plane.Project(points[i])[1] for plane in GetUnboundFaces(self.Geom.Faces.Long) if plane.Project(points[i])]\t\t\t\t\t\r\n\t\t\t\t\tif dsts:\r\n\t\t\t\t\t\tdst = min(dsts)\r\n\t\t\t\t\telse:\r\n\t\t\t\t\t\tdst = 0\r\n\t\t\t\t\tif filters[0].PassesFilter(self.Elem) and filters[1].PassesFilter(self.Elem) and round(elp.Geom.BotZ*304.8) == round(self.Geom.BotZ*304.8) and not wi:\r\n\t\t\t\t\t\twi = WallIntersection([elp], self)\r\n\t\t\t\t\t\twi.Origin = points[i] + dir1*(self.Geom.T/2+dst)*tokens[i]\r\n\t\t\t\t\telif filters[2].PassesFilter(self.Elem) and filters[3].PassesFilter(self.Elem) and round(elp.Geom.BotZ*304.8) == round(self.Geom.BotZ*304.8) and not wi:\r\n\t\t\t\t\t\twi = WallIntersection([elp], self)\r\n\t\t\t\t\t\twi.Origin = points[i] - dir1*(self.Geom.T/2+dst)*tokens[i]\r\n\t\t\t\tif wi:\r\n\t\t\t\t\tfor k in [0, 0.5, 1]:\t\t\t\t\r\n\t\t\t\t\t\tcutLine = Line.CreateBound(wi.Origin, wi.Origin + XYZ.BasisZ*(10/304.8 + self.Geom.H*k))\r\n\t\t\t\t\t\tspotLines = list(self.Geom.Solid.IntersectWithCurve(cutLine, None))\r\n\t\t\t\t\t\tif spotLines:\r\n\t\t\t\t\t\t\twi.PlaceRebars = True\r\n\t\t\t\t\t\t\tbreak\r\n\t\t\t\t\tintersections.append(wi)\r\n\t\t\t\t\tbreak\t\t\t\t\t\r\n\t\treturn intersections\r\n\r\n\tdef HasEndIntersections(self):\r\n\t\tintersections = []\r\n\t\ttokens = [1, -1]\r\n\t\tlvlfilter = ElementLevelFilter(self.Geom.BotLvlId)\r\n\t\telemIds = FilteredElementCollector(doc, List[ElementId]( list(wallIds) + list(columnIds))).WherePasses(lvlfilter).ToElementIds()\r\n\t\tfor i in range(2):\r\n\t\t\twi = None\r\n\t\t\tjoinedElements = list(self.Elem.Location.ElementsAtJoin[i])\t\r\n\t\t\tif joinedElements:\t\t\r\n\t\t\t\totherWalls = [wall for wall in joinedElements if wall.Id.IntegerValue != self.Id and lvlfilter.PassesFilter(wall)]\r\n\t\t\t\twps = [WallParameters(wall) for wall in otherWalls]\r\n\t\t\t\tfilteredWPs = [wp for wp in wps if round(wp.Geom.BotZ*304.8) == round(self.Geom.BotZ*304.8)]\r\n\t\t\t\tif filteredWPs:\r\n\t\t\t\t\twi = WallIntersection(filteredWPs, self)\r\n\t\t\t\t\twi.Origin = self.Geom.EndPoints[i]\t\t\t\t\r\n\t\t\telse:\r\n\t\t\t\tfilters = []\r\n\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(self.Geom.EndPoints[i] + self.Geom.XDir*10/304.8*tokens[i] - self.Geom.YDir*(self.Geom.T/2+10/304.8) + XYZ.BasisZ*10/304.8))\r\n\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(self.Geom.EndPoints[i] + self.Geom.XDir*10/304.8*tokens[i] + self.Geom.YDir*(self.Geom.T/2+10/304.8) + XYZ.BasisZ*10/304.8))\r\n\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(self.Geom.EndPoints[i] - self.Geom.XDir*10/304.8*tokens[i] - self.Geom.YDir*(self.Geom.T/2+10/304.8) + XYZ.BasisZ*10/304.8))\r\n\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(self.Geom.EndPoints[i] - self.Geom.XDir*10/304.8*tokens[i] + self.Geom.YDir*(self.Geom.T/2+10/304.8) + XYZ.BasisZ*10/304.8))\r\n\t\t\t\tfilter1 = LogicalOrFilter([filters[0], filters[1]])\r\n\t\t\t\tfilter2 = LogicalOrFilter([filters[2], filters[3]])\r\n\t\t\t\totherElems = FilteredElementCollector(doc, List[ElementId](elemIds)).WherePasses(filter1).ToElements()\r\n\t\t\t\tif otherElems:\r\n\t\t\t\t\telps = [WallParameters(elem) for elem in otherElems if elem.GetType() == Wall] + [ColumnParameters(elem) for elem in otherElems if elem.GetType() == FamilyInstance]\r\n#\t\t\t\t\tfilteredELPs = [elp for elp in elps if round(elp.Geom.BotZ*304.8) == round(self.Geom.BotZ*304.8)]\r\n\t\t\t\t\twi = WallIntersection(elps, self)\r\n\t\t\t\t\twi.Origin = self.Geom.EndPoints[i] + self.Geom.XDir*elps[0].Geom.T/2*tokens[i]\r\n\t\t\t\telse:\r\n\t\t\t\t\totherElems = FilteredElementCollector(doc, List[ElementId](elemIds)).WherePasses(filter2).ToElements()\r\n\t\t\t\t\tif otherElems: \r\n\t\t\t\t\t\telps = [WallParameters(elem) for elem in otherElems if elem.GetType() == Wall] + [ColumnParameters(elem) for elem in otherElems if elem.GetType() == FamilyInstance]\r\n#\t\t\t\t\t\tfilteredELPs = [elp for elp in elps if round(elp.Geom.BotZ*304.8) == round(self.Geom.BotZ*304.8)]\r\n\t\t\t\t\t\twi = WallIntersection(elps, self)\r\n\t\t\t\t\t\twi.Origin = self.Geom.EndPoints[i] - self.Geom.XDir*elps[0].Geom.T/2*tokens[i]\r\n\t\t\tif wi:\t\t\t\t\r\n\t\t\t\tcutLine = Line.CreateBound(wi.Origin, wi.Origin + XYZ.BasisZ*10/304.8)\r\n\t\t\t\tspotLines = list(self.Geom.Solid.IntersectWithCurve(cutLine, None))\r\n\t\t\t\tif spotLines:\t\t\t\t\r\n\t\t\t\t\twi.PlaceRebars = True\r\n\t\t\tintersections.append(wi)\r\n\t\treturn intersections\r\n\t\t\r\n\tdef HasEnds(self):\r\n\t\tends = []\r\n\t\ttokens = [1, -1]\r\n\t\tfilter = ElementLevelFilter(self.Geom.BotLvlId)\r\n\t\telemIds = FilteredElementCollector(doc, List[ElementId]( list(wallIds) + list(columnIds))).WherePasses(filter).ToElementIds()\r\n\t\tfor i in range(2):\r\n\t\t\tend = None\r\n\t\t\tjoinedElements = list(self.Elem.Location.ElementsAtJoin[i])\r\n\t\t\tif not joinedElements:\r\n\t\t\t\tfilters = []\r\n\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(self.Geom.EndPoints[i] + self.Geom.XDir*10/304.8*tokens[i] - self.Geom.YDir*(self.Geom.T/2+10/304.8) + XYZ.BasisZ*10/304.8))\r\n\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(self.Geom.EndPoints[i] + self.Geom.XDir*10/304.8*tokens[i] + self.Geom.YDir*(self.Geom.T/2+10/304.8) + XYZ.BasisZ*10/304.8))\r\n\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(self.Geom.EndPoints[i] - self.Geom.XDir*10/304.8*tokens[i] - self.Geom.YDir*(self.Geom.T/2+10/304.8) + XYZ.BasisZ*10/304.8))\r\n\t\t\t\tfilters.append(BoundingBoxContainsPointFilter(self.Geom.EndPoints[i] - self.Geom.XDir*10/304.8*tokens[i] + self.Geom.YDir*(self.Geom.T/2+10/304.8) + XYZ.BasisZ*10/304.8))\r\n\t\t\t\tfilter1 = LogicalOrFilter([filters[0], filters[1]])\r\n\t\t\t\tfilter2 = LogicalOrFilter([filters[2], filters[3]])\r\n\t\t\t\totherElems1 = FilteredElementCollector(doc, List[ElementId](elemIds)).WherePasses(filter1).ToElements()\r\n\t\t\t\totherElems2 = FilteredElementCollector(doc, List[ElementId](elemIds)).WherePasses(filter2).ToElements()\r\n\t\t\t\tif not otherElems1 and not otherElems2:\r\n\t\t\t\t\tend = WallEnd(self)\r\n\t\t\t\t\tend.Origin = self.Geom.EndPoints[i]\r\n\t\t\t\t\tend.XDir = self.Geom.XDir*tokens[i]\r\n\t\t\tends.append(end)\r\n\t\treturn ends\r\n\t\t\r\n\tdef HasOutsideFace(self):\r\n\t\tfor face in self.Geom.Faces.Long:\r\n\t\t\tuvs = []\r\n\t\t\tuvs.append(UV(10/304.8, 10/304.8))\r\n\t\t\tuvs.append(UV(self.Geom.BotCenterLine.Length/2, 10/304.8))\r\n\t\t\tuvs.append(UV(self.Geom.BotCenterLine.Length-10/304.8, 10/304.8))\r\n\t\t\tnormal = face.FaceNormal.Normalize()\r\n\t\t\tfor uv in uvs:\r\n\t\t \t\torigin = face.Evaluate(uv)\r\n\t\t\t\ttargets = intersector.FindNearest(origin, normal)\r\n\t\t\t\tif not targets:\r\n\t\t\t\t\treturn face\r\n\t\telse:\r\n\t\t\treturn None\r\n\t\t\t\t\t\t\r\n\tdef GetOpeningAndVoidParameters(self):\r\n\t\tfilters = []\r\n\t\tfilters.append(ElementClassFilter(FamilyInstance))\r\n\t\tfilters.append(ElementCategoryFilter(BuiltInCategory.OST_Windows))\r\n\t\tfilters.append(ElementCategoryFilter(BuiltInCategory.OST_Doors))\r\n\t\tfilter = LogicalAndFilter(filters[0], LogicalOrFilter(filters[1], filters[2]))\r\n\t\tallOpenings = [doc.GetElement(id) for id in self.Elem.GetDependentElements(filter) if doc.GetElement(id).Symbol.FamilyName.find('231') == 0]\r\n\t\topenings = [open for open in allOpenings if open.Symbol.FamilyName.find('тверсти') != -1]\r\n\t\tvoids = [open for open in allOpenings if open.Symbol.FamilyName.find('проем') != -1]\r\n\t\treturn [OpeningParameters(self, open) for open in openings], [VoidParameters(self, void) for void in voids]\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nWPars = [WallParameters(wall) for wall in walls if wall.GetParameters('Тип армирования') and  wall.GetParameters('Тип армирования')[0].AsElementId()]\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = WPars",
