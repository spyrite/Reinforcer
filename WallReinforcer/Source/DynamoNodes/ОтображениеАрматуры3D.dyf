          "Description": "Обозначение",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Параметр функции, использовать с пользовательскими узлами.\r\n\r\nМожно указать тип и значение параметра по умолчанию. Например,\r\n\r\nввод: var [], [].\r\nзначение: bool = false"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nelems = UnwrapElement(IN[0])\r\n\r\nrebarFilter = LogicalOrFilter([ElementClassFilter(Rebar), ElementClassFilter(RebarInSystem), ElementClassFilter(RebarContainer)])\r\nview = doc.ActiveView\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nif view.GetType() == View3D:\r\n\tfor elem in elems:\r\n\t\tif rebarFilter.PassesFilter(elem):\t\r\n\t\t\telem.SetSolidInView(view, True)\r\n\t\t\telem.SetUnobscuredInView(view, True)\r\n\t\t\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = ''",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "ce3e254d61974e9c86e61a5974fac957",
