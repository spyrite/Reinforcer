{
  "Uuid": "881896af-2c6e-41ce-a95c-1e23ef6f7093",
  "IsCustomNode": true,
  "Category": "1П.Ведомости и спецификации",
  "Description": "Создаёт спецификацию элементов сборки с арматурными стержнями по заданному имени шаблона спецификации. Указывает в имени сборки количество строк спецификации (опционально).",
  "Name": "СозданиеСпецификацииДляАрматурныхСборок",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nimport System\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ndef ByNRows(at):\r\n\tn = int(at.Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsString().split('_')[1])\r\n\treturn n\r\n\r\ndef ByPrefix(at):\r\n\treturn at.Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsString().split('_')[-1].split('-')[0]\r\n\t\t\r\ndef ByNMark(at):\r\n\treturn round(float(at.Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsString().split('_')[-1].split('-')[1]), 2)\r\n\t\r\ndef HasSuffix(at):\r\n\tmark = at.Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsString().split('_')[-1]\r\n\tif len(mark.split('-')) > 2 or len(mark.split(' ')) > 1:\r\n\t\treturn 1\r\n\telse:\r\n\t\treturn 0\r\n\r\ndef GetSuffix(at):\r\n\tmark = at.Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsString().split('_')[-1]\r\n\tif len(mark.split('-')) > 2:\t\r\n\t\tsuffix = '-' + mark.split('-')[-1]\r\n\telif len(mark.split(' ')) > 1:\r\n\t\tsuffix = ' ' + mark.split(' ')[-1]\r\n\telse:\r\n\t\tsuffix = ''\r\n\treturn suffix\r\n\t\r\ndef HasSchedules(at):\r\n\tscheduleIds = list(at.GetDependentElements(ElementClassFilter(ViewSchedule)))\r\n\tif scheduleIds:\r\n\t\treturn True\r\n\telse:\r\n\t\treturn False\r\n\r\nATs = UnwrapElement(IN[0])\r\nfirstAIs = [[doc.GetElement(id) for id in at.GetDependentElements(ElementClassFilter(AssemblyInstance))][0] for at in ATs]\r\nviewTemps = [schedule for schedule in FilteredElementCollector(doc).OfClass(ViewSchedule).ToElements() if schedule.IsTemplate and schedule.Name.find(IN[1]) == 0]\r\nviewTemp = viewTemps[0]\r\n\r\nrebarCat = Category.GetCategory(doc, BuiltInCategory.OST_Rebar)\r\n\t\r\nschedules = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor ai in firstAIs:\r\n\tat = doc.GetElement(ai.GetTypeId())\r\n\tatOldName = at.Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsString()\r\n\tif not HasSchedules(at) and len(atOldName.split('_')) == 2 and not HasSuffix(at):\r\n\t\tschedule = AssemblyViewUtils.CreateSingleCategorySchedule(doc, ai.Id, rebarCat.Id, viewTemp.Id, True)\r\n\t\tdoc.Regenerate()\r\n\t\tif IN[2]:\r\n\t\t\tnRows = schedule.GetTableData().GetSectionData(SectionType.Body).NumberOfRows\r\n\t\t\tatNewName = atOldName.split('_')[0] + '_' + str(nRows) + '_' + atOldName.split('_')[-1]\r\n\t\t\tat.Name = atNewName\r\n\t\tschedules.append(schedule)\r\n\r\nnames = []\r\n\r\nif IN[2]:\r\n\tATs = sorted(sorted(sorted(sorted(ATs, key=HasSuffix), key=ByNMark), key=ByNRows), key=ByPrefix)\r\n\tprefixes = set([ByPrefix(at) for at in ATs])\r\n\tfor prefix in prefixes:\r\n\t\tatsOfPrefix = [at for at in ATs if ByPrefix(at) == prefix]\r\n\t\tkeys = []\r\n\t\tfor at in atsOfPrefix:\r\n\t\t\tkey = [ByNMark(at), ByNRows(at)]\r\n\t\t\tif key not in keys:\r\n\t\t\t\tkeys.append(key)\r\n\t\trenamedAtIds = []\r\n\t\tfor i, key in enumerate(keys):\r\n\t\t\tfor at in atsOfPrefix:\r\n\t\t\t\tif at.Id.IntegerValue not in renamedAtIds and ByNMark(at) == key[0] and ByNRows(at) == key[1]:\r\n\t\t\t\t\tatOldName = at.Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsString()\r\n\t\t\t\t\tatNewName = str(atOldName.split('_')[0] + '_' + prefix + '-' + str(i+1) + GetSuffix(at))\r\n\t\t\t\t\tnames.append(['Было: ' + atOldName, 'Стало: ' + atNewName])\r\n\t\t\t\t\trenamedAtIds.append(at.Id.IntegerValue)\r\n\t\t\t\t\tat.Name = atNewName\r\n\t\t\t\t\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = names",
