    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nimport math\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef GetViewDirectionByElemNormal(elp):\r\n\tangle = XYZ.BasisX.AngleOnPlaneTo(elp.Geom.YDir, XYZ.BasisZ)\r\n\ttest.append(angle)\r\n\tif 0 < angle <= math.pi:\r\n\t\treturn elp.Geom.YDir\r\n\telse:\r\n\t\treturn -elp.Geom.YDir\r\n\t\r\ndef SetViewParameters(view):\r\n\tif elp.Mark:\r\n\t\tname = IN[2][2] + '_' + elp.Mark + '_Опалубочный чертеж - Сечение 1'\r\n\t\tif name not in uniqueViewNames:\r\n\t\t\tview.Name = name\r\n\t\t\tview.Parameter[BuiltInParameter.VIEW_DESCRIPTION].Set(groupName[elp.Mark.split('-')[0]][2] + ' ' + elp.Mark)\r\n\t\t\tuniqueViewNames.append(name)\r\n\tif template and not view.Parameter[BuiltInParameter.VIEW_TEMPLATE].IsReadOnly:\r\n\t\tview.Parameter[BuiltInParameter.VIEW_TEMPLATE].Set(template.Id)\t\t\r\n\tif not view.Parameter[BuiltInParameter.PHASE_CREATED].IsReadOnly:\r\n\t\tview.Parameter[BuiltInParameter.VIEW_PHASE].Set(elp.Phase)\t\r\n\tview.Parameter[BuiltInParameter.VIEWER_CROP_REGION_VISIBLE].Set(0)\r\n\tif view.GetParameters(IN[3][0]) and not view.GetParameters(IN[3][0])[0].IsReadOnly:\r\n\t\tview.GetParameters(IN[3][0])[0].Set(IN[2][2])\r\n\t\r\ndef HideNonHostEmbs(view):\r\n\tembIdsToHide = []\r\n\tembs = [elem for elem in FilteredElementCollector(doc, view.Id).WherePasses(embFilter).ToElements() if elem.Symbol.FamilyName.find('220') == 0]\r\n\tfor emb in embs:\r\n\t\tfilter = BoundingBoxContainsPointFilter(emb.GetTransform().Origin - (10/304.8)*emb.GetTransform().BasisZ)\r\n\t\tif not filter.PassesFilter(elp.Elem):\r\n\t\t\tembIdsToHide.append(emb.Id)\r\n\t\t\tembIdsToHide += list(emb.GetSubComponentIds())\r\n\tif embIdsToHide:\r\n\t\tview.HideElements(List[ElementId](embIdsToHide))\r\n\t\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nELPs = IN[0]\r\n\r\ntemplates = [view for view in FilteredElementCollector(doc).OfClass(View).ToElements() if view.IsTemplate == True and view.Name == IN[2][0]]\r\ntemplate = templates[0] if templates else None\r\nviewSectionType = [type for type in FilteredElementCollector(doc).OfClass(ViewFamilyType).ToElements() if type.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString() == IN[2][1]][0]\r\n\r\nembFilter = LogicalAndFilter(ElementClassFilter(FamilyInstance), LogicalOrFilter(ElementCategoryFilter(BuiltInCategory.OST_Rebar), ElementCategoryFilter(BuiltInCategory.OST_GenericModel)))\r\n\r\ncreatedViews = []\r\nuniqueViewNames = []\r\noffsets = [dim/304.8 for dim in IN[1]]\r\n\r\ngroupName = IN[4]\r\n\r\ntest = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor i, elp in enumerate(ELPs):\r\n\t\r\n\tsectionBox = BoundingBoxXYZ()\r\n\t\r\n\ttransform = sectionBox.Transform\r\n\ttransform.BasisY = -GetViewDirectionByElemNormal(elp)\r\n\ttransform.BasisZ = -XYZ.BasisZ\r\n\ttransform.BasisX = transform.BasisY.CrossProduct(transform.BasisZ)\r\n\ttransform.Origin = elp.Geom.MiddleOrigin - transform.BasisZ*offsets[3]\r\n\t\r\n\tsectionBox.Transform = transform\r\n\t\r\n\tfor dim in range(3):\r\n\t\tsectionBox.MinEnabled[dim] = True\t\r\n\t\tsectionBox.MaxEnabled[dim] = True\r\n\t\r\n\tsectionBox.Min = -XYZ.BasisX*(elp.Geom.L/2+offsets[0]) - XYZ.BasisY*(elp.Geom.T/2+offsets[1])\r\n\tsectionBox.Max = XYZ.BasisX*(elp.Geom.L/2+offsets[0]) + XYZ.BasisY*(elp.Geom.T/2+offsets[2]) + XYZ.BasisZ*(offsets[3]+offsets[4])\r\n\r\n\tview = ViewSection.CreateSection(doc, viewSectionType.Id, sectionBox)\r\n\tSetViewParameters(view)\r\n\tHideNonHostEmbs(view)\r\n\t\r\n\tcreatedViews.append(view)\r\n\tdoc.Regenerate()\r\n\t\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = createdViews",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
