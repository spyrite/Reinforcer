  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nimport math\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndef ByMark(vp):\r\n\treturn vp.ElemMark\r\n\r\nclass CropBoxParameters:\r\n\tdef __init__(self, box, dirs):\r\n\t\tself.Dirs = dirs\r\n\t\tself.Origin = box.Transform.OfPoint(box.Min)\r\n\t\tself.Token = IN[1]\r\n\t\tself.Diagonal = box.Transform.OfPoint(box.Max) - box.Transform.OfPoint(box.Min)\r\n\t\tself.DiagonalL = box.Min.DistanceTo(box.Max)\r\n\t\tself.DiagonalLine = Line.CreateBound(box.Transform.OfPoint(box.Min), box.Transform.OfPoint(box.Max))\r\n\t\tself.L = self.DiagonalL*math.cos(self.Diagonal.AngleTo(dirs[0]*self.Token))\r\n\t\tself.B = self.DiagonalL*math.cos(self.Diagonal.AngleTo(dirs[1]))\r\n\t\tself.H = self.DiagonalL*math.cos(self.Diagonal.AngleTo(dirs[2]))\r\n\t\tself.BotLine = Line.CreateBound(self.Origin, self.Origin + dirs[0]*self.L*self.Token)\r\n\t\tself.LeftLine = Line.CreateBound(self.Origin, self.Origin + dirs[1]*self.B)\r\n\t\tself.TopLine = self.BotLine.CreateTransformed(Transform.CreateTranslation(dirs[1]*self.B))\r\n\t\tself.RightLine = self.LeftLine.CreateTransformed(Transform.CreateTranslation(dirs[0]*self.L*self.Token))\r\n\t\tself.FrontPlane = Plane.CreateByOriginAndBasis(self.Origin, dirs[0], dirs[1])\r\n\t\tself.Centroid = self.DiagonalLine.Evaluate(0.5, True)\r\n\t\tself.CenterPlane = Plane.CreateByOriginAndBasis(self.Centroid, dirs[0], dirs[1])\r\n\t\tself.CentroidDepthLine = Line.CreateBound(self.Centroid - dirs[2]*self.H/2, self.Centroid + dirs[2]*self.H/2)\r\n\t\tself.CentroidOutline = Outline(self.Centroid - dirs[2]*self.H/2, self.Centroid + dirs[2]*self.H/2 + dirs[1]*10/304.8)\r\n\t\tif self.CentroidOutline.IsEmpty:\r\n\t\t\tself.CentroidOutline = Outline(self.Centroid - dirs[2]*self.H/2, self.Centroid + dirs[2]*self.H/2 - dirs[1]*10/304.8)\r\n\t\tself.CentroidDepthLineUnbound = Line.CreateUnbound(self.Centroid, dirs[2])\r\n\t\t\r\n\tdef CreateViewSolid(self, dst):\t\t\r\n\t\tpoints = []\r\n\t\tpoints.append(self.Origin + self.Dirs[2]*self.H)\r\n\t\tpoints.append(points[-1] + self.Dirs[1]*self.B)\r\n\t\tpoints.append(points[-1] + self.Dirs[0]*self.L)\r\n\t\tpoints.append(points[-1] - self.Dirs[1]*self.B)\r\n\t\tlines = [Line.CreateBound(points[i-1], points[i]) for i in range(4)]\r\n\t\tcl = CurveLoop.Create(lines)\t\t\r\n\t\tsolid = GeometryCreationUtilities.CreateExtrusionGeometry([cl], -self.Dirs[2], dst)\r\n\t\treturn solid\r\n\t\t\r\nclass ViewCollectors:\r\n\tdef __init__(self, view):\r\n\t\tself.Floors = FilteredElementCollector(doc, view.Id).OfClass(Floor)\r\n\t\tself.Walls = FilteredElementCollector(doc, view.Id).OfClass(Wall)\r\n\t\tself.Columns = FilteredElementCollector(doc, view.Id).OfClass(FamilyInstance).OfCategory(BuiltInCategory.OST_StructuralColumns)\r\n\t\tself.Framing = FilteredElementCollector(doc, view.Id).OfClass(FamilyInstance).OfCategory(BuiltInCategory.OST_StructuralFraming)\r\n\t\tself.GenericModel = FilteredElementCollector(doc, view.Id).OfClass(FamilyInstance).OfCategory(BuiltInCategory.OST_GenericModel)\t\t\r\n\t\tself.Union = self.Floors\r\n\t\t[self.Union.UnionWith(collector) for collector in [self.Walls, self.Columns, self.Framing, self.GenericModel]]\r\n\t\tself.Rebars = FilteredElementCollector(doc, view.Id).WherePasses(LogicalOrFilter(ElementClassFilter(Rebar), ElementClassFilter(RebarInSystem)))\r\n\t\tself.Containers = FilteredElementCollector(doc, view.Id).OfClass(RebarContainer)\r\n\t\t\r\nclass ViewParameters:\r\n\tdef __init__(self, view):\r\n\t\tself.View = view\r\n\t\tself.Name = view.Name\r\n\t\tself.ElemMark = view.Name.split('_')[-1]\r\n\t\tself.Dirs = [view.RightDirection, view.UpDirection, view.ViewDirection]\r\n\t\tself.CropBox = CropBoxParameters(view.CropBox, self.Dirs)\r\n\t\tself.Scale = view.Scale/100\r\n\t\tself.Collectors = ViewCollectors(view)\r\n\t\tself.ViewportSheetName = view.Parameter[BuiltInParameter.VIEWPORT_SHEET_NAME].AsString() if view.Parameter[BuiltInParameter.VIEWPORT_SHEET_NAME].HasValue else ''\r\n\t\tself.MainElement = None\r\n\t\t\r\n\tdef ShouldHideGridBubbles(self):\r\n\t\tcondition1 = not self.Dirs[2].IsAlmostEqualTo(XYZ.BasisZ) and not self.Dirs[2].IsAlmostEqualTo(-XYZ.BasisZ)\r\n\t\tcondition2 = not self.Name.find('рмирован')\r\n\t\tif condition1 and condition2:\r\n\t\t\treturn True\r\n\t\telse:\r\n\t\t\treturn False\r\n\t\t\t\r\n\tdef GetMainElementFromView(self, elems):\r\n\t\toptForElems = Options()\r\n\t\tfor elem in elems:\r\n\t\t\tif elem.GetType() == FamilyInstance and elem.Symbol.Family.IsInPlace:\r\n\t\t\t\tgeomInst = [geom for geom in list(elem.Geometry[optForElems]) if geom.GetType() == GeometryInstance][0]\r\n\t\t\t\tsolid = [geom for geom in geomInst.GetInstanceGeometry() if geom.GetType() == Solid and geom.Volume > 0][0]\r\n\t\t\telse:\r\n\t\t\t\tsolid = [geom for geom in list(elem.Geometry[optForElems]) if geom.GetType() == Solid and geom.Volume > 0][0]\r\n\t\t\tvoids = [doc.GetElement(id) for id in elem.GetDependentElements(voidFilter)]\r\n\t\t\tfor i in [[0, 0], [-0.25, 0], [0.25, 0], [0, -0.25], [0, 0.25]]:\r\n\t\t\t\ttransform = Transform.CreateTranslation(self.Dirs[0]*self.CropBox.L*i[0] + self.Dirs[1]*self.CropBox.H*i[-1])\r\n\t\t\t\tline = self.CropBox.CentroidDepthLine.CreateTransformed(transform)\r\n\t\t\t\tfilter = LogicalOrFilter([BoundingBoxContainsPointFilter(line.Evaluate(j*0.1, True)) for j in range(10)])\r\n\t\t\t\tif list(solid.IntersectWithCurve(line, None)) or [void for void in voids if filter.PassesFilter(void)]:\r\n\t\t\t\t\tself.MainElement = elem\r\n\t\t\t\t\treturn elem\r\n\t\telse:\r\n\t\t\treturn None\t\r\n\t\t\t\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nfilter1 = LogicalAndFilter(ElementClassFilter(FamilyInstance), ElementCategoryFilter(BuiltInCategory.OST_Windows))\r\nfilter2 = LogicalAndFilter(ElementClassFilter(FamilyInstance), ElementCategoryFilter(BuiltInCategory.OST_Doors))\r\nvoidFilter = LogicalOrFilter(filter1, filter2)\r\n\r\nviews = UnwrapElement(IN[0])\r\n\r\nVPs = [ViewParameters(view) for view in views]\r\n\r\nOUT = VPs",
