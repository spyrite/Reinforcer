          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1e147e9f3b2c40c3bc52250947f0f53d",
          "Name": "RCPs",
          "Description": "Параметры контейнеров",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Проверяет и корректирует хост арматурных стержней или арматурных контейнеров."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef GetPartitionName(rcp):\r\n\tcondition1 = rcp.Host.GetType() == FamilyInstance\r\n\tif condition1:\r\n\t\tcondition2 = rcp.Host.Symbol.GetParameters('1П_Размер_Ширина')\r\n\t\tcondition3 = rcp.Host.Symbol.GetParameters('1П_Размер_Высота')\r\n\telse:\r\n\t\tcondition2 = False\r\n\t\tcondition3 = False\r\n\tif condition1 and condition2 and condition3:\r\n\t\thostB = rcp.Host.Symbol.GetParameters('1П_Размер_Ширина')[0].AsValueString()\r\n\t\thostH = rcp.Host.Symbol.GetParameters('1П_Размер_Высота')[0].AsValueString()\r\n\t\tsuffix = '_' + hostB + 'x' + hostH + '(h)'\r\n\telse:\r\n\t\tsuffix = ''\r\n\treturn '04_Выпуски' + suffix\r\n\t\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nRCPs = IN[0]\t\r\nextractedRebars = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor rcp in RCPs:\r\n\tpartitionName = GetPartitionName(rcp)\r\n\tfor rp in rcp.RPs:\t\r\n\t\trebar = Rebar.CreateFromCurvesAndShape(doc, rp.Shape, rp.BarType, rp.Hooks[0][0], rp.Hooks[0][1], rcp.Host, rp.Normal, rp.Lines, rp.Hooks[1][0], rp.Hooks[1][1])\r\n\t\tif not rebar:\r\n\t\t\trebar = Rebar.CreateFromCurves(doc, rp.Style, rp.BarType, rp.Hooks[0][0], rp.Hooks[0][1], rcp.Host, rp.Normal, rp.Lines, rp.Hooks[1][0], rp.Hooks[1][1], True, True)\r\n\t\tif rebar:\t\r\n\t\t\trp.SetLayoutRuleForRebar(rebar)\t\r\n\t\t\trebar.Parameter[BuiltInParameter.PHASE_CREATED].Set(rcp.PhaseId)\r\n\t\t\trebar.Parameter[BuiltInParameter.NUMBER_PARTITION_PARAM].Set(partitionName)\r\n\t\textractedRebars.append(rebar)\r\n\tdoc.Delete(rcp.Elem.Id)\r\n\t\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = extractedRebars",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
