    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import math\r\nimport clr\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef DivideVisibleInvisibleRebarIds(rebars, wall, vp):\r\n\tsolid = vp.CropBox.CreateViewSolid(vp.CropBox.H/2)\r\n\tvisibleRebarIds = []\r\n\tfor rebar in rebars:\r\n\t\tcenterLines = rebar.GetTransformedCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)\r\n\t\tfor line in centerLines:\r\n\t\t\tcutLines = list(solid.IntersectWithCurve(line, None))\r\n\t\t\tif cutLines:\r\n\t\t\t\tvisibleRebarIds.append(rebar.Id.IntegerValue)\r\n\t\t\t\tbreak\r\n\tinvisibleRebarIds = [rebar.Id for rebar in rebars if rebar.Id.IntegerValue not in visibleRebarIds]\r\n\treturn [ElementId(intId) for intId in visibleRebarIds], invisibleRebarIds\r\n\r\ndef RebarIsOutOfViewPlane(rebar, vp):\r\n\tlines = rebar.GetTransformedCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)\r\n\tfor line in lines:\r\n\t\tangle = round(line.Direction.AngleTo(vp.Dirs[2]), 3)\r\n\t\tif not angle == round(math.pi/2, 3) and not angle == round(math.pi/2, 3):\r\n\t\t\treturn True\r\n\telse:\r\n\t\treturn False\r\n\r\ndef CreateRebarBounds(rebar, vp):\r\n\tview = vp.View\r\n\tcondition1 = doc.GetElement(rebar.GetShapeId()).SimpleLine\r\n\tcondition2 = not RebarIsOutOfViewPlane(rebar, vp)\r\n\tcondition3 = not doc.GetElement(rebar.GetShapeId()).Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsString().find('_Ш') != -1\r\n\tcondition4 = not doc.GetElement(rebar.GetShapeId()).Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsString().find('_Хм') != -1\r\n\tlines = []\r\n\tif condition1 and condition2:\r\n\t\trebar.SetPresentationMode(view, RebarPresentationMode.All)\r\n\t\tdoc.Regenerate()\r\n\t\tlines = [rebar.GetTransformedCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, i)[0] for i in [0, rebar.Quantity-1]]\r\n\t\tlines += [Line.CreateBound(lines[0].GetEndPoint(i), lines[-1].GetEndPoint(i)) for i in range(2)]\r\n\t\tfor line in lines:\r\n\t\t\tdLine = doc.Create.NewDetailCurve(view, line)\t\r\n\t\t\tdLine.LineStyle = rebarBoundStyle\r\n\t\trebar.SetPresentationMode(view, RebarPresentationMode.Middle)\r\n\telif condition3 and condition4:\r\n\t\trebar.SetPresentationMode(view, RebarPresentationMode.Select)\r\n\t\tfor i in range(rebar.Quantity):\r\n\t\t\tif i == 0 or i == rebar.Quantity - 1 or i == int(round(float(rebar.Quantity - 1)/2)):\r\n\t\t\t\trebar.SetBarHiddenStatus(view, i, False)\r\n\t\t\telse:\r\n\t\t\t\trebar.SetBarHiddenStatus(view, i, True)\r\n\treturn lines\r\n\r\ndef SetRebarSecondaryGraphics(rebar, view):\r\n\trebOverrides = view.GetElementOverrides(rebar.Id)\r\n\trebOverrides.SetHalftone(True)\r\n\trebOverrides.SetSurfaceForegroundPatternVisible(False)\r\n\trebOverrides.SetSurfaceBackgroundPatternVisible(False)\r\n\trebOverrides.SetCutForegroundPatternVisible(False)\r\n\trebOverrides.SetCutBackgroundPatternVisible(False)\r\n\trebOverrides.SetProjectionLineWeight(2)\r\n\trebOverrides.SetProjectionLinePatternId(dashedLinePattern.Id)\r\n\tview.SetElementOverrides(rebar.Id, rebOverrides)\r\n\t\t\t\t\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nVPs = IN[0]\r\nmainElements = UnwrapElement(IN[3])\r\n\r\ndefOverrides = OverrideGraphicSettings()\r\ndashedLinePattern = LinePatternElement.GetLinePatternElementByName(doc, IN[1])\r\nrebarBoundStyle = [gs for gs in FilteredElementCollector(doc).OfClass(GraphicsStyle).ToElements() if gs.Name == IN[2]][0]\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor i, vp in enumerate(VPs):\r\n\tmainWall = mainElements[i]\r\n\tif mainWall:\r\n\t\trebars = vp.Collectors.Rebars.ToElements()\r\n\t\trebarIdSets = DivideVisibleInvisibleRebarIds(rebars, mainWall, vp)\r\n\t\tvp.View.HideElements(List[ElementId](rebarIdSets[1]))\r\n\t\t\r\n\t\tfilter = LogicalAndFilter(ElementClassFilter(Rebar), ElementIdSetFilter(List[ElementId](rebarIdSets[0])))\r\n\t\tmainWallRebars = [doc.GetElement(id) for id in mainWall.GetDependentElements(filter)]\r\n\t\t[CreateRebarBounds(rebar, vp) for rebar in mainWallRebars if rebar.Quantity > 2]\t\t\r\n\t\t\t\t\r\n\t\totherRebars = list(vp.Collectors.Rebars.Excluding(List[ElementId]([rebar.Id for rebar in mainWallRebars])).ToElements())\r\n\t\tcontainers = list(vp.Collectors.Containers.ToElements())\r\n\t\t[SetRebarSecondaryGraphics(rebar, vp.View) for rebar in (otherRebars + containers)]\r\n\t\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = ''",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "513cf00d22344d7289187d14e10704df",
