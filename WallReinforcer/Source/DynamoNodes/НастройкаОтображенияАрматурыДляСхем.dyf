    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndef GetMainElementFromView(walls, vp):\r\n\tfor wall in walls:\t\r\n\t\tsolid = [geom for geom in list(wall.Geometry[optForElems]) if geom.GetType() == Solid and geom.Volume > 0][0]\r\n\t\tvoids = [doc.GetElement(id) for id in wall.GetDependentElements(voidFilter)]\r\n\t\tfor i in [-0.25, 0, 0.25]:\r\n\t\t\ttransform = Transform.CreateTranslation(vp.Dirs[0]*vp.CropBox.L*i)\r\n\t\t\tline = vp.CropBox.CentroidDepthLine.CreateTransformed(transform)\r\n\t\t\tfilter = LogicalOrFilter([BoundingBoxContainsPointFilter(line.Evaluate(j*0.1, True)) for j in range(10)])\r\n\t\t\tif list(solid.IntersectWithCurve(line, None)) or [void for void in voids if filter.PassesFilter(void)]:\r\n\t\t\t\treturn wall\r\n\telse:\r\n\t\treturn None\t\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nVPs = IN[0]\r\n\r\nfilter1 = LogicalAndFilter(ElementClassFilter(FamilyInstance), ElementCategoryFilter(BuiltInCategory.OST_Windows))\r\nfilter2 = LogicalAndFilter(ElementClassFilter(FamilyInstance), ElementCategoryFilter(BuiltInCategory.OST_Doors))\r\nvoidFilter = LogicalOrFilter(filter1, filter2)\r\n\r\noptForElems = Options()\r\n\r\nmainElements = []\r\ncontainers = []\r\nfor vp in VPs:\r\n\toptForElems.View = vp.View\r\n\twalls = vp.Collectors.Walls.ToElements()\r\n\tmainElement = GetMainElementFromView(walls, vp)\r\n\tmainElements.append(mainElement)\r\n\tcontainers += [doc.GetElement(id) for id in mainElement.GetDependentElements(ElementClassFilter(RebarContainer))] if mainElement else [None]\r\n\t\r\nOUT = mainElements, containers",
