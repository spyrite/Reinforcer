  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nimport math\r\nimport System\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\t\r\ndef VecABS(vec):\r\n\tx = abs(vec.X)\r\n\ty = abs(vec.Y)\r\n\tz = abs(vec.Z)\r\n\treturn XYZ(x,y,z)\r\n\r\nopenings = UnwrapElement(IN[0])\r\n\r\nopt = Options()\r\nopt.ComputeReferences = True\r\n\r\nclass OpeningParameters:\r\n\tdef __init__(self, open):\r\n\t\tself.Id = open.Id\r\n\t\tself.Elem = open\r\n\t\tif open.GetParameters(IN[1][0]):\r\n\t\t\tself.B = open.GetParameters(IN[1][0])[0].AsDouble()\r\n\t\telse:\r\n\t\t\tself.B = None\r\n\t\tif open.GetParameters(IN[1][1]):\r\n\t\t\tself.H = open.GetParameters(IN[1][1])[0].AsDouble()\r\n\t\telse:\r\n\t\t\tself.H = None\t\r\n\t\tself.Origin = open.Location.Point\r\n\t\tself.Z = self.Origin.Z\r\n\t\tself.XDir = open.GetTransform().BasisX\r\n\t\tself.ZDir = open.GetTransform().BasisZ\r\n\t\tself.EndPoints = [self.Origin - self.XDir*self.B/2, self.Origin + self.XDir*self.B/2]\r\n\t\tfilter = BoundingBoxContainsPointFilter(self.Origin)\r\n\t\tself.Host = FilteredElementCollector(doc, List[ElementId](IN[2])).WherePasses(filter).FirstElement()\r\n\t\tself.Level = doc.GetElement(self.Host.LevelId)\r\n\t\tself.Offsets = [open.Parameter[BuiltInParameter.INSTANCE_SILL_HEIGHT_PARAM].AsDouble(), open.GetParameters(IN[1][5])[0].AsDouble()]\r\n\t\tself.Phase = self.Host.Parameter[BuiltInParameter.PHASE_CREATED].AsElementId()\r\n\t\tif open.GetParameters(IN[1][2]):\r\n\t\t\tself.Assignment = open.GetParameters(IN[1][2])[0].AsString()\r\n\t\telse:\r\n\t\t\tself.Assignment = None\r\n\t\tself.Zone = self.Host.GetParameters(IN[1][3])[0].AsString()\r\n\t\tself.Section = self.Host.GetParameters(IN[1][4])[0].AsString()\r\n#\t\tself.HostPars = wp\r\n#\t\tself.Solid = GeometryCreationUtilities.CreateExtrusionGeometry([CurveLoop.Create(self.GetSketch())], wp.Geom.YDir, wp.Geom.T)\r\n\t\t\r\n#\tdef GetSketch(self):\r\n#\t\tp0 = self.EndPoints[0] - self.HostPars.Geom.YDir*self.HostPars.Geom.T/2\r\n#\t\tp1 = p0 + XYZ.BasisZ*self.H\r\n#\t\tp2 = self.EndPoints[1] - self.HostPars.Geom.YDir*self.HostPars.Geom.T/2 + XYZ.BasisZ*self.H\r\n#\t\tp3 = p2 - XYZ.BasisZ*self.H\r\n#\t\tlines = []\r\n#\t\tlines.append(Line.CreateBound(p0, p1))\r\n#\t\tlines.append(Line.CreateBound(p1, p2))\r\n#\t\tlines.append(Line.CreateBound(p2, p3))\r\n#\t\tlines.append(Line.CreateBound(p3, p0))\r\n#\t\treturn lines\r\n\t\t\r\n#\tdef GetAttachedFaces(self):\r\n#\t\topenFaces = [face for face in self.Solid.Faces if not VecABS(face.FaceNormal.Normalize()).IsAlmostEqualTo(VecABS(self.HostPars.Geom.YDir))]\r\n#\t\tattFaces = []\r\n#\t\tfor openFace in openFaces:\r\n#\t\t\tpoint = openFace.Evaluate(UV(10/304.8, 10/304.8))\r\n#\t\t\tcutLine = Line.CreateBound(point, point + openFace.FaceNormal.Normalize()*10/304.8)\r\n#\t\t\tspotLines = list(self.HostPars.Geom.Solid.IntersectWithCurve(cutLine, None))\r\n#\t\t\tif not spotLines:\r\n#\t\t\t\tattFaces.append(openFace)\r\n#\t\treturn attFaces\r\n\t\t\t\t\t\r\n\r\nOPars = [OpeningParameters(open) for open in openings]\r\n\r\nOUT = OPars",
      "Engine": "IronPython2",
