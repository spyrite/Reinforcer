    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nimport System\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nbeamFilter = LogicalAndFilter(ElementClassFilter(FamilyInstance), ElementCategoryFilter(BuiltInCategory.OST_StructuralFraming))\r\n\r\ndef GetLevelId(elem):\r\n\t\r\n\tif beamFilter.PassesFilter(elem):\r\n\t\tlvlId = elem.Parameter[BuiltInParameter.INSTANCE_REFERENCE_LEVEL_PARAM].AsElementId()\r\n\telse:\r\n\t\tlvlId = elem.LevelId\r\n\treturn lvlId\r\n\t\r\n#def GetOrientation(elem):\r\n#\tif elem.GetType() == Wall:\r\n#\t\treturn elem.Orientation\r\n#\telif elem.GetType() == Floor:\r\n#\t\treturn XYZ.BasisZ\r\n#\telse:\r\n#\treturn elem.FacingOrientation.Normalize()\r\n\t\t\r\ndef GetInsertPoint(elem, z):\r\n\tif elem.GetType() == Wall or beamFilter.PassesFilter(elem):\r\n\t\treturn elem.Location.Curve.Evaluate(0.5, True) + XYZ.BasisZ*(z+500/304.8)\r\n\t#elif elem.GetType() == Floor:\r\n\t#\tsolids = [geom for geom in list(elem.Geometry[opt]) if geom.GetType() == Solid and geom.Volume > 0]\r\n\t#\treturn solids[0].ComputeCentroid()\r\n\telse:\r\n\t\treturn elem.Location.Point + XYZ.BasisZ*(z+500/304.8)\t\r\n\r\nelemIds = UnwrapElement(IN[0])\r\ncreatedElemIds = []\r\nopt = Options()\r\n\r\ntempSymbols = [sym for sym in FilteredElementCollector(doc).OfClass(FamilySymbol) if sym.FamilyName == IN[1]]\r\nif tempSymbols:\r\n\ttempSymbol = tempSymbols[0]\r\nelse:\r\n\ttempSymbol = None\r\n\r\norient = XYZ()\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nif tempSymbol:\r\n\tfor id in elemIds:\r\n\t\telem = doc.GetElement(id)\r\n\t\tif elem.GetType() == FamilyInstance and not elem.HasModifiedGeometry():\r\n\t\t\tlvl = doc.GetElement(GetLevelId(elem))\r\n\t\t\tz = lvl.Elevation\r\n\t\t\torient = elem.FacingOrientation.Normalize()\r\n\t\t\tinsertPoint = GetInsertPoint(elem, z)\r\n\t\t\t\r\n\t\t\ttempElem = doc.Create.NewFamilyInstance(insertPoint, tempSymbol, StructuralType.NonStructural)\r\n\t\t\ttry:\t\t\r\n\t\t\t\tInstanceVoidCutUtils.AddInstanceVoidCut(doc, elem, tempElem)\r\n\t\t\t\tcreatedElemIds.append(tempElem.Id)\t\r\n\t\t\texcept Exception:\r\n\t\t\t\tcontinue\r\n\t\t\t\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nelems = [doc.GetElement(id) for id in elemIds]\r\n\r\nOUT = createdElemIds, elemIds, elems",
      "Engine": "IronPython2",
