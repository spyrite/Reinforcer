    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Function, DynamoCore",
      "FunctionSignature": "1e560bd5-4eb0-468b-9cc9-6403691af6b5",
      "FunctionType": "Graph",
