        }
      ],
      "Outputs": [
        {
          "Id": "e4eb3c76e28c457384e29bd0fedac961",
          "Name": "VPs",
          "Description": "Список параметров видов",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Сбор исходных данных, свзяанных с видами"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef GetViewGridLine(vp, gp):\r\n\tsolid = vp.CropBox.CreateViewSolid(vp.CropBox.H)\r\n\tspotlines = list(solid.IntersectWithCurve(gp.Lines[1], None))\r\n\tif spotlines:\r\n\t\tline = spotlines[0]\r\n\t\tdir = line.Direction\r\n\t\tp0 = line.GetEndPoint(0) - IN[2]/304.8*dir\r\n\t\tp1 = line.GetEndPoint(1) + IN[2]/304.8*dir\r\n\t\tline = Line.CreateBound(p0, p1)\r\n\t\treturn line\r\n\telse:\r\n\t\treturn None\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nVPs = IN[0]\r\nGPSets = IN[1]\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor i, vp in enumerate(VPs):\r\n\tGPs = GPSets[i]\r\n\tfor gp in GPs:\r\n\t\tgp.UpdateViewGeometrics(vp.View)\r\n\t\tline = GetViewGridLine(vp, gp)\r\n\t\tif line:\r\n\t\t\tgp.Grid.SetCurveInView(DatumExtentType.ViewSpecific, vp.View, line)\r\n\t\tif vp.ShouldHideGridBubbles():\r\n\t\t\tgp.Grid.HideBubbleInView(DatumEnds.End0, vp.View)\r\n\t\t\tgp.Grid.HideBubbleInView(DatumEnds.End1, vp.View)\r\n\t\t\r\nTransactionManager.Instance.TransactionTaskDone()\t\t\r\n\t\t\t\t\r\nOUT = ''",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "955b19219fc746ce8de3103676663bab",
