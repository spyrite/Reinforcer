    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nrebarFilter = ElementClassFilter(Rebar)\r\naiFilter = ElementClassFilter(AssemblyInstance)\r\n\r\nelems = list(UnwrapElement(IN[0]))\r\n\r\nrebars = []\r\nfor elem in elems:\r\n\tif rebarFilter.PassesFilter(elem):\r\n\t\trebars.append(elem)\r\n\telif aiFilter.PassesFilter(elem):\r\n\t\tai = elem\r\n\t\tsubElems = [doc.GetElement(id) for id in ai.GetMemberIds()]\r\n\t\tsubRebars = [subElem for subElem in subElems if rebarFilter.PassesFilter(subElem)]\r\n\t\trebars += subRebars\r\n\telse:\r\n\t\thost = elem\r\n\t\tsubRebars = [doc.GetElement(id) for id in host.GetDependentElements(rebarFilter)]\r\n\t\trebars += subRebars\r\n\r\nOUT = rebars",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "9ec6bdf406764e649ba2ad818a2510ef",
