    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef AppendDividedItems(rp, container):\r\n\tlineSet = rp.GetLineSet()\r\n\tfor data in lineSet:\r\n\t\tlines = data[0]\r\n\t\tn = data[1]\r\n\t\titem = container.AppendItemFromCurvesAndShape(rp.Shape, rp.BarType, rp.Hooks[0][0], rp.Hooks[0][1], rp.Normal, lines, rp.Hooks[1][0], rp.Hooks[1][1])\r\n\t\trp.SetLayoutRuleForRCI(item, n)\r\n\t\t\t\t\r\ndef IsRCShouldBeInMeters(RPs):\r\n\tfor rp in RPs:\r\n\t\tif rp.InMeters:\r\n\t\t\treturn True\r\n\treturn False\r\n\t\r\ndef GetRCTypeName(RPs):\r\n\tif IN[1][0][1] != '':\r\n\t\treturn IN[1][0][1]\r\n\telse:\r\n\t\tparent = doc.GetElement(RPs[0].ParentId)\r\n\t\tif parent.GetType() == AssemblyInstance:\r\n\t\t\tcondition1 = doc.GetElement(parent.GetTypeId()).GetParameters(IN[1][7])\r\n\t\t\tcondition2 = doc.GetElement(parent.GetTypeId()).GetParameters(IN[1][7])[0].HasValue\r\n\t\t\tcondition3 = doc.GetElement(parent.GetTypeId()).GetParameters(IN[1][7])[0].AsString() != ''\r\n\t\t\tif condition1 and condition2 and condition3:\r\n\t\t\t\treturn doc.GetElement(parent.GetTypeId()).GetParameters(IN[1][7])[0].AsString()\r\n\t\t\telse:\r\n\t\t\t\treturn 'Каркас'\r\n\t\telse:\r\n\t\t\treturn containerNames[parent.Category.Name] if parent.Category.Name in containerNames.keys() else 'Контейнер'\r\n\t\r\ndef GetRCType(RPs):\r\n\tisRCInMeters = IsRCShouldBeInMeters(rpSet)\r\n\tcontainerTypeName = GetRCTypeName(RPs) + ('_ПМ' if isRCInMeters else '')\r\n\tcontainerTypeId = RebarContainerType.GetOrCreateRebarContainerType(doc, containerTypeName)\r\n\tcontainerType = doc.GetElement(containerTypeId)\r\n\tcontainerType.GetParameters(IN[1][5])[0].Set(1 if isRCInMeters else 0)\r\n\treturn containerType\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ncontainerNames = {'Несущие колонны': 'Армирование колонн', 'Стены': 'Армирование стен', 'Каркас несущий': 'Армирование балок', 'Перекрытия': 'Армирование плит'}\r\n\r\nRPs = IN[0]\r\nparentIdIntegerValues = set([rp.ParentId for rp in RPs])\r\n\r\nrpSets = []\r\nfor idInt in parentIdIntegerValues:\r\n\trpSets.append([rp for rp in RPs if rp.ParentId == idInt])\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nrebarContainers = []\r\nfor rpSet in rpSets:\r\n\tcontainerType = GetRCType(rpSet)\r\n\tcontainer = RebarContainer.Create(doc, rpSet[0].Host, containerType.Id)\r\n\trebarContainers.append(container)\r\n\t\r\nfor i, container in enumerate(rebarContainers):\r\n\tfilteredRPs = rpSets[i]\r\n\tfor rp in filteredRPs:\r\n\t\tif rp.HasMovedBar():\r\n\t\t\tAppendDividedItems(rp, container)\r\n\t\telse:\r\n\t\t\tcontainer.AppendItemFromRebar(rp.Rebar)\r\n\r\n\tcontainer.Parameter[BuiltInParameter.PHASE_CREATED].Set(filteredRPs[0].PhaseId)\r\n\tif filteredRPs[0].ATMark:\r\n\t\tcontainer.Parameter[BuiltInParameter.ALL_MODEL_MARK].Set(filteredRPs[0].ATMark)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = rebarContainers",
