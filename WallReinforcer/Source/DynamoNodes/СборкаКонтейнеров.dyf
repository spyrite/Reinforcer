    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ndef GetRebarLength(item):\r\n\tlines = item.GetCenterlineCurves(True, True, True)\r\n\tL = sum([line.Length for line in lines])\r\n\treturn L\r\n\r\ndef CalculateMass(container):\r\n\tvolume = 0\r\n\titems = [container.GetItem(i) for i in range(container.ItemsCount)]\r\n\trst = doc.GetElement(container.GetTypeId())\r\n\tinMeters = rst.GetParameters(IN[1][5])[0].AsInteger()\r\n\tif inMeters == 1:\t\r\n\t\tfor item in items:\r\n\t\t\tbarType = doc.GetElement(item.BarTypeId)\r\n\t\t\tinMeters = barType.GetParameters(IN[1][5])[0].AsInteger()\r\n\t\t\tL = GetRebarLength(item)\r\n\t\t\tif inMeters == 1:\r\n\t\t\t\tvolume += item.Volume/L * (1000/304.8)\r\n\t\t\telif item.LayoutRule != RebarLayoutRule.Single:\r\n\t\t\t\tn = item.Quantity\r\n\t\t\t\tstep = item.MaxSpacing\r\n\t\t\t\tvolume += item.Volume/n * round((1000/304.8)/step)\r\n\t\t\telse:\r\n\t\t\t\tvolume += item.Volume\r\n\telse:\r\n\t\tfor item in items:\r\n\t\t\tvolume += item.Volume\r\n\tmass = 7850*(volume*304.8**3)/10**9\r\n\treturn mass\r\n\t\r\ndef GetAmount(container):\r\n\tamount = 1/float(container.ItemsCount)\r\n\trst = doc.GetElement(container.GetTypeId())\r\n\tinMeters = rst.GetParameters(IN[1][5])[0].AsInteger()\r\n\tif inMeters == 1:\r\n\t\titems = [container.GetItem(i) for i in range(container.ItemsCount)]\r\n\t\tfor item in items:\r\n\t\t\tbarType = doc.GetElement(item.BarTypeId)\r\n\t\t\tinMeters = barType.GetParameters(IN[1][5])[0].AsInteger()\r\n\t\t\tif inMeters == 1:\t\t\r\n\t\t\t\tamount = round(GetRebarLength(item)*304.8)/1000/float(container.ItemsCount)\r\n\t\t\t\tbreak\r\n\treturn amount\r\n\r\nrebarContainers = UnwrapElement(IN[0])\r\n\r\nif IN[2]:\r\n\tTransactionManager.Instance.EnsureInTransaction(doc)\r\n\t\r\n\tfor container in rebarContainers:\r\n\t\thost = doc.GetElement(container.GetHostId())\r\n\t\tzone = host.GetParameters(IN[1][6])[0].AsString()\r\n\t\tcontainer.PresentItemsAsSubelements = True\r\n\t\t\r\n\t\toverrideMan = container.GetParametersManager()\r\n\t\toverrideMan.ClearOverrides()\t\r\n\t\tpartParId = container.Parameter[BuiltInParameter.NUMBER_PARTITION_PARAM].Id\r\n\t\toverrideMan.AddOverride(partParId, '03_Каркасы')\r\n\t\t\r\n\t\tif IN[1][0][1] != '':\r\n\t\t\tcontainer.GetParameters(IN[1][0][0])[0].Set(IN[1][0][1].split('_')[0])\r\n\t\telse:\r\n\t\t\tcontainer.GetParameters(IN[1][0][0])[0].Set(doc.GetElement(container.GetTypeId()).Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsString().split('_')[0])\r\n\t\tcontainer.GetParameters(IN[1][2])[0].Set(GetAmount(container))\r\n\t\tcontainer.GetParameters(IN[1][3])[0].Set(CalculateMass(container))\r\n\t\tcontainer.GetParameters(IN[1][6])[0].Set(zone)\r\n\t\t \r\n\t\tif doc.GetElement(container.GetHostId()).Parameter[BuiltInParameter.ALL_MODEL_MARK].HasValue:\r\n\t\t\thostMark = doc.GetElement(container.GetHostId()).Parameter[BuiltInParameter.ALL_MODEL_MARK].AsString()\r\n\t\t\tcontainer.GetParameters(IN[1][4])[0].Set(hostMark)\r\n\t\t\t\t\r\n\tTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = rebarContainers",
