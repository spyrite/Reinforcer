{
  "Uuid": "5a3f7075-e592-4b46-973a-1d0846bc9fa0",
  "IsCustomNode": true,
  "Category": "1П.Армирование",
  "Description": "Корректирует защитные слои для железобетонных элементов по заданным значениям",
  "Name": "КорректировкаЗащитногоСлоя",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef GetRebarCoverType(dst):\r\n\tfor rct in FilteredElementCollector(doc).OfClass(RebarCoverType).ToElements():\r\n\t\tif round(rct.CoverDistance*304.8) == dst:\r\n\t\t\treturn rct\r\n\telse:\r\n\t\treturn RebarCoverType.Create(doc, str(int(round(dst))), dst/304.8)\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nelems = UnwrapElement(IN[0])\r\n\r\nparName = [BuiltInParameter.CLEAR_COVER, BuiltInParameter.CLEAR_COVER_BOTTOM, BuiltInParameter.CLEAR_COVER_TOP, BuiltInParameter.CLEAR_COVER_OTHER, BuiltInParameter.CLEAR_COVER_INTERIOR, BuiltInParameter.CLEAR_COVER_EXTERIOR]\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor elem in elems:\r\n\tfor i in range(6):\r\n\t\tcovType = GetRebarCoverType(IN[1][i])\r\n\t\tif elem.Parameter[parName[i]] and not elem.Parameter[parName[i]].IsReadOnly:\r\n\t\t\telem.Parameter[parName[i]].Set(covType.Id)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = ''",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "77fddf683c4547278a47d8cd2193a724",
