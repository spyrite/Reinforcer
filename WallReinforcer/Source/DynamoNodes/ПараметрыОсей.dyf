          "KeepListStructure": false
        }
      ],
      "Outputs": [],
      "Replication": "Disabled",
      "Description": "Результат функции, применять с пользовательскими узлами"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\nclass GridParameters:\r\n\tdef __init__(self, grid):\r\n\t\tself.Grid = grid\r\n\t\tself.View = None\r\n\t\tself.Names = [grid.Name]\r\n\t\tself.Lines = [grid.Curve, None]\r\n\t\tself.Centers = [self.Lines[0].Evaluate(0.5, True), None]\r\n\t\tself.Origin = self.Lines[0].Origin\r\n\t\tself.Directions = [self.Lines[0].Direction, self.Lines[0].Direction.CrossProduct(XYZ.BasisZ), XYZ.BasisZ]\r\n\t\tself.Plane = Plane.CreateByOriginAndBasis(self.Origin, self.Directions[0], self.Directions[2])\r\n\t\tself.HasBubbles = [None, None]\r\n\t\tself.RayWhereGridHasBeenCatchedDir = None\r\n\t\t\t\r\n\tdef GetNearGridPars(self):\r\n\t\tnearGPs = [None, None]\r\n\t\tcollector = FilteredElementCollector(doc).OfClass(Grid)\r\n\t\totherGPs = [GridParameters(grid) for grid in collector.Excluding(List[ElementId]([self.Grid.Id])).ToElements() if grid.Curve.Direction.IsAlmostEqualTo(self.Grid.Curve.Direction) or grid.Curve.Direction.IsAlmostEqualTo(-self.Grid.Curve.Direction)]\r\n\t\t\r\n\t\tplanes = [gp.Plane for gp in otherGPs]\r\n\t\tpoints = [(plane.Origin + plane.XVec*plane.Project(self.Centers[0])[0].U + plane.YVec*plane.Project(self.Centers[0])[0].V) for plane in planes]\r\n\t\tdirs = [self.Directions[1]*token for token in [-1, 1]]\r\n\t\trays = [Line.CreateBound(self.Centers[0], self.Centers[0] + 100000*dir) for dir in dirs]\r\n\t\tfor i in range(2):\r\n\t\t\tprojectPars = [round(rays[i].Project(point).Parameter, 5) for point in points]\r\n\t\t\tdsts = [dst for dst in projectPars if dst > 0]\r\n\t\t\tif dsts:\r\n\t\t\t\tnearGPs[i] = otherGPs[projectPars.index(min(dsts))]\r\n\t\t\t\tnearGPs[i].RayWhereGridHasBeenCatchedDir = rays[i].Direction.Normalize()\r\n\t\treturn nearGPs\r\n\t\r\n\tdef UpdateViewGeometrics(self, view):\r\n\t\topt.View = view\r\n\t\tself.View = view\r\n\t\tself.Lines[-1] = list(self.Grid.Geometry[opt])[0]\r\n\t\tself.Centers[-1] = self.Lines[-1].Evaluate(0.5, True)\r\n\t\tself.HasBubbles = [self.Grid.IsBubbleVisibleInView(de, view) for de in [DatumEnds.End0, DatumEnds.End1]]\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nopt = Options()\r\ngridSets = UnwrapElement(IN[0])\r\n\r\nGPSets = [[GridParameters(grid) for grid in gridSet] for gridSet in gridSets]\r\n\r\nOUT = GPSets",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
