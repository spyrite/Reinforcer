    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nimport math\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndef ByMark(vp):\r\n#\tmainElement = None\r\n#\tif vp.Name.find('К-') != -1:\r\n#\t\tmainElement = vp.GetMainElementFromView(vp.Collectors.Columns.ToElements())\t\t\t\r\n#\telif vp.Name.find('Стм-') != -1 or vp.Name.find('Дм-') != -1:\r\n#\t\tmainElement = vp.GetMainElementFromView(vp.Collectors.Walls.ToElements())\r\n\tmainElement = vp.GetMainElementFromView(vp.Collectors.Union.ToElements())\r\n\tif mainElement and mainElement.Parameter[BuiltInParameter.ALL_MODEL_MARK].HasValue:\t\r\n\t\tvp.ElemMark = mainElement.Parameter[BuiltInParameter.ALL_MODEL_MARK].AsString()\t\r\n\treturn vp.ElemMark\r\n\t\t\r\nclass SheetParameters:\r\n\tdef __init__(self, sheet):\r\n\t\tself.Sheet = sheet\r\n\t\tself.Name = sheet.Name\r\n\t\tself.Width = sheet.Outline.Max.U - sheet.Outline.Min.U\r\n\t\tself.Viewports = [doc.GetElement(id) for id in sheet.GetAllViewports()]\r\n\t\tself.ViewPars = sorted([vp for vp in allVPars if vp.ViewportSheetName == self.Name], key=ByMark)\r\n\t\tself.ViewConcretePars = [vp for vp in self.ViewPars if (vp.Name.find('Опалубочные чертежи') != -1 or vp.Name.find('Опалубочный чертеж') != -1) and vp.Name.find('ечение') == -1 and vp.Name.find('горизонтальное') == -1 and vp.Name.find('Вид') == -1 and vp.Name.find('расположения') == -1 and vp.Name.find('Обрамление') == -1 and vp.Name.find('рагмент') == -1 and vp.Name.find('азрез') == -1]\r\n\t\tself.AI = None\r\n\t\tself.ElemMarksString = ', '.join([vp.ElemMark for vp in self.ViewConcretePars])\r\n\t\tself.SimpleRebarPars = []\r\n\t\tself.SheetSetName = sheet.Parameter[BuiltInParameter.SHEET_NUMBER].AsString().split('-')[0]\r\n\t\tself.Schedules = []\r\n\t\t\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nsheets = UnwrapElement(IN[0])\r\nallVPars = IN[1]\r\n\r\nSPars = [SheetParameters(sheet) for sheet in sheets]\r\n\r\nOUT = SPars",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "9cf466aeba69464a9b54de9601fcf739",
