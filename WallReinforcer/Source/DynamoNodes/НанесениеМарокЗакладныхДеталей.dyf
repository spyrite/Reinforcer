    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef GetDirections(emb, view):\r\n\tembDir = emb.GetTransform().BasisZ\r\n\tif embDir.IsAlmostEqualTo(view.ViewDirection) or embDir.IsAlmostEqualTo(-view.ViewDirection):\r\n\t\tdir1 = view.UpDirection\r\n\t\tdir2 = view.RightDirection\r\n\t\tdir3 = -dir2\r\n\telse:\r\n\t\tdir1 = emb.GetTransform().BasisZ\r\n\t\tdir2 = dir1.CrossProduct(view.ViewDirection)\r\n\t\tdir3 = -dir1 if dir1.IsAlmostEqualTo(view.RightDirection) or dir1.IsAlmostEqualTo(-view.RightDirection) else -dir2\r\n\treturn [dir1, dir2, dir3]\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nviews = UnwrapElement(IN[0])\r\n\r\ntagType = [sym for sym in FilteredElementCollector(doc).OfClass(FamilySymbol).ToElements() if sym.FamilyName == IN[1][0][0] and sym.Parameter[BuiltInParameter.SYMBOL_NAME_PARAM].AsString() == IN[1][0][1]][0]\r\nfilter1 = LogicalAndFilter(ElementClassFilter(FamilyInstance), ElementCategoryFilter(BuiltInCategory.OST_Rebar))\r\nfilter2 = LogicalAndFilter(ElementClassFilter(FamilyInstance), ElementCategoryFilter(BuiltInCategory.OST_GenericModel))\r\ncomFilter = LogicalOrFilter(filter1, filter2)\r\n\t\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor view in views:\r\n\tembedments = [elem for elem in FilteredElementCollector(doc, view.Id).WherePasses(comFilter).ToElements() if elem.Symbol.FamilyName.find(IN[1][1]) == 0]\r\n\r\n\tfor emb in embedments:\r\n\t\tdirs = GetDirections(emb, view)\r\n\t\tembLocPoint = emb.Location.Point\r\n\t\t\r\n\t\tinsPoint = embLocPoint + dirs[0]*IN[2][0]/304.8 + dirs[1]*IN[2][1]/304.8\r\n\t\telbowPoint = insPoint + dirs[2]*IN[2][2]/304.8\r\n\t\t\r\n\t\tembRef = Reference(emb)\r\n\t\ttag = IndependentTag.Create(doc, tagType.Id, view.Id, embRef, False, TagOrientation.Horizontal, insPoint)\r\n\t\ttag.HasLeader = True\r\n\t\ttag.LeaderEndCondition = LeaderEndCondition.Attached\r\n\t\t#tag.SetLeaderEnd(embRef, emLocPoint)\r\n\t\ttag.SetLeaderElbow(embRef, elbowPoint)\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = ''",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
