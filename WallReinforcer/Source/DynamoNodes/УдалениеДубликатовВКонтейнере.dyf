{
  "Uuid": "6e14ae3e-2c22-4980-8301-d377ba536346",
  "IsCustomNode": true,
  "Category": "1П.Отладка",
  "Description": "Удаляет дублирующиеся стержни внутри арматурного контейнера",
  "Name": "УдалениеДубликатовВКонтейнере",
  "ElementResolver": {
