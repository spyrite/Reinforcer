  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef LinesAreEqual(line1, line2):\r\n\tfor i in range(2):\r\n\t\tif not line1.GetEndPoint(i).IsAlmostEqualTo(line2.GetEndPoint(i)):\r\n\t\t\treturn False\r\n\telse:\r\n\t\treturn True\r\n\t\t\r\ndef RPsAreEqual(rp1, rp2):\r\n\tif rp1.Lines.Count == rp2.Lines.Count:\r\n\t\tfor i in range(rp1.Lines.Count):\r\n\t\t\tif not LinesAreEqual(rp1.Lines[i], rp2.Lines[i]):\r\n\t\t\t\treturn False\r\n\t\telse:\r\n\t\t\treturn True\r\n\telse:\r\n\t\treturn False\r\n\t\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nRCPs = IN[0]\t\r\n\r\nduplicateRPs = []\r\nfor rcp in RCPs:\r\n\tduplicateRPs.append([])\r\n\tids = []\r\n\tfor rp1 in rcp.RPs:\r\n\t\tfor rp2 in rcp.RPs:\r\n\t\t\tif rp1 != rp2 and RPsAreEqual(rp1, rp2) and rp2.RCI.ItemIndex not in ids:\r\n\t\t\t\tduplicateRPs[-1].append([rp1, rp2])\r\n\t\t\t\tids += [rp1.RCI.ItemIndex, rp2.RCI.ItemIndex]\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor i, rpSet in enumerate(duplicateRPs):\r\n\trcp = RCPs[i]\r\n\tfor pairRP in rpSet:\t\r\n\t\trcp.RPs.remove(pairRP[-1])\r\n\t\trcp.Elem.RemoveItem(pairRP[-1].RCI)\r\n\t\t\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = RCPs",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
