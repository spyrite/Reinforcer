{
  "Uuid": "d001fbed-531b-4219-89e3-8d633ac9f2aa",
  "IsCustomNode": true,
  "Category": "1П.Виды",
  "Description": "Создает вертикальный разрез под углом A к \"глобальной оси X\" (XYZ.BasisX), где 0<A<=180. Применяется для создания опалубочных чертежей и схем армирования стен и колонн.",
  "Name": "СозданиеВертикальногоРазреза",
  "ElementResolver": {
    "ResolutionMap": {}
  },
