    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\t\r\ndef GetMaterialNames(elem):\r\n\tif elem.GetType() == Floor or elem.GetType() == Wall:\r\n\t\tcs = doc.GetElement(elem.GetTypeId()).GetCompoundStructure()\r\n\t\tlayers = cs.GetLayers() if cs else []\r\n\t\tmaterials = [doc.GetElement(layer.MaterialId) for layer in layers]\r\n\telse:\r\n\t\tmaterials = [doc.GetElement(elem.Symbol.Parameter[BuiltInParameter.STRUCTURAL_MATERIAL_PARAM].AsElementId())] if elem.Symbol.Parameter[BuiltInParameter.STRUCTURAL_MATERIAL_PARAM] else []\r\n\t\tif not materials and elem.Symbol.GetParameters(IN[1]):\r\n\t\t\tmaterials = [doc.GetElement(elem.Symbol.GetParameters(IN[1])[0].AsElementId())]\r\n\t\telif not materials and elem.Parameter[BuiltInParameter.STRUCTURAL_MATERIAL_PARAM]:\r\n\t\t\tmaterials = [doc.GetElement(elem.Parameter[BuiltInParameter.STRUCTURAL_MATERIAL_PARAM].AsElementId())]\r\n\t\telif not materials and elem.GetParameters(IN[1]):\r\n\t\t\tmaterials = [doc.GetElement(elem.GetParameters(IN[1])[0].AsElementId())]\r\n\treturn [material.Name for material in materials if material]\r\n\t\t\r\nfilters = []\r\nfilters.append(LogicalAndFilter(ElementClassFilter(Floor), ElementCategoryFilter(BuiltInCategory.OST_Floors)))\r\nfilters.append(LogicalAndFilter(ElementClassFilter(FamilyInstance), ElementCategoryFilter(BuiltInCategory.OST_StructuralColumns)))\r\nfilters.append(ElementClassFilter(Wall))\r\nfilters.append(LogicalAndFilter(ElementClassFilter(FamilyInstance), ElementCategoryFilter(BuiltInCategory.OST_StructuralFraming)))\r\nfilters.append(LogicalAndFilter(ElementClassFilter(FamilyInstance), ElementCategoryFilter(BuiltInCategory.OST_Stairs)))\r\nfilters.append(LogicalAndFilter(ElementCategoryFilter(BuiltInCategory.OST_StructuralFoundation), LogicalOrFilter(ElementClassFilter(Floor), ElementClassFilter(FamilyInstance))))\r\nfilters.append(LogicalAndFilter(ElementClassFilter(FamilyInstance), ElementCategoryFilter(BuiltInCategory.OST_GenericModel)))\r\ncomFilter = LogicalOrFilter(filters)\r\n\r\nallElems = FilteredElementCollector(doc).WherePasses(comFilter).WhereElementIsNotElementType().ToElements()\r\n\r\nconcreteIds = []\r\nfor elem in allElems:\r\n\tmaterialNames = GetMaterialNames(elem)\r\n\tfor name in materialNames:\r\n\t\tif name.find(IN[0]) == 0:\r\n\t\t\tconcreteIds.append(elem.Id)\r\n\t\t\tbreak\r\n\r\ngroupedElemIds = [FilteredElementCollector(doc, List[ElementId](concreteIds)).WherePasses(filter).ToElementIds() for filter in filters] + [concreteIds]\r\n\r\nOUT = groupedElemIds",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "62ff02b2322b4d459d0fe56fdbcc8ada",
