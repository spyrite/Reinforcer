      "Replication": "Auto",
      "Description": "Получение свойства SheetNumber для листа\n\nSheet.SheetNumber: string"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nsheetNumbers = UnwrapElement(IN[0])\r\n\r\nTrimmedNumbers = []\r\nfor i in sheetNumbers:\r\n\tif len(i.split('-')) > 1:\r\n\t\ttn = float(i.split('-')[1].split('_')[0])\r\n\telse:\r\n\t\ttn = float(i.split('_')[0])\r\n\t\t\r\n\tTrimmedNumbers.append(tn)\r\n\t\r\nOUT = TrimmedNumbers",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "a69709cacf7749399d3a9282f238265c",
      "Inputs": [
