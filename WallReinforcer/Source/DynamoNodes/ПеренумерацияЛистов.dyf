      ],
      "Replication": "Auto",
      "Description": "Сортировка списка на основе ключей\n\nList.SortByKey (list: var[]..[], keys: var[]..[]): var[]..[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nsheets = UnwrapElement(IN[0])\r\nstartNumber = int(IN[1])\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nnewNumbers = []\r\n\r\nfor i, sheet in enumerate(sheets):\r\n\tif len(sheet.SheetNumber.split('-')) > 1:\r\n\t\tPrefix = sheet.SheetNumber.split('-')[0]\r\n\t\tnewNumbers.append(Prefix + '-' + str(i + startNumber)) \r\n\telse:\r\n\t\tnewNumbers.append(str(i + startNumber))\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor i, sheet in enumerate(sheets):\r\n\tsheet.SheetNumber = newNumbers[i] + '_temp'\r\n\r\nfor i, sheet in enumerate(sheets):\r\n\tsheet.SheetNumber = newNumbers[i]\r\n\tif sheet.GetParameters(IN[2]):\r\n\t\tsheet.GetParameters(IN[2])[0].Set(newNumbers[i].split('-')[-1])\r\n\t\t\t\t\r\ndoc.Regenerate()\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = newNumbers",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "69eb40f84e444791ab50b0c73ef0d33b",
