    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nRCPs = IN[0]\r\nallConcreteIds = IN[1]\r\n\r\nfilteredConcreteIds = []\r\n\r\nfor rcp in RCPs:\r\n\tfilter = BoundingBoxContainsPointFilter(rcp.Center)\r\n\tfilteredConcreteIds += list(FilteredElementCollector(doc, List[ElementId](allConcreteIds)).WherePasses(filter).ToElementIds())\r\n\r\nOUT = filteredConcreteIds",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "112d4f3d1ed34942a0858b1cfa7af618",
      "Inputs": [
        {
          "Id": "5fa2ec88793f43ce8d28c110ef95b867",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "207b3ca5c39b466785afb96babe9fa3d",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "1b653b08b44b4f1c94da70a5ab437647",
          "Name": "OUT",
          "Description": "Результат сценария Python",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Выполнение встроенного сценария Python."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndef GetSolid(elem):\r\n\tif elem.GetType() == FamilyInstance and elem.Symbol.Family.IsInPlace:\r\n\t\tgeomInst = [geom for geom in list(elem.Geometry[opt]) if geom.GetType() == GeometryInstance][0]\r\n\t\tsolid = [geom for geom in geomInst.GetInstanceGeometry() if geom.GetType() == Solid and geom.Volume > 0][0]\r\n\telse:\r\n\t\tsolid = [geom for geom in list(elem.Geometry[opt]) if geom.GetType() == Solid and geom.Volume > 0][0]\r\n\treturn solid\r\n\t\r\ndef SetContainerParameters(rcp):\r\n\tphase = rcp.Host.Parameter[BuiltInParameter.PHASE_CREATED].AsElementId()\r\n\trcp.Elem.Parameter[BuiltInParameter.PHASE_CREATED].Set(phase)\r\n\tif rcp.Host.Parameter[BuiltInParameter.ALL_MODEL_MARK].HasValue:\r\n\t\thostMark = rcp.Host.Parameter[BuiltInParameter.ALL_MODEL_MARK].AsString()\r\n\t\tif hostMark:\r\n\t\t\trcp.Elem.GetParameters(IN[2][0])[0].Set(hostMark)\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nRCPs = IN[0]\r\nallConcreteIds = IN[1]\r\nopt = Options()\r\n\r\nmonitoring = []\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor rcp in RCPs:\r\n\toldHost = rcp.Host\r\n\tfilter = BoundingBoxContainsPointFilter(rcp.Center)\r\n\tconcretes = FilteredElementCollector(doc, List[ElementId](allConcreteIds)).WherePasses(filter).ToElements()\r\n\tlines = []\r\n\tfor rci in rcp.RPs:\r\n\t\tlines += rci.Lines\r\n\tnewHost = None\r\n\tfor\telem in concretes:\r\n\t\tsolid = GetSolid(elem)\r\n\t\tfor line in lines:\r\n\t\t\tcutLines = solid.IntersectWithCurve(line, None)\r\n\t\t\tif cutLines:\r\n\t\t\t\tnewHost = elem\r\n\t\t\t\trcp.Elem.SetHostId(doc, newHost.Id)\r\n\t\t\t\trcp.Host = newHost\r\n\t\t\t\tbreak\r\n\t\tif newHost:\r\n\t\t\tbreak\r\n\telse:\r\n\t\tnewHost = oldHost\r\n\t\t\r\n\tSetContainerParameters(rcp)\r\n\r\n\tmonitoring.append(['Старый хост: ' + str(oldHost.Id.IntegerValue), 'Новый хост: ' + str(newHost.Id.IntegerValue)])\r\n\t\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\nOUT = monitoring, RCPs",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "c570c1ed61414982b3b2cafa4338ca1a",
