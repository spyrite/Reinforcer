      "Description": "Создание нового списка из заданных входных значений"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nprojInfo = FilteredElementCollector(doc).OfClass(ProjectInfo).FirstElement()\r\nprojNumber = projInfo.Parameter[BuiltInParameter.PROJECT_NUMBER].AsString()\r\n\r\ndef GetHostMark(rebar):\r\n\thost = doc.GetElement(rebar.GetHostId())\r\n\tif host.GetParameters(IN[1][5]) and host.GetParameters(IN[1][5])[0].HasValue and host.GetParameters(IN[1][5])[0].AsString() != '':\r\n\t\thostMark = host.GetParameters(IN[1][5])[0].AsString()\r\n\telse:\r\n\t\thostMark = rebar.Parameter[BuiltInParameter.REBAR_ELEM_HOST_MARK].AsString()\r\n\treturn hostMark\r\n\t\r\ndef GetHostZone(rebar):\r\n\thost = doc.GetElement(rebar.GetHostId())\r\n\tif host.GetParameters(IN[1][7]) and host.GetParameters(IN[1][7])[0].HasValue and host.GetParameters(IN[1][7])[0].AsString() != '':\r\n\t\thostZone = host.GetParameters(IN[1][7])[0].AsString()\r\n\telse:\r\n\t\thostZone = ''\r\n\treturn hostZone\r\n\r\ndef GetATMark():\r\n\tatName = None\r\n\tatMark = None\r\n\tif IN[1][1][1].find('Каркас') == 0 or IN[1][1][1].find('Сетка') == 0:\r\n\t\tatMark = at.Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsString().split('_')[-1]\r\n\telif IN[1][1][1] == 'Фрагмент':\r\n\t\tatName = members[0].Parameter[BuiltInParameter.NUMBER_PARTITION_PARAM].AsString()\r\n\t\tatMark = atName.split(' ')[-1]\r\n\treturn [atName, atMark]\r\n\r\nATs = UnwrapElement(IN[0])\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor at in ATs:\r\n\tAIs = [doc.GetElement(id) for id in at.GetDependentElements(ElementClassFilter(AssemblyInstance))]\r\n\tmembers = [doc.GetElement(id) for id in AIs[0].GetMemberIds()]\r\n\tdata = GetATMark()\r\n\tatName = data[0]\r\n\tatMark = data[1]\r\n\t\t\r\n\tmass = 0\r\n\tfor elem in members:\r\n\t\tif elem.GetType() == Rebar or elem.GetType() == RebarInSystem:\r\n\t\t\tmass += 7850*(elem.Volume*304.8**3)/10**9\r\n\t\telif elem.GetParameters(IN[1][2]):\r\n\t\t\tmass += elem.GetParameters(IN[1][2])[0].AsDouble()\t\r\n\r\n\tif at.GetParameters(IN[1][0]):\r\n\t\tvp = None\r\n\t\tvps1 = [doc.GetElement(id) for id in at.GetDependentElements(ElementClassFilter(Viewport)) if doc.GetElement(id).OwnerViewId.IntegerValue != -1]\r\n\t\tif vps1:\r\n\t\t\tvp = vps1[0]\r\n\t\telif atName:\r\n\t\t\tvps2 = [vp for vp in FilteredElementCollector(doc).OfClass(Viewport).ToElements() if vp.Parameter[BuiltInParameter.VIEW_NAME].AsString().split(' - ')[-1] == atName]\r\n\t\t\tif vps2:\r\n\t\t\t\tvp = vps2[0]\r\n\t\tif vp:\r\n\t\t\tsheet = doc.GetElement(vp.OwnerViewId)\r\n\t\t\tif sheet and sheet.GetParameters(IN[1][3]) and sheet.GetParameters(IN[1][4]):\r\n\t\t\t\tsheetNumber = sheet.GetParameters(IN[1][3])[0].AsString()\r\n\t\t\t\tsheetSet = sheet.GetParameters(IN[1][4])[0].AsString()\r\n\t\t\t\tref = projNumber + '-' + sheetSet + '-' + sheetNumber\r\n\t\t\t\tat.GetParameters(IN[1][0])[0].Set(ref)\r\n\t\t\t\t\t\t\r\n\tif at.GetParameters(IN[1][1][0]):\r\n\t\tat.GetParameters(IN[1][1][0])[0].Set(IN[1][1][1])\r\n\t\t\r\n\tat.Parameter[BuiltInParameter.WINDOW_TYPE_ID].Set(atMark)\r\n\t\t\r\n\tfor ai in AIs:\r\n\t\tif ai.GetParameters(IN[1][2]):\t\t\t\r\n\t\t\tai.GetParameters(IN[1][2])[0].Set(mass)\r\n\t\tif ai.GetParameters(IN[1][5]):\r\n\t\t\tmembers = [doc.GetElement(id) for id in ai.GetMemberIds()]\t\t\t\r\n\t\t\thostMark = GetHostMark(members[0])\r\n\t\t\tai.GetParameters(IN[1][5])[0].Set(hostMark)\r\n\t\t\tif ai.GetParameters(IN[1][6]):\r\n\t\t\t\tai.GetParameters(IN[1][6])[0].Set(hostMark)\r\n\t\tif ai.GetParameters(IN[1][7]):\r\n\t\t\tmembers = [doc.GetElement(id) for id in ai.GetMemberIds()]\t\t\t\r\n\t\t\thostZone = GetHostZone(members[0])\r\n\t\t\tai.GetParameters(IN[1][7])[0].Set(hostZone)\r\n\t\t\t\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\t\t\t\t\r\nOUT = ATs",
      "Engine": "IronPython2",
