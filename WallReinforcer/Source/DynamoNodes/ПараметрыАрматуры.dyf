  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nimport math\r\nclr.AddReference('System')\r\nfrom System.Collections.Generic import List\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndef CreateSolidFromBBox(box, origin):\r\n\tminPoint = box.Transform.OfPoint(box.Min)\r\n\tmaxPoint = box.Transform.OfPoint(box.Max)\t\r\n\tdiagonal = maxPoint - minPoint\r\n\tdiagonalL = minPoint.DistanceTo(maxPoint)\t\r\n\ttransform = box.Transform\r\n\tdirs = [transform.BasisX, transform.BasisY, transform.BasisZ]\t\r\n\tdims = [diagonalL*math.cos(diagonal.AngleTo(dirs[i])) for i in range(3)]\t\r\n\tp0 = origin\r\n\tp1 = p0 + dirs[0]*dims[0]\r\n\tp2 = p1 + dirs[1]*dims[1]\r\n\tp3 = p2 - dirs[0]*dims[0]\r\n\tpoints = [p0, p1, p2, p3]\t\r\n\tlines = [Line.CreateBound(points[i-1], points[i]) for i in range(4)]\r\n\tcl = CurveLoop.Create(lines)\r\n\tsolid = GeometryCreationUtilities.CreateExtrusionGeometry([cl], dirs[2], dims[2]) \t\r\n\treturn solid\r\n\t\r\ndef CopyRebarLayoutRule(sourceRebar, targetRebar):\r\n\trule = sourceRebar.LayoutRule\r\n\tif rule == RebarLayoutRule.Single:\r\n\t\ttargetRebar.GetShapeDrivenAccessor().SetLayoutAsSingle()\r\n\telif rule == RebarLayoutRule.FixedNumber:\r\n\t\tn = sourceRebar.Quantity\r\n\t\tstep = sourceRebar.MaxSpacing\r\n\t\ttargetRebar.GetShapeDrivenAccessor().SetLayoutAsFixedNumber(n, step, False, True, True)\r\n\telif rule == RebarLayoutRule.MaximumSpacing or rule == RebarLayoutRule.NumberWithSpacing:\r\n\t\tstep = sourceRebar.MaxSpacing\r\n\t\tn = sourceRebar.Quantity\r\n\t\tL = step*(n-1)\r\n\t\ttargetRebar.GetShapeDrivenAccessor().SetLayoutAsNumberWithSpacing(n, step, False, True, True)\t\r\n\t\r\nclass RebarContainerItemParameters():\r\n\tdef __init__(self, rci):\r\n\t\tself.RCI = rci\r\n\t\tself.BarType = doc.GetElement(rci.BarTypeId)\r\n\t\tself.Lines = rci.GetCenterlineCurves(False, True, True)\r\n\t\tself.Dir = rci.GetDistributionPath().Direction\r\n\t\tself.Normal = rci.Normal\r\n\t\tself.Rule = rci.LayoutRule\r\n\t\tself.Hooks = [[doc.GetElement(rci.GetHookTypeId(j)) for j in range(2)], [rci.GetHookOrientation(j) for j in range(2)]]\r\n\t\tself.Shape = doc.GetElement(rci.RebarShapeId)\r\n\t\tself.Style = self.Shape.RebarStyle\r\n\t\tself.D = self.BarType.BarModelDiameter\r\n\t\t\r\n\tdef SetLayoutRuleForRebar(self, targetRebar):\r\n\t\tif self.Rule == RebarLayoutRule.Single:\r\n\t\t\ttargetRebar.GetShapeDrivenAccessor().SetLayoutAsSingle()\r\n\t\telse:\r\n\t\t\tn = self.RCI.Quantity\r\n\t\t\tL = self.RCI.ArrayLength\r\n\t\t\tstep = self.RCI.MaxSpacing\r\n\t\t\tside = self.RCI.BarsOnNormalSide\r\n\t\t\tincludings = [self.RCI.IncludeFirstBar, self.RCI.IncludeLastBar]\t\t\t\r\n\t\t\tif self.Rule == RebarLayoutRule.FixedNumber:\r\n\t\t\t\ttargetRebar.GetShapeDrivenAccessor().SetLayoutAsFixedNumber(n, L, side, includings[0],includings[1])\r\n\t\t\telif self.Rule == RebarLayoutRule.MaximumSpacing:\r\n\t\t\t\ttargetRebar.GetShapeDrivenAccessor().SetLayoutAsMaximumSpacing(step, L, side, includings[0], includings[1])\r\n\t\t\telif self.Rule == RebarLayoutRule.NumberWithSpacing:\t\t\t\r\n\t\t\t\ttargetRebar.GetShapeDrivenAccessor().SetLayoutAsNumberWithSpacing(n, step, side, includings[0], includings[1])\r\n\t\t\t\t\r\n\tdef SetLayoutRuleForRCI(self, targetRCI):\r\n\t\tif self.Rule == RebarLayoutRule.Single:\r\n\t\t\ttargetRCI.SetLayoutAsSingle()\r\n\t\telse:\r\n\t\t\tn = self.RCI.Quantity\r\n\t\t\tL = self.RCI.ArrayLength\r\n\t\t\tstep = self.RCI.MaxSpacing\r\n\t\t\tside = self.RCI.BarsOnNormalSide\r\n\t\t\tincludings = [self.RCI.IncludeFirstBar, self.RCI.IncludeLastBar]\t\t\t\r\n\t\t\tif self.Rule == RebarLayoutRule.FixedNumber:\r\n\t\t\t\ttargetRCI.SetLayoutAsFixedNumber(n, L, side, includings[0],includings[1])\r\n\t\t\telif self.Rule == RebarLayoutRule.MaximumSpacing:\r\n\t\t\t\ttargetRCI.SetLayoutAsMaximumSpacing(step, L, side, includings[0], includings[1])\r\n\t\t\telif self.Rule == RebarLayoutRule.NumberWithSpacing:\t\t\t\r\n\t\t\t\ttargetRCI.SetLayoutAsNumberWithSpacing(n, step, side, includings[0], includings[1])\r\n\r\nclass RebarContainerParameters:\r\n\tdef __init__(self, container):\r\n\t\tself.Elem = container\r\n\t\tself.ElemType = doc.GetElement(container.GetTypeId())\r\n\t\tself.ElemTypeName = self.ElemType.Parameter[BuiltInParameter.ALL_MODEL_TYPE_NAME].AsString()\r\n\t\tself.BBox = container.BoundingBox[view]\r\n\t\tself.Transform = self.BBox.Transform\r\n\t\tself.Origin = self.Transform.OfPoint(self.BBox.Min)\r\n\t\tself.Center = Line.CreateBound(self.Transform.OfPoint(self.BBox.Min), self.Transform.OfPoint(self.BBox.Max)).Evaluate(0.5, True)\r\n\t\tself.PhaseId = container.Parameter[BuiltInParameter.PHASE_CREATED].AsElementId()\r\n\t\tself.Host = doc.GetElement(container.GetHostId())\r\n\t\tself.RPs = [RebarContainerItemParameters(container.GetItem(i)) for i in range(container.ItemsCount)]\r\n\t\tself.Mark = container.Parameter[BuiltInParameter.ALL_MODEL_MARK].AsString() if container.Parameter[BuiltInParameter.ALL_MODEL_MARK].HasValue else None\r\n\t\tself.AIName = doc.GetElement(container.AssemblyInstanceId).Name if container.AssemblyInstanceId != ElementId.InvalidElementId else None\r\n\r\n\tdef CreateHost(self, doc, cat, name, origin):\r\n\t\thostSolid = CreateSolidFromBBox(self.BBox, origin)\r\n\t\thost = DirectShape.CreateElement(doc, cat.Id)\r\n\t\thost.SetShape([hostSolid])\r\n\t\thost.SetName(name)\r\n\t\treturn host\t\t\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nview = doc.ActiveView\r\nRCPs = [RebarContainerParameters(container) for container in UnwrapElement(IN[0])]\r\n\r\nOUT = RCPs",
