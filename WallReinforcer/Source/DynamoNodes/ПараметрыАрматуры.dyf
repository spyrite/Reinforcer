{
  "Uuid": "a3419349-c73a-4272-aa11-02d74f5b05e1",
  "IsCustomNode": true,
  "Category": "1П.Кэширование",
  "Description": "Сведения и методы, связанные с арматурными стержнями и арматурными контейнерами",
  "Name": "ПараметрыАрматуры",
