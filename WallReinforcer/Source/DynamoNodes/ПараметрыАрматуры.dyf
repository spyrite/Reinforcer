    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\nopt = Options()\r\n\r\n#def GetPointArrayLength(points):\r\n#\tdsts = []\r\n#\tfor point1 in points:\r\n#\t\tfor point2 in points:\r\n#\t\t\tdsts.append(point1.DistanceTo(point2))\r\n#\treturn max(dsts)\r\n\r\nclass RebarParameters:\r\n\tdef __init__(self, rebar):\r\n\t\tself.Rebar = rebar\r\n\t\tself.Elem = rebar\r\n\t\tself.BarType = doc.GetElement(rebar.GetTypeId())\r\n\t\tself.Dir = rebar.GetShapeDrivenAccessor().GetDistributionPath().Direction\r\n\t\tself.Normal = rebar.GetShapeDrivenAccessor().Normal#*IN[2]\r\n\t\tself.Rule = rebar.LayoutRule\r\n\t\tself.Hooks = [[doc.GetElement(rebar.GetHookTypeId(i)) for i in range(2)], [rebar.GetHookOrientation(i) for i in range(2)], [rebar.GetHookRotationAngle(i) for i in range(2)]]\r\n\t\tself.Shape = doc.GetElement(rebar.GetShapeId())\r\n\t\tself.Style = self.Shape.RebarStyle\r\n\t\tself.InMeters = True if self.BarType.GetParameters(IN[1][0])[0].AsInteger() == 1 else False\r\n\t\tself.Host = doc.GetElement(rebar.GetHostId())\r\n\t\tif (self.Host.GetType() == FamilyInstance and self.Host.HasModifiedGeometry()) or self.Host.GetType() != FamilyInstance:\r\n\t\t\tself.HostSolid = SolidUtils.Clone([geom for geom in list(self.Host.Geometry[opt]) if geom.GetType() == Solid and geom.Volume > 0][0])\r\n\t\telif self.Host.GetType() == FamilyInstance and self.Host.Symbol.Family.IsInPlace:\r\n\t\t\tgeomInst = [geom for geom in list(self.Host.Geometry[opt]) if geom.GetType() == GeometryInstance][0]\r\n\t\t\tself.HostSolid = SolidUtils.Clone([geom for geom in geomInst.GetInstanceGeometry() if geom.GetType() == Solid and geom.Volume > 0][0])\t\t\t\r\n\t\telse:\r\n\t\t\tself.HostSolid = None\r\n\t\tself.PhaseId = self.Host.Parameter[BuiltInParameter.PHASE_CREATED].AsElementId()\r\n\t\tself.AIName = doc.GetElement(rebar.AssemblyInstanceId).Name if rebar.AssemblyInstanceId != ElementId.InvalidElementId else None\r\n\t\tself.ParentId = rebar.AssemblyInstanceId if rebar.AssemblyInstanceId != ElementId.InvalidElementId else self.Host.Id\r\n\t\tself.ATMark = doc.GetElement(doc.GetElement(rebar.AssemblyInstanceId).GetTypeId()).Parameter[BuiltInParameter.WINDOW_TYPE_ID].AsString() if rebar.AssemblyInstanceId != ElementId.InvalidElementId else None\r\n\r\n\tdef SetLayoutRuleForRCI(self, targetRCI, n):\r\n\t\tif self.Rule == RebarLayoutRule.Single or n == 1:\r\n\t\t\ttargetRCI.SetLayoutAsSingle()\r\n\t\telse:\r\n\t\t\tstep = self.Rebar.MaxSpacing\r\n\t\t\tL = (n-1) * step\r\n\t\t\tside = self.Rebar.GetShapeDrivenAccessor().BarsOnNormalSide\r\n\t\t\tincludings = [self.Rebar.IncludeFirstBar, self.Rebar.IncludeLastBar]\t\t\t\r\n\t\t\tif self.Rule == RebarLayoutRule.FixedNumber:\r\n\t\t\t\ttargetRCI.SetLayoutAsFixedNumber(n, L, side, includings[0],includings[1])\r\n\t\t\telif self.Rule == RebarLayoutRule.MaximumSpacing:\r\n\t\t\t\ttargetRCI.SetLayoutAsMaximumSpacing(step, L, side, includings[0], includings[1])\r\n\t\t\telif self.Rule == RebarLayoutRule.NumberWithSpacing:\t\t\t\r\n\t\t\t\ttargetRCI.SetLayoutAsNumberWithSpacing(n, step, side, includings[0], includings[1])\r\n\t\t\t\t\r\n#\tdef GetLineSet(self):\r\n#\t\trebar = self.Rebar\r\n#\t\tdata = []\r\n#\t\tzs = []\r\n#\t\tfor i in range(rebar.Quantity):\r\n#\t\t\ttransform = rebar.GetMovedBarTransform(i)\r\n#\t\t\tz = round(transform.Origin.Z*304.8)\r\n#\t\t\tif z not in zs:\r\n#\t\t\t\tzs.append(z)\r\n#\t\tzs = sorted(zs)\r\n#\t\tstartLines = rebar.GetTransformedCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)\r\n#\t\txDir = rebar.GetShapeDrivenAccessor().Normal*IN[2]\r\n#\t\tfor z in zs:\r\n#\t\t\tpoints = [rebar.GetTransformedCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, i)[0].GetEndPoint(0) for i in range(rebar.Quantity) if round(rebar.GetMovedBarTransform(i).Origin.Z*304.8) == z]\t\r\n#\t\t\ttransform = Transform.CreateTranslation(XYZ.BasisZ*z/304.8 + xDir*GetPointArrayLength(points))\r\n#\t\t\tlines = [line.CreateTransformed(transform) for line in startLines]\r\n#\t\t\tn = len(points)\r\n#\t\t\tdata.append([lines, n])\r\n#\t\treturn data\r\n\t\t\r\n\tdef GetLineSet(self):\r\n\t\trebar = self.Rebar\t\t\r\n\t\tstartOrigin = rebar.GetMovedBarTransform(0).Origin\r\n\t\tstartLines = rebar.GetTransformedCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, 0)\r\n\t\tdata = [[startLines, 1, startOrigin]]\r\n\t\tnegativeStepTransform = Transform.CreateTranslation(-self.Dir*rebar.MaxSpacing)\r\n\t\tif rebar.Quantity > 1:\r\n\t\t\tfor i in range(rebar.Quantity)[1:]:\r\n\t\t\t\tif rebar.DoesBarExistAtPosition(i):\r\n\t\t\t\t\tcurrentOrigin = rebar.GetMovedBarTransform(i).Origin\r\n\t\t\t\t\tcondition1 = currentOrigin.IsAlmostEqualTo(data[-1][2])\r\n\t\t\t\t\tcondition2 = currentOrigin.IsAlmostEqualTo(data[-1][2] + self.Dir*rebar.MaxSpacing*data[-1][1])\r\n\t\t\t\t\tcondition3 = currentOrigin.IsAlmostEqualTo(data[-1][2] - self.Dir*rebar.MaxSpacing*2*data[-1][1])\r\n\t\t\t\t\tif condition1 or condition2 or condition3:\r\n\t\t\t\t\t\tdata[-1][1] += 1\r\n\t\t\t\t\t\tif condition3:\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tdata[-1][0] = [line.CreateTransformed(negativeStepTransform) for line in data[-1][0]]\r\n\t\t\t\t\telse:\r\n\t\t\t\t\t\tstartOrigin = currentOrigin\r\n\t\t\t\t\t\tstartLines = rebar.GetTransformedCenterlineCurves(False, True, True, MultiplanarOption.IncludeOnlyPlanarCurves, i)\r\n\t\t\t\t\t\tdata.append([startLines, 1, startOrigin])\r\n\t\treturn data\r\n\t\t\r\n\tdef HasMovedBar(self):\r\n\t\trebar = self.Rebar\r\n\t\tfor i in range(rebar.Quantity):\r\n\t\t\ttransform = rebar.GetMovedBarTransform(i)\r\n\t\t\tcheck = rebar.DoesBarExistAtPosition(i)\r\n\t\t\tif not transform.Origin.IsAlmostEqualTo(XYZ()) or not check:\r\n\t\t\t\treturn True\r\n\t\treturn False\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nRPs = [RebarParameters(rebar) for rebar in UnwrapElement(IN[0])]\r\n\r\nOUT = RPs",
